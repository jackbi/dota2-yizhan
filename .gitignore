# build output
dist/
# rebuild.sh 的暂存、上一版产物与并发锁
dist-next/
dist-prev/
dist-next.lock/

# build-time fetch cache
.cache/

# generated types
.astro/

# Cloudflare：构建时生成的部署配置与本地状态；.dev.vars 里放的是开发用密钥
.wrangler/
.dev.vars

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# Python cache
__pycache__/
*.pyc

# jetbrains setting folder
.idea/

# 本地工具产物：编辑器插件设置、浏览器自动化（截图 / 快照）留下的目录。
# 这些是个人环境的东西，不进仓库，也别一直挂在 git status 里。
.vscode/
.agents/
# 对外推广文案（NGA / LinuxDo 发帖稿）。放这儿是为了写的时候能对着代码改，
# 但**不进仓库**：发帖稿是一次性对外文本，进了仓库就会和线上功能说明各自漂移，
# clone 下来的人也只会看到一堆宣传稿。
promo/
# 代码索引（codegraph）：本地生成的，换台机器重新索引即可。
.codegraph/
.playwright-mcp/
