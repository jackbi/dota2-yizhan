---
import type { NewsCardItem } from '../data/types';
import { renderNewsCard } from '../lib/cardHtml';

interface Props {
	item: NewsCardItem;
}

const { item } = Astro.props;
---

{/*
	标记只有一份，住在 `src/lib/cardHtml.ts`：列表页的「加载更多」是运行时按需取下一页的，
	那边拼不出 Astro 组件，两边共用同一个渲染函数才不会分家。这个组件只是它的壳。
*/}
<Fragment set:html={renderNewsCard(item)} />
