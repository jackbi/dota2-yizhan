---
import type { NewsItem } from '../data/types';

interface Props {
	item: NewsItem;
	featured?: boolean;
}

const { item, featured = false } = Astro.props;
const isRumor = item.category === 'rumor';
---

<article
	class:list={[
		'group flex flex-col rounded-2xl border p-5 transition',
		featured
			? 'border-dota/40 bg-gradient-to-br from-dota/10 to-surface hover:border-dota'
			: 'border-line bg-surface hover:border-dota/40 hover:bg-surface-2',
	]}
>
	<div class="flex items-center gap-2 text-xs">
		<span class:list={['rounded px-2 py-0.5 font-semibold', isRumor ? 'bg-gold/15 text-gold' : 'bg-dota/15 text-dota-light']}>
			{isRumor ? '小道消息' : '官方信息'}
		</span>
		<span class="text-faint">{item.tag}</span>
		<span class="ml-auto text-faint">{item.date}</span>
	</div>
	<h3 class:list={['mt-3 font-display leading-snug', featured ? 'text-lg' : 'text-base', 'transition group-hover:text-dota-light']}>
		{item.title}
	</h3>
	<p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted">{item.summary}</p>
	<div class="mt-4 flex items-center gap-2 border-t border-line pt-3 text-xs text-faint">
		<span>{item.source}</span>
		<span aria-hidden="true">·</span>
		<span>{item.readTime}</span>
	</div>
</article>
