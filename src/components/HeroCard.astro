---
import type { Hero } from '../data/types';
import { ATTRIBUTES } from '../data/heroes';
import { ROLE_LABEL } from '../data/heroes';

interface Props {
	hero: Hero;
}

const { hero } = Astro.props;
const attr = ATTRIBUTES.find((a) => a.id === hero.attribute) ?? ATTRIBUTES[0];
const initial = hero.cn.slice(0, 1);
---

<article class="group relative flex flex-col overflow-hidden rounded-2xl border border-line bg-surface transition hover:border-dota/60 hover:bg-surface-2 hover:shadow-lg hover:shadow-dota/10">
	<div class="flex h-16 items-center justify-center bg-gradient-to-br from-surface-2 to-surface-3" style={`--tw-gradient-to:${attr.color}22`}>
		<span class="font-display text-2xl text-cream/80">{initial}</span>
	</div>
	<span class="absolute left-3 top-3 flex h-8 w-8 items-center justify-center rounded-full border border-line bg-ink/70 text-xs font-semibold" style={`color:${attr.color}`}>
		{hero.attribute}
	</span>
	<div class="flex flex-1 flex-col p-4">
		<h3 class="font-display text-base leading-tight">{hero.cn}</h3>
		<p class="mt-0.5 truncate text-xs text-muted">{hero.name}</p>
		<div class="mt-3 flex flex-wrap gap-1.5">
			{hero.roles.slice(0, 3).map((r) => (
				<span class="rounded bg-surface-3 px-2 py-0.5 text-xs text-cream/70">{ROLE_LABEL[r] ?? r}</span>
			))}
		</div>
		<div class="mt-3 flex items-center justify-between border-t border-line pt-3 text-xs">
			<span class="text-faint">{hero.attack === 'melee' ? '近战' : '远程'}</span>
			<span class="flex items-center gap-1 text-faint">
				{'●'.repeat(hero.complexity)}
				<span class="text-surface-3">{'●'.repeat(3 - hero.complexity)}</span>
			</span>
		</div>
	</div>
</article>
