---
import type { Hero } from '../data/types';
import { ATTRIBUTE_META } from '../data/heroes';

interface Props {
	hero: Hero;
}

const { hero } = Astro.props;
const attr = ATTRIBUTE_META[hero.attr];
const topRoles = hero.roles.slice(0, 3);
---

<a href={`/heroes/${hero.id}`} class="group relative flex flex-col overflow-hidden rounded-2xl border border-line bg-surface transition hover:border-dota/60 hover:shadow-lg hover:shadow-dota/10">
	<div class="relative aspect-[4/3] w-full overflow-hidden bg-gradient-to-br from-surface-2 to-surface-3">
		<img
			src={hero.img}
			alt={hero.name}
			loading="lazy"
			class="h-full w-full object-cover object-top transition duration-300 group-hover:scale-105"
		/>
		<div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-surface via-surface/40 to-transparent" aria-hidden="true"></div>
		<span class="absolute right-2 top-2 flex h-7 w-7 items-center justify-center rounded-full border border-line bg-ink/70 text-[11px] font-bold backdrop-blur" style={`color:${attr.color}`}>
			{hero.attr}
		</span>
	</div>

	<div class="flex flex-1 flex-col p-3.5">
		<h3 class="font-display text-base leading-tight">{hero.name}</h3>
		<p class="mt-0.5 truncate text-xs text-muted">{hero.nameEn}</p>
		<div class="mt-3 flex flex-wrap gap-1.5">
			{topRoles.map((r) => (
				<span class="rounded bg-surface-3 px-2 py-0.5 text-[11px] text-cream/70">{r.label}</span>
			))}
		</div>
		<div class="mt-3 flex items-center justify-between border-t border-line pt-3 text-xs">
			<span class="text-faint">{hero.attack === 'melee' ? '近战' : '远程'}</span>
			<span class="flex items-center gap-1 text-faint" aria-label={`复杂度 ${hero.complexity}/3`}>
				<span class="text-dota-light">{'●'.repeat(hero.complexity)}</span>
				<span class="text-surface-3">{'●'.repeat(3 - hero.complexity)}</span>
			</span>
		</div>
	</div>
</a>
