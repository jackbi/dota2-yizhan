---
import type { Streamer } from '../data/types';
import { PLATFORM_META } from '../data/site';

interface Props {
	streamer: Streamer;
}

const { streamer: s } = Astro.props;
const meta = PLATFORM_META[s.platform];
const avatar = s.avatar ?? (s.name.slice(0, 1).toUpperCase());
---

<article class="group flex flex-col rounded-2xl border border-line bg-surface p-5 transition hover:border-dota/50 hover:bg-surface-2">
	<div class="flex items-start gap-4">
		<div class="relative h-16 w-16 shrink-0 overflow-hidden rounded-xl">
			{
				s.avatar ? (
					<img src={s.avatar} alt={s.name} class="h-full w-full object-cover" loading="lazy" />
				) : (
					<div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-dota to-dota-deep font-display text-xl text-white">
						{avatar}
					</div>
				)
			}
			<span class:list={['absolute -bottom-1 -right-1 flex h-4 w-4 rounded-full border-2 border-surface', s.live ? 'animate-pulse bg-[#22c55e]' : 'bg-zinc-500']} />
		</div>

		<div class="min-w-0 flex-1">
			<div class="flex items-center gap-2">
				<h3 class="truncate font-display text-lg">{s.name}</h3>
				<span class="shrink-0 rounded px-1.5 py-0.5 text-xs font-semibold" style={`background:${meta.color};color:#fff`}>
					{meta.short}
				</span>
			</div>
			<p class="text-sm text-muted">{s.alias}</p>
			<p class="mt-1 inline-block rounded bg-surface-3 px-2 py-0.5 text-xs text-gold">{s.tag}</p>
		</div>
	</div>

	<p class="mt-4 text-sm leading-relaxed text-muted">{s.description}</p>

	<div class="mt-5 flex items-center justify-between gap-3 border-t border-line pt-4">
		<span class="inline-flex items-center gap-1.5 text-sm text-muted">
			<svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M12 21s-7-5.3-7-11a7 7 0 0 1 14 0c0 5.7-7 11-7 11z" stroke="currentColor" stroke-width="1.6" />
				<circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.6" />
			</svg>
			{s.live ? `${(s.viewers / 1000).toFixed(1)}k 人观看` : '暂未开播'}
		</span>
		<a
			href={s.embedUrl}
			target="_blank"
			rel="noopener noreferrer"
			class:list={[
				'inline-flex items-center gap-1.5 rounded-md px-3 py-2 text-sm font-medium transition',
				s.live ? 'bg-dota text-white hover:bg-dota-light' : 'border border-line text-muted hover:border-dota hover:text-dota-light',
			]}
		>
			{s.live ? '进入直播间' : '关注频道'}
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</a>
	</div>
</article>
