---
import type { Item } from '../data/types';

interface Props {
	item: Item;
}

const { item } = Astro.props;
---

<article class="group flex flex-col rounded-2xl border border-line bg-surface p-5 transition hover:border-gold/50 hover:bg-surface-2">
	<div class="flex items-start justify-between gap-3">
		<div class="flex items-center gap-3">
			<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-surface-2 to-surface-3 font-display text-sm text-gold">
				{item.cn.slice(0, 1)}
			</span>
			<div>
				<h3 class="font-display text-base leading-tight">{item.cn}</h3>
				<p class="text-xs text-muted">{item.name}</p>
			</div>
		</div>
		{item.active ? (
			<span class="shrink-0 rounded bg-dota/15 px-2 py-0.5 text-[10px] font-semibold text-dota-light">主动</span>
		) : (
			<span class="shrink-0 rounded bg-zinc-600/15 px-2 py-0.5 text-[10px] text-zinc-400">被动</span>
		)}
	</div>

	<p class="mt-3 text-sm leading-relaxed text-muted">{item.short}</p>

	<div class="mt-4 flex items-center justify-between border-t border-line pt-3 text-sm">
		<span class="text-xs text-faint">{item.components.join(' + ') || '—'}</span>
		<span class="shrink-0 font-semibold text-gold">{(item.cost / 100).toFixed(1)}k</span>
	</div>
</article>
