---
import type { LiveStatus, ObMember } from '../data/types';
import { PLATFORM_META, roomUrl } from '../data/site';
import { LIVE_STATE_LABEL } from '../lib/liveApi';
import { OB_MEMBER_VIDEOS } from '../data/obVideos';
import BiliVideoCard from './BiliVideoCard.astro';
import type { ObPlayerStat } from '../lib/obPlayers';
import { formatMatchTime } from '../lib/format';

interface Props {
	member: ObMember;
	live?: LiveStatus;
	/** 站内头像路径（`/avatars/xxx.jpg`）。拿不到时不传，退回首字母占位。 */
	avatar?: string;
	/** `BV 号 → /covers/xxx.jpg`（见 `src/lib/covers.ts`）。拿不到的不在里面，退回热链原图。 */
	covers?: Map<string, string>;
	/** 天梯与英雄池。拿不到（账号匿名、长期没打、上游不通）时整块不出现。 */
	stat?: ObPlayerStat;
	/** 已经切好、图标也备好的英雄；由页面算好传进来，组件不碰数据源。 */
	heroes?: { name: string; icon?: string; games: number; wins: number }[];
	/** 这批英雄的统计口径（`7.41f 版本` / `近 90 天`）。 */
	heroScope?: string;
	/** 构建时刻，用来把「最近一场」写成相对时间。 */
	now?: number;
}

const { member: m, live, avatar, covers, stat, heroes = [], heroScope, now } = Astro.props;
const meta = PLATFORM_META[m.platform];
const url = roomUrl(m.platform, m.roomId);
const state = live?.state ?? 'unknown';
const videos = OB_MEMBER_VIDEOS[m.id] ?? [];

const stateText = LIVE_STATE_LABEL[state];
const stateColor = state === 'live' ? 'text-[#4ade80]' : state === 'replay' ? 'text-gold' : 'text-faint';
const dotClass =
	state === 'live' ? 'animate-pulse bg-[#22c55e]' : state === 'replay' ? 'bg-gold' : 'bg-zinc-500';
const ringClass =
	state === 'live'
		? 'ring-2 ring-[#22c55e]/60'
		: state === 'replay'
			? 'ring-2 ring-gold/50'
			: 'ring-1 ring-line';
---

<article
	id={`member-${m.id}`}
	class="flex scroll-mt-24 flex-col rounded-2xl border border-line bg-surface p-5 transition hover:border-dota/50 hover:bg-surface-2"
>
	<div class="flex items-start gap-4">
		{/*
			头像压在首字母上：图加载出来就盖住它，加载失败（或本来就没抓到）就露出
			品牌渐变色块 + 首字母。用背景图而不是 <img>，失败时不会出现破图图标。
		*/}
		<div
			class:list={[
				'relative h-14 w-14 shrink-0 overflow-hidden rounded-xl bg-gradient-to-br from-dota to-dota-deep',
				ringClass,
			]}
			aria-hidden="true"
		>
			<span class="absolute inset-0 flex items-center justify-center font-display text-lg text-white">
				{m.name.slice(0, 2)}
			</span>
			{
				avatar && (
					<span class="absolute inset-0 bg-cover bg-center" style={`background-image:url('${avatar}')`} />
				)
			}
		</div>

		<div class="min-w-0 flex-1">
			<div class="flex flex-wrap items-center gap-2">
				<h3 class="font-display text-xl leading-none">{m.name}</h3>
				<span
					class="shrink-0 rounded px-1.5 py-0.5 text-xs font-semibold"
					style={`background:${meta.color};color:#fff`}>{meta.short}</span
				>
				<span class:list={['ml-auto inline-flex items-center gap-1.5 text-xs font-medium', stateColor]}>
					<span class:list={['h-1.5 w-1.5 rounded-full', dotClass]} />
					{stateText}
				</span>
			</div>
			<p class="mt-1.5 text-sm text-muted">
				{m.realName}<span class="text-faint"> · </span>{m.role}
			</p>
			{live?.roomName && <p class="mt-1 truncate text-xs text-faint" title={live.roomName}>{live.roomName}</p>}
		</div>
	</div>

	{
		live?.ownerUnrecognized && live.ownerName && (
			<p class="mt-3 rounded-lg border border-line/70 bg-surface-2/60 px-3 py-2 text-xs leading-relaxed text-faint">
				平台当前昵称：<span class="text-cream/80">{live.ownerName}</span>（与常用叫法不同，可能只是改过名）
			</p>
		)
	}
	{live?.note && <p class="mt-3 text-xs leading-relaxed text-faint">{live.note}</p>}

	<div class="mt-4">
		<p class="text-xs font-medium uppercase tracking-wider text-faint">外号 · 社区流传</p>
		<div class="mt-2 flex flex-wrap gap-1.5">
			{
				m.aliases.map((a) => (
					<span class="rounded-md border border-line bg-surface-3/70 px-2 py-0.5 text-xs leading-5 text-cream/90 transition hover:border-dota/50 hover:bg-surface-3">
						{a}
					</span>
				))
			}
		</div>
	</div>

	<p class="mt-4 text-sm leading-relaxed text-muted">{m.description}</p>

	<p class="mt-3 text-xs leading-relaxed text-faint">
		<span class="text-gold/80">主要荣誉：</span>{m.achievement}
	</p>

	{
		stat ? (
			<div class="mt-3 rounded-xl border border-line bg-surface-2/50 px-3 py-2.5">
				<p class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs">
					<span class="text-faint">天梯</span>
					<span class="text-cream">{stat.rankLabel}</span>
					<span class="text-faint">累计 {stat.matchCount.toLocaleString('zh-CN')} 场</span>
					{stat.lastMatchDate ? (
						<span class="text-faint">最近一场 {formatMatchTime(stat.lastMatchDate, now ?? Math.floor(Date.now() / 1000))}</span>
					) : (
						<span class="text-faint">没有公开对局记录</span>
					)}
				</p>
				{/*
					账号昵称一定要写出来：它常常和页面上的名字差很远（YYF 的账号叫「只打3」），
					读者对不上时能自己发现——与房间那句 `ownerMatch` 是同一个态度，
					宁可让人来核对，也不要让一个错账号看起来像对的。
				*/}
				{stat.persona && <p class="mt-0.5 text-[11px] text-faint">数据来自账号「{stat.persona}」</p>}

				{
					heroes.length > 0 ? (
						<p class="mt-2 flex flex-wrap items-center gap-1.5 text-xs">
							<span class="text-faint">擅长英雄{heroScope ? `（${heroScope}）` : ''}</span>
							{heroes.map((hero) => (
								<span
									class="inline-flex items-center gap-1 rounded-md border border-line bg-surface-2 py-0.5 pl-0.5 pr-1.5"
									title={`${hero.name} · ${hero.games} 场 ${hero.wins} 胜`}
								>
									{hero.icon ? <img src={hero.icon} alt={hero.name} loading="lazy" class="h-5 w-5 rounded-sm object-cover" /> : null}
									<span class="text-cream/90">{hero.name}</span>
									<span class="text-[10px] text-faint">
										{hero.games} 场 {hero.wins} 胜
									</span>
								</span>
							))}
						</p>
					) : stat.pool ? (
						/*
						 * 池子有数据、但英雄名没解析出来（更新日志那条名字表没通）：
						 * 这与"账号没有公开对局"是两件事，不能写成同一句——上一版就是这么把
						 * "这次构建没取到名字"说成了"没打过"。
						 */
						<p class="mt-2 text-[11px] leading-relaxed text-faint">
							这个账号有 {stat.pool.heroes.length} 个英雄的对局记录，但这次构建没取到英雄名（名字表那条源没通），刷新页面或等下次重建就能看到。
						</p>
					) : (
						<p class="mt-2 text-[11px] leading-relaxed text-faint">
							这个账号没有可用的公开对局（退役后不常打，或账号设为匿名），所以给不出英雄池。
						</p>
					)
				}
			</div>
		) : (
			m.champions.length > 0 && (
				<p class="mt-2 flex flex-wrap items-center gap-1.5 text-xs">
					<span class="text-faint">代表英雄（社区认知，非统计）</span>
					{m.champions.map((c) => (
						<span class="rounded bg-surface-3 px-1.5 py-0.5 text-cream/90">{c}</span>
					))}
				</p>
			)
		)
	}

	{
		videos.length > 0 && (
			<div class="mt-5 border-t border-line pt-4">
				<div class="flex items-baseline justify-between gap-3">
					<p class="text-xs font-medium uppercase tracking-wider text-faint">名场面 · 人物志</p>
					<span class="text-[11px] tabular-nums text-faint">{videos.length} 支</span>
				</div>
				<div class="mt-2.5 space-y-2">
					{videos.map((v) => (
						<BiliVideoCard video={v} cover={covers?.get(v.bv)} />
					))}
				</div>
			</div>
		)
	}

	{
		m.jokes.length > 0 && (
			<div class="mt-5 border-t border-line pt-4">
				<p class="text-xs font-medium uppercase tracking-wider text-faint">梗 · 社区流传</p>
				<ul class="mt-2 grid gap-1 sm:grid-cols-2">
					{m.jokes.map((j) => (
						<li class="text-xs leading-relaxed text-muted">
							<span class="text-dota-light">·</span> {j}
						</li>
					))}
				</ul>
			</div>
		)
	}

	<div class="mt-auto flex items-center justify-between gap-3 border-t border-line pt-4">
		<span class="text-xs text-faint">
			{meta.label} · 房间 <span class="text-cream/80">{m.roomId}</span>
		</span>
		<a
			href={url}
			target="_blank"
			rel="noopener noreferrer"
			class:list={[
				'inline-flex items-center gap-1.5 rounded-md px-3 py-2 text-sm font-medium transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-dota-light focus-visible:ring-offset-2 focus-visible:ring-offset-ink',
				state === 'live'
					? 'bg-dota text-white hover:bg-dota-dark'
					: 'border border-line text-muted hover:border-dota hover:text-dota-light',
			]}
		>
			{state === 'live' ? '进入直播间' : '前往直播间'}
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path
					d="M7 17 17 7M9 7h8v8"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</a>
	</div>
</article>
