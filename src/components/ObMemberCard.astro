---
import type { LiveStatus, ObMember } from '../data/types';
import { PLATFORM_META, roomUrl } from '../data/site';
import { LIVE_STATE_LABEL } from '../lib/liveApi';

interface Props {
	member: ObMember;
	live?: LiveStatus;
}

const { member: m, live } = Astro.props;
const meta = PLATFORM_META[m.platform];
const url = roomUrl(m.platform, m.roomId);
const state = live?.state ?? 'unknown';
const retaken = live?.roomRetaken ?? false;

/** 房间已换人时不再声称开播状态，房间号也随之标黄。 */
const stateText = retaken ? '房间已换人' : LIVE_STATE_LABEL[state];
const stateColor = retaken
	? 'text-gold'
	: state === 'live'
		? 'text-[#4ade80]'
		: state === 'replay'
			? 'text-gold'
			: 'text-faint';
const dotClass = retaken
	? 'bg-gold'
	: state === 'live'
		? 'animate-pulse bg-[#22c55e]'
		: state === 'replay'
			? 'bg-gold'
			: 'bg-zinc-500';
---

<article
	class:list={[
		'group flex flex-col rounded-2xl border bg-surface p-5 transition',
		retaken ? 'border-gold/30' : 'border-line hover:border-dota/50 hover:bg-surface-2',
	]} 
>
	<div class="flex items-start gap-4">
		<div class="relative h-14 w-14 shrink-0 overflow-hidden rounded-xl">
			<div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-dota to-dota-deep font-display text-lg text-white">
				{m.name.slice(0, 2)}
			</div>
			<span class:list={['absolute -bottom-1 -right-1 h-4 w-4 rounded-full border-2 border-surface', dotClass]} />
		</div>

		<div class="min-w-0 flex-1">
			<div class="flex flex-wrap items-center gap-2">
				<h3 class="font-display text-lg">{m.name}</h3>
				<span class="shrink-0 rounded px-1.5 py-0.5 text-xs font-semibold" style={`background:${meta.color};color:#fff`}>
					{meta.short}
				</span>
			</div>
			<p class="mt-0.5 text-sm text-muted">
				{m.realName}
				<span class="text-faint"> · </span>{m.role}
			</p>
		</div>
	</div>

	<div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
		<span class:list={['inline-flex items-center gap-1.5 font-medium', stateColor]}>
			<span class:list={['h-1.5 w-1.5 rounded-full', dotClass]} />
			{stateText}
		</span>
		{live?.roomName && !retaken && <span class="truncate text-faint">{live.roomName}</span>}
	</div>

	{
		retaken && live?.note && (
			<p class="mt-2 rounded-lg border border-gold/30 bg-gold/5 px-2.5 py-1.5 text-xs leading-relaxed text-gold">
				{live.note}
				——房间号会随主播转平台、换房间而变化，这不代表名单有误。
			</p>
		)
	}
	{
		!retaken && live?.note && (
			<p class="mt-2 text-xs leading-relaxed text-faint">{live.note}</p>
		)
	}

	<p class="mt-3 text-sm leading-relaxed text-muted">{m.description}</p>

	<p class="mt-3 text-xs leading-relaxed text-faint">
		<span class="text-gold/80">主要荣誉：</span>{m.achievement}
	</p>

	{
		m.champions.length > 0 && (
			<p class="mt-2 flex flex-wrap items-center gap-1.5 text-xs">
				<span class="text-faint">代表英雄</span>
				{m.champions.map((c) => (
					<span class="rounded bg-surface-3 px-1.5 py-0.5 text-cream/90">{c}</span>
				))}
			</p>
		)
	}

	<div class="mt-4 border-t border-line pt-3">
		<p class="text-xs text-faint">外号（社区流传）</p>
		<p class="mt-1.5 flex flex-wrap gap-1.5">
			{
				m.aliases.map((a) => (
					<span class="rounded-full border border-line px-2 py-0.5 text-xs text-cream/80">{a}</span>
				))
			}
		</p>
	</div>

	{
		m.jokes.length > 0 && (
			<div class="mt-3">
				<p class="text-xs text-faint">梗（社区流传）</p>
				<ul class="mt-1.5 space-y-1">
					{m.jokes.map((j) => (
						<li class="text-xs leading-relaxed text-muted">
							<span class="text-dota-light">·</span> {j}
						</li>
					))}
				</ul>
			</div>
		)
	}

	<div class="mt-5 flex items-center justify-between gap-3 border-t border-line pt-4">
		<span class="text-xs text-faint">
			{meta.label} · 房间 <span class:list={[retaken ? 'text-gold' : 'text-cream/80']}>{m.roomId}</span>
		</span>
		<a
			href={url}
			target="_blank"
			rel="noopener noreferrer"
			class:list={[
				'inline-flex items-center gap-1.5 rounded-md px-3 py-2 text-sm font-medium transition',
				state === 'live' && !retaken
					? 'bg-dota text-white hover:bg-dota-light'
					: 'border border-line text-muted hover:border-dota hover:text-dota-light',
			]}
		>
			{retaken ? '打开原房间' : state === 'live' ? '进入直播间' : '前往直播间'}
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</a>
	</div>
</article>
