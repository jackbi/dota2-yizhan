---
/**
 * 页头的登录入口。
 *
 * 静态渲染出**未登录**状态（一个指向登录路由的普通链接），登录后再由下面的脚本换成头像。
 * 这么绕一圈是因为站内绝大多数页面是构建期生成的纯 HTML，渲染时根本不知道谁在看——
 * 若要在服务端出登录态，就得把所有页面都改成 SSR，代价远大于一次 `/api/me` 请求。
 *
 * 未登录态同时是没有 JS 时的兜底：`/api/auth/steam/login` 是 GET 跳转，直接点就能用。
 *
 * 下面这段**必须是 `is:inline`**，也**必须紧跟在元素后面**，两个原因都在脚本里写了。
 */
---

<div id="auth-entry" class="flex items-center gap-2">
	<a
		href="/api/auth/steam/login"
		aria-label="用 Steam 登录"
		class="flex items-center gap-2 rounded-md border border-line px-3 py-2 text-sm font-medium text-muted transition hover:border-dota hover:bg-surface-2 hover:text-cream"
	>
		<svg height="16" viewBox="0 0 24 24" class="shrink-0 fill-current" aria-hidden="true">
			<path
				d="M23.938 12c0 6.595-5.353 11.938-11.957 11.938A11.95 11.95 0 0 1 .476 15.254l4.583 1.892a3.382 3.382 0 0 0 6.696-.823l4.067-2.898a4.512 4.512 0 0 0 4.611-4.5 4.511 4.511 0 0 0-9.02 0v.057l-2.85 4.125a3.37 3.37 0 0 0-2.094.583L.062 11.042C.553 4.895 5.7.062 11.981.062 18.585.062 23.938 5.405 23.938 12zm-16.38 6.176l-1.469-.607a2.541 2.541 0 0 0 1.31 1.242 2.544 2.544 0 0 0 3.32-1.367 2.51 2.51 0 0 0 .005-1.94A2.53 2.53 0 0 0 7.48 14.1l1.516.625a1.862 1.862 0 0 1 1.006 2.44 1.87 1.87 0 0 1-2.445 1.012zm8.365-6.253c-1.656 0-3.004-1.348-3.004-2.999s1.348-2.999 3.004-2.999 3.004 1.348 3.004 3-1.343 2.998-3.004 2.998zm.005-.75a2.254 2.254 0 0 0 0-4.505 2.257 2.257 0 0 0-2.258 2.251 2.263 2.263 0 0 0 2.258 2.253z"
			></path>
		</svg>
		<span class="hidden sm:inline">Steam 登录</span>
	</a>
</div>

<script is:inline>
	/*
	 * 页头的登录态渲染。
	 *
	 * **为什么是内联脚本、为什么紧跟在元素后面。**
	 * 这原来是 Astro 的模块脚本，会被打包成外链 js：浏览器得先发一次请求、拿到文件才执行，
	 * 而第一帧早就画完了。加上拿到登录态还要等 `/api/me` 回来，于是每次翻页都能看见
	 * 「Steam 登录」先亮一下、再变成头像。更烦的是页头是 `justify-between`
	 * （logo / 导航 / 右侧这一组），右侧宽度一变，**中间那排导航就跟着横跳**。
	 * 改成 `is:inline` 后脚本在解析到它的那一刻同步执行，浏览器还没画第一帧：
	 * 缓存里已经有身份就直接画出来，宽度不再变化，导航也就不会跳。
	 *
	 * 缓存只存展示用的 id / 昵称 / 头像。会话本身是 HttpOnly 的签名 Cookie，这里既拿不到、
	 * 也不需要——缓存**只负责先画**，登录态一律以 `/api/me` 为准：它回来之后要么确认，
	 * 要么把缓存清掉、退回登录链接（所以不会出现"已经登出却一直显示头像"）。
	 */
	(function () {
		var CACHE_KEY = 'auth:entry:v1';
		var entry = document.getElementById('auth-entry');
		if (!entry) return;

		/*
		 * 静态渲染出来的登录链接，留着在"缓存过期但人已登出"时还原。
		 * 它是本站自己的固定 markup，不含任何用户输入——和下面 renderUser 里
		 * 「只用 createElement + textContent」那条防 XSS 的规矩不冲突。
		 */
		var loginMarkup = entry.innerHTML;

		/**
		 * 全部用 createElement + textContent 拼 DOM。
		 *
		 * 昵称来自 Steam、头像 URL 来自 STRATZ，都是**用户可控**的输入；用 innerHTML 拼字符串
		 * 就等于把 XSS 挂在每个页面的页头上。这里不给任何注入留口子。
		 */
		function renderUser(user) {
			entry.textContent = '';

			var profile = document.createElement('a');
			profile.href = '/me';
			profile.className =
				'flex items-center gap-2 rounded-md border border-line py-1 pl-1 pr-3 transition hover:border-dota hover:bg-surface-2';
			profile.title = '查看我的战绩';

			if (user.avatar) {
				var img = document.createElement('img');
				img.src = user.avatar;
				img.alt = '';
				img.width = 28;
				// Steam 的头像 CDN 会拒掉带 Referer 的请求（站内其它头像也一并用 no-referrer）。
				img.referrerPolicy = 'no-referrer';
				// 取不到时不要让破图占位，直接摘掉。
				img.addEventListener('error', function () {
					img.remove();
				});
				img.className = 'h-7 w-7 shrink-0 rounded object-cover';
				profile.append(img);
			}

			var name = document.createElement('span');
			name.textContent = user.name;
			name.className = 'max-w-28 truncate text-sm font-medium text-cream';
			profile.append(name);

			var logout = document.createElement('form');
			logout.method = 'POST';
			logout.action = '/api/auth/logout';

			var button = document.createElement('button');
			button.type = 'submit';
			button.className = 'rounded-md px-2 py-2 text-xs text-faint transition hover:bg-surface-2 hover:text-cream';
			button.textContent = '登出';
			button.title = '登出';

			logout.append(button);
			entry.append(profile, logout);
		}

		/*
		 * localStorage 在无痕模式、被策略禁用的第三方上下文里会直接抛错。
		 * 缓存是锦上添花的东西，坏掉最多退回"没有缓存"的老行为，不该让页头整个不工作。
		 */
		function readCache() {
			try {
				var raw = localStorage.getItem(CACHE_KEY);
				if (!raw) return null;
				var user = JSON.parse(raw);
				return user && typeof user.accountId === 'number' && typeof user.name === 'string' ? user : null;
			} catch (error) {
				return null;
			}
		}

		function writeCache(user) {
			try {
				localStorage.setItem(CACHE_KEY, JSON.stringify(user));
			} catch (error) {
				/* 存不进去就算了，下次翻页多闪一下而已 */
			}
		}

		function clearCache() {
			try {
				localStorage.removeItem(CACHE_KEY);
			} catch (error) {
				/* 同上 */
			}
		}

		var cached = readCache();
		if (cached) renderUser(cached);

		fetch('/api/me', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
			.then(function (res) {
				return res.ok ? res.json() : null;
			})
			.then(function (data) {
				var user = data && data.user;
				if (user) {
					renderUser(user);
					writeCache(user);
					return;
				}
				/*
				 * `data` 为空 = 接口没返回（断网、5xx、被拦截），**不能当成登出**：
				 * 保持缓存画出来的样子，也别在控制台吓人。
				 */
				if (!data) return;
				clearCache();
				if (cached) entry.innerHTML = loginMarkup;
			})
			.catch(function () {});
	})();
</script>
