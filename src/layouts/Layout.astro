---
import '../styles/global.css';
import AuthEntry from '../components/AuthEntry.astro';
import { inlineJson } from '../lib/inlineJson';
import { ANALYTICS, NAV } from '../data/site';

interface Props {
	title?: string;
	description?: string;
	/**
	 * 面包屑：`[{ name: '英雄', href: '/heroes' }, { name: '敌法师' }]`。
	 * **不用写首页**——这里会自动在最前面补一条，省得每个页面都抄一遍。
	 * 最后一项不给 href（那就是当前页）。
	 */
	breadcrumbs?: { name: string; href?: string }[];
}

const { title = 'DOTA2 驿站', description = 'OB 大家庭 · 分屏直播 · 资讯 · 赛事 · 版本 · 英雄与装备', breadcrumbs = [] } = Astro.props;
/*
 * 当前导航项怎么判。
 *
 * 直接写 `path === item.href` 是错的：构建期 `Astro.url.pathname` 带尾斜杠
 * （产物是 `heroes/index.html`，pathname 就是 `/heroes/`），而 NAV 里写的是 `/heroes`——
 * 结果**只有首页亮**（两边都是 `/` 才刚好相等），一度看着像"高亮功能没做"。
 *
 * 这里两种写法都认（带不带尾斜杠），并且让子页面归到自己的那一栏：
 * `/heroes/1/` 亮「英雄」、`/news/reddit/xxx/` 亮「资讯」。
 */
const path = Astro.url.pathname;
const isActive = (href: string): boolean => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));

/*
 * 访问统计（Cloudflare Web Analytics）。
 *
 * 三个判断，每个都在拦一类会污染数据或泄露信息的情况：
 *
 * - **配了 token**：没配就一行脚本都不输出。默认值是空串，所以这个功能是「打开才有效」，
 *   不会因为别人 fork 了这个仓库就替他打点；
 * - **域名**：判断放在**浏览器里**而不是构建期。预渲染页面的 HTML 是构建期写死的，
 *   构建期怎么比都是「对」——`astro preview` 把产物喂给 localhost 时照样会打点。
 *   所以这里只把一个域名常量交给内联脚本，由它在注入 beacon 之前比一次
 *   `location.hostname`，本地预览、fork 出去自建域名都不会进这份统计；
 * - **不在 `/party` 上**：房间码在 URL 的 `#` 片段里（见 src/scripts/partyRoom.ts 的
 *   codeFromHash），邀请链接本身就是「凭码进房」的凭证，不该出现在任何第三方的报表里。
 *   开黑页的回访数据用别的方式看（`/` 与 `/live` 的对比已经够判断活跃度）。
 */
const analyticsToken = ANALYTICS.cfBeaconToken.trim();
const analyticsHost = Astro.site?.host ?? '';
const analyticsEnabled = analyticsToken.length > 0 && analyticsHost.length > 0 && !path.startsWith('/party');

/*
 * SEO 这一层要的三样东西都在这里拼，理由分别是：
 *
 * - **canonical**：站内不少页面既能从列表页进、也能带查询串进（比如筛选过的），
 *   不带 canonical 就等于把同一份内容拆成好几份让搜索引擎自己猜主版本；
 * - **og / twitter**：分享到 NGA、贴吧、TG 群时给的是标题+描述+图，缺了就只剩一个裸链接；
 * - **JSON-LD**：告诉搜索引擎这是个什么站点（中文内容站），是唯一"结构化"表达站点身份的途径。
 *
 * `Astro.site` 由 `astro.config.mjs` 的 `site` 提供；本地 dev 下它是线上域名——
 * 这只影响字符串，不存在"本地生成出线上链接"的风险。
 */
const canonical = new URL(path, Astro.site ?? Astro.url).href;
const ogImage = new URL('/logo.webp', Astro.site ?? Astro.url).href;
const siteRoot = new URL('/', Astro.site ?? Astro.url).href;
/*
 * 两个节点，不是一个：
 * - `WebSite` 描述**站点本身**，url 必须是站点根——挂在子页面上（比如把 hero 页当 WebSite.url）
 *   是在向搜索引擎报错身份；
 * - `WebPage` 描述**当前这一页**，url 用 canonical，并声明它属于上面那个站点。
 */
const structuredData = [
	{
		'@type': 'WebSite',
		'@id': `${siteRoot}#website`,
		name: 'DOTA2 驿站',
		url: siteRoot,
		description: '面向中文玩家的 DOTA2 门户：开播状态与分屏直播、资讯、赛事赛程、版本更新日志、英雄与装备资料、BP 阵容分析。',
		inLanguage: 'zh-CN',
	},
	{
		'@type': 'WebPage',
		'@id': `${canonical}#webpage`,
		url: canonical,
		name: title,
		description,
		isPartOf: { '@id': `${siteRoot}#website` },
		inLanguage: 'zh-CN',
	},
	/*
	 * 面包屑：搜索结果里能显示成 `dota2.hiwenbin.com › 英雄 › 敌法师`，
	 * 比自己写一行标题更容易被点。**只有详情页才给**——列表页没有层级，
	 * 硬造一条"首页 > 英雄"反而是在给搜索引擎喂假结构。
	 */
	...(breadcrumbs.length > 0
		? [
				{
					'@type': 'BreadcrumbList',
					itemListElement: [{ name: '首页', href: '/' }, ...breadcrumbs].map((crumb, index) => ({
						'@type': 'ListItem',
						position: index + 1,
						name: crumb.name,
						...(crumb.href ? { item: new URL(crumb.href, Astro.site ?? Astro.url).href } : {}),
					})),
				},
			]
		: []),
];
/*
 * 内联 JSON-LD 走 `inlineJson`：里面的 title / description / 面包屑名字是第三方内容
 * （帖子标题、英雄名…），`JSON.stringify` 不碰 `<`，一个 `</script>` 就能提前闭合脚本元素。
 */
const structuredJson = inlineJson(structuredData);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		{/* 标签页图标用 logo 生成的 PNG 而不是 WebP：Safari 至今不支持 WebP 的 favicon。 */}
		<link rel="icon" type="image/png" href="/favicon.png" sizes="96x96" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		{/*
			三个搜索引擎的「HTML 标签验证」：百度 / Google Search Console / Bing Webmaster。

			- 这些是**公开值**，不是密钥：它们本来就该出现在 HTML 里给爬虫看，所以进仓库没问题。
		   （真正不能进仓库的是百度那种带 token 的推送地址，那个走 CI secret。）
			- **删掉 = 平台认为站点易主**，之后的 sitemap 提交、配额、数据都会跟着出问题；
			要换验证方式（比如改 DNS TXT）之前先把这里的标签留着，等新方式通过再说。
			- 放在 Layout 而不是只放首页：平台抓的是首页，但站点换域名/路由时让每个页面都带着最省心
			——验证失败通常只回一句「未检测到标签」，从页面上反而查不出是哪一步丢的。
		*/}
		<meta name="baidu-site-verification" content="codeva-CrdWwuNosd" />
		<meta name="google-site-verification" content="tju3zQJcrAUdq9WdZWpgxMS_WdcdHm75Pz41iQTIUGQ" />
		<meta name="msvalidate.01" content="F8682C1E08B95548D0945B3A295BD7CA" />
		<title>{title}</title>
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="DOTA2 驿站" />
		<meta property="og:locale" content="zh_CN" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<script type="application/ld+json" set:html={structuredJson} />
		{
			analyticsEnabled ? (
				<script
					is:inline
					set:html={`if (location.hostname === ${inlineJson(analyticsHost)}) { const s = document.createElement('script'); s.defer = true; s.src = 'https://static.cloudflareinsights.com/beacon.min.js'; s.dataset.cfBeacon = ${inlineJson(
						JSON.stringify({ token: analyticsToken }),
					)}; document.head.append(s); }`}
				/>
			) : null
		}
		{/*
			字体是自托管的：`@font-face` 在 global.css 里（由 scripts/fonts.mjs 生成，
			分片文件和 unicode-range 都取自 Google Fonts）。原先这里引 fonts.googleapis.com，
			但那两个域名在国内连不通——绝大多数访客其实一直在看回退字体，还要为一次必然
			失败的跨域请求多付一次 DNS / TLS 握手。现在既没有第三方请求，也不需要
			再用 `media="print"` + onload 绕开渲染阻塞。
		*/}
		<slot name="head" />
	</head>
	<body>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-dota focus:px-4 focus:py-2 focus:text-white"
		>
			跳转到主要内容
		</a>

		<header class="sticky top-0 z-50 border-b border-line bg-ink/80 backdrop-blur-xl">
			<div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
				<a href="/" class="group flex items-center gap-2.5">
					{/*
						站点 logo 是 public/logo.webp：由母版 src/assets/logo.png 转出来的 128px WebP（4.7 KB），
						换 logo 跑 scripts/logo-assets.sh。母版刻意不放 public/，否则那张 1254px 原图会跟着发布产物走。
						128px 够 40px 的显示在 3 倍屏上用。图里虽然烧了「DOTA2 驿站」字样，但在 40px 下认不出来，
						所以旁边的文字保留。`alt=""` 是故意的：旁边的文字已经念出了站点名，读屏不该听两遍。
					*/}
					<img
						src="/logo.webp"
						alt=""
						width="40"
						height="40"
						class="h-10 w-10 rounded-md shadow-lg shadow-dota/30 transition group-hover:brightness-110"
					/>
					<span class="font-display text-lg tracking-wide">DOTA2 驿站</span>
				</a>

				<nav class="hidden items-center gap-1 lg:flex" aria-label="主导航">
					{
						NAV.map((item) => {
							const active = isActive(item.href);
							return (
								<a
									href={item.href}
									aria-current={active ? 'page' : undefined}
									class:list={[
										'rounded-md px-3 py-2 text-sm font-medium transition',
										active ? 'bg-dota/15 text-dota-light' : 'text-muted hover:bg-surface-2 hover:text-cream',
									]}
								>
									{item.label}
								</a>
							);
						})
					}
				</nav>

				<div class="flex items-center gap-2">
					<AuthEntry />
					<button
						id="menu-btn"
						type="button"
						class="flex h-10 w-10 items-center justify-center rounded-md border border-line text-cream transition hover:bg-surface-2 lg:hidden"
						aria-label="打开导航菜单"
						aria-controls="mobile-menu"
						aria-expanded="false"
					>
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
						</svg>
					</button>
				</div>
			</div>

			<nav id="mobile-menu" class="hidden border-t border-line bg-ink lg:hidden" aria-label="移动端导航" hidden>
				<div class="mx-auto grid max-w-7xl gap-1 px-4 py-4 sm:px-6">
					{
						NAV.map((item) => {
							const active = isActive(item.href);
							return (
								<a
									href={item.href}
									aria-current={active ? 'page' : undefined}
									class:list={[
										'rounded-md px-4 py-3 text-base font-medium transition',
										active ? 'bg-dota/15 text-dota-light' : 'text-muted hover:bg-surface-2 hover:text-cream',
									]}
								>
									{item.label}
								</a>
							);
						})
					}
				</div>
			</nav>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="mt-24 border-t border-line bg-ink-2">
			<div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-10 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
				<div>
					<div class="flex items-center gap-2.5">
						<img src="/logo.webp" alt="" width="32" height="32" class="h-8 w-8 rounded-md" />
						<span class="font-display">DOTA2 驿站</span>
					</div>
					<p class="mt-3 max-w-md text-sm text-muted">
						一个专注 DOTA2 的玩家社区：OB 大家庭、分屏直播、资讯、赛事、版本与英雄装备资料。
					</p>
				</div>
				<div class="flex flex-wrap gap-x-8 gap-y-3 text-sm">
					{NAV.map((item) => <a href={item.href} class="text-muted transition hover:text-cream">{item.label}</a>)}
				</div>
			</div>
			<div class="border-t border-line">
				<div class="mx-auto max-w-7xl px-4 py-4 text-center text-xs text-faint sm:px-6">
					© {new Date().getFullYear()} DOTA2 驿站 · 数据来自官方与社区公开来源 ·
					{/*
						开源仓库的入口放在页脚：三篇推广帖里都会写「代码开源」，读者看完站点想找代码，
						最自然的地方就是页脚，不该逼他们回帖子里翻。
					*/}
					<a
						href="https://github.com/jackbi/dota2-yizhan"
						target="_blank"
						rel="noopener noreferrer"
						title="DOTA2 驿站的源码（Apache-2.0）"
						class="inline-flex items-center gap-1 align-[-2px] transition hover:text-cream"
					>
						<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
							<path
								d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A7.995 7.995 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
							></path>
						</svg>
						开源仓库
					</a>
				</div>
			</div>
		</footer>

		<script>
			const btn = document.getElementById('menu-btn');
			const menu = document.getElementById('mobile-menu');
			if (btn && menu) {
				btn.addEventListener('click', () => {
					const open = menu.hasAttribute('hidden');
					menu.toggleAttribute('hidden');
					menu.classList.toggle('hidden');
					btn.setAttribute('aria-expanded', String(open));
				});
			}
		</script>
	</body>
</html>
