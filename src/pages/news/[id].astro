---
import Layout from '../../layouts/Layout.astro';
import type { OfficialNews } from '../../lib/newsApi';
import { FEED_LABEL, fetchNewsArticle, fetchOfficialNews } from '../../lib/newsApi';

interface Props {
	item: OfficialNews;
	/** 列表按时间倒序：前一条更新，后一条更早。 */
	newer: OfficialNews | null;
	older: OfficialNews | null;
}

export async function getStaticPaths() {
	const articles = await fetchOfficialNews();
	return articles.map((item, index) => ({
		params: { id: item.id },
		props: { item, newer: articles[index - 1] ?? null, older: articles[index + 1] ?? null },
	}));
}

const { item, newer, older } = Astro.props;

let content = '';
try {
	content = await fetchNewsArticle(item.url);
} catch {
	content = '';
}

const tags = item.feeds.length > 0 ? item.feeds.map((feed) => FEED_LABEL[feed]) : ['综合新闻'];
// 列表封面常常就是正文里的第一张图，重复时只保留正文里的那张。
const coverName = item.img.split('/').pop() ?? '';
const showCover = Boolean(item.img) && !content.includes(coverName);
---

<Layout
	title={`${item.title} · 新闻 · DOTA2 驿站`}
	description={item.summary || item.title}
	breadcrumbs={[{ name: '新闻', href: '/news' }, { name: item.title }]}
>
	<Fragment slot="head">
		<meta name="referrer" content="no-referrer" />
	</Fragment>
	<section class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
		<a href="/news" class="inline-flex items-center gap-1.5 text-sm text-muted transition hover:text-gold">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
			返回新闻列表
		</a>

		<header class="mt-5 border-b border-line pb-6">
			<div class="flex flex-wrap items-center gap-2 text-xs">
				{tags.map((tag) => <span class="rounded-md bg-dota/15 px-2 py-1 font-semibold text-dota-light">{tag}</span>)}
				<span class="text-faint">{item.date}</span>
			</div>
			<h1 class="mt-3 font-display text-2xl leading-tight text-cream sm:text-3xl">{item.title}</h1>
			<p class="mt-3 text-sm text-muted">来源：DOTA2 官方网站</p>
		</header>

		{
			showCover ? (
				<img src={item.img} alt={item.title} referrerpolicy="no-referrer" class="mt-6 w-full rounded-2xl border border-line object-cover" />
			) : null
		}

		<div class="mt-6 rounded-2xl border border-line bg-surface p-5 sm:p-8">
			{
				content ? (
					<div class="article-content" set:html={content} />
				) : (
					<p class="text-muted">正文抓取失败，稍后重新进入本页即可。</p>
				)
			}
		</div>

		{
			older || newer ? (
				<nav class="mt-10 grid gap-3 sm:grid-cols-2" aria-label="相邻新闻">
					{older ? (
						<a href={`/news/${older.id}`} class="group rounded-2xl border border-line bg-surface p-4 transition hover:border-dota/50 hover:bg-surface-2">
							<span class="text-xs text-faint">← 更早</span>
							<p class="mt-1 line-clamp-2 text-sm text-cream transition group-hover:text-dota-light">{older.title}</p>
						</a>
					) : null}
					{newer ? (
						<a
							href={`/news/${newer.id}`}
							class="group rounded-2xl border border-line bg-surface p-4 transition hover:border-dota/50 hover:bg-surface-2 sm:text-right"
						>
							<span class="text-xs text-faint">更新 →</span>
							<p class="mt-1 line-clamp-2 text-sm text-cream transition group-hover:text-dota-light">{newer.title}</p>
						</a>
					) : null}
				</nav>
			) : null
		}
	</section>
</Layout>
