---
import Layout from '../layouts/Layout.astro';
import ObMemberCard from '../components/ObMemberCard.astro';
import { OB_MEMBERS } from '../data/ob';
import { fetchLiveSnapshot } from '../lib/liveApi';
import { formatIso } from '../lib/format';

const snapshot = await fetchLiveSnapshot();
const liveOf = (m: (typeof OB_MEMBERS)[number]) => snapshot.statuses[`${m.platform}:${m.roomId}`];

const liveCount = OB_MEMBERS.filter((m) => liveOf(m)?.state === 'live' && !liveOf(m)?.ownerMismatch).length;
const staleRooms = OB_MEMBERS.filter((m) => liveOf(m)?.ownerMismatch);
---

<Layout
	title="OB 大家庭 · DOTA2 驿站"
	description="OB（Old Boys）成员的真实姓名、位置与荣誉，以及各人直播间与构建期开播状态快照。"
>
	<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
		<div class="mb-8">
			<p class="text-xs font-semibold uppercase tracking-[0.2em] text-dota-light">OB 大家庭</p>
			<h1 class="mt-2 font-display text-3xl sm:text-4xl">这群老将，就是情怀</h1>
			<p class="mt-3 max-w-3xl text-muted">
				OB（Old Boys）是国内 DOTA2 退役选手组成的娱乐团体，2014 年下半年建队，从最初的六人一路壮大。
				下面是各人的真实姓名、位置、荣誉、直播间与社区外号。
			</p>
		</div>

		<div class="mb-6 flex flex-wrap items-center gap-3 text-sm">
			<span class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-4 py-2">
				<span class="text-faint">成员</span>
				<span class="font-display text-cream">{OB_MEMBERS.length}</span>
			</span>
			<span class="inline-flex items-center gap-2 rounded-full border border-[#22c55e]/40 bg-[#22c55e]/10 px-4 py-2 text-[#4ade80]">
				<span class="h-2 w-2 animate-pulse rounded-full bg-[#22c55e]"></span>
				{liveCount} 位正在直播
			</span>
		</div>

		<p class="mb-8 rounded-xl border border-line bg-surface/60 px-4 py-3 text-xs leading-relaxed text-faint">
			开播状态抓取于 <span class="text-cream/80">{formatIso(snapshot.at)}</span>（东八区）。本站是静态站点，
			状态是<strong class="text-cream/80">构建那一刻的快照</strong>，之后的开播变化请以直播间页面为准；
			卡片上的「热度」是平台自定义指标，不等于真实观看人数。
			{
				staleRooms.length > 0 && (
					<span class="text-gold">
						本次构建检测到 {staleRooms.length} 个房间已注销或易主（
						{staleRooms.map((m) => `${m.name} ${m.roomId}`).join('、')}），已在其卡片上标注。
					</span>
				)
			}
		</p>

		<div class="grid grid-cols-1 gap-4 lg:grid-cols-2 xl:grid-cols-3">
			{OB_MEMBERS.map((m) => <ObMemberCard member={m} live={liveOf(m)} />)}
		</div>

		<section class="mt-12 rounded-2xl border border-line bg-surface p-6">
			<h2 class="font-display text-xl">这些信息从哪来</h2>
			<ul class="mt-4 space-y-3 text-sm leading-relaxed text-muted">
				<li>
					<span class="text-cream">名单与房间号：</span>
					十人名单以斗鱼官方签约通稿（2018-12-07，原文「OB 战队目前共有九人，分别为 YYF、Zhou、DD、龙神、820、宝哥、Hao、Mu、zsmj」）
					和 2019-06-13 OB 官博「十人全家福」（新增狗哥）为准；老陈是 OB 前身「龙宝川」三人组的成员，
					与 OB 一起活动多年，因此同样收录在本页。各人的本名、位置与荣誉取自上述官方资料。
				</li>
				<li>
					<span class="text-cream">外号与梗：</span>
					属于社区多年流传的内容，不是官方资料，仅供娱乐。涉及感情纠纷、赌博与私生活的一律没有收录。
				</li>
				<li>
					<span class="text-cream">开播状态：</span>
					构建期分别请求斗鱼与虎牙的房间接口，再用返回的房主昵称自查房间是否仍属于本人。
					本页面不显示观看人数，只显示平台自己的热度值；抓不到状态时显示「状态未知」，不做推测。
				</li>
				<li>
					<span class="text-cream">房间号会变：</span>
					主播转平台或换房间后，旧房间号可能被注销或由他人接手。页面上的「已注销 / 现房主为某某」就是这种情形的自动提示，
					并不代表名单本身有误。
				</li>
				<li>
					<span class="text-cream">待补充：</span>
					老陈的真名与房间号目前只有自媒体与录像聚合站来源，缺少官方出处；若你能提供更权威的资料，欢迎补充。
				</li>
			</ul>
		</section>
	</section>
</Layout>
