---
import Layout from '../../../layouts/Layout.astro';
import type { CommunityThread, ThreadDetail } from '../../../lib/ngaApi';
import { fetchCommunityThreads, fetchThreadDetail, ngaThreadUrl } from '../../../lib/ngaApi';
import { ngaProgress, renderNgaFloors } from '../../../lib/communityFloors';
import { renderNgaPost } from '../../../lib/ngaBbcode';
import { formatMatchTime } from '../../../lib/format';

interface Props {
	thread: CommunityThread;
}

export async function getStaticPaths() {
	const threads = await fetchCommunityThreads();
	return threads.map((thread) => ({ params: { tid: thread.tid }, props: { thread } }));
}

const { thread } = Astro.props;
// 时间格式化统一用 Unix 秒。
const now = Math.floor(Date.now() / 1000);
const detail: ThreadDetail | null = await fetchThreadDetail(thread.tid);

/*
 * 首屏把**这一页的楼层全摆出来**（NGA 每页 20 层，含主楼），不再只取前 10 层——
 * 想看更多的人在下面点「加载更多」，由 `/api/community/floors` 接着往回取。
 * 热评已在上面单独展示过的不重复。
 */
const hotPids = new Set((detail?.hotReplies ?? []).map((floor) => floor.pid));
const replies = (detail?.floors ?? []).filter((floor) => floor.floor > 0 && !hotPids.has(floor.pid));
/** 「还剩多少、下一跳是第几页」只有一处算术，见 `communityFloors.ts`。 */
const progress = detail ? ngaProgress(detail) : null;
const firstFloor = replies[0]?.floor ?? 0;
---

<Layout
	title={`${thread.title} · 社区 · DOTA2 驿站`}
	description={detail?.summary || thread.title}
	breadcrumbs={[{ name: '资讯', href: '/news/' }, { name: thread.title }]}
>
	<Fragment slot="head">
		<meta name="referrer" content="no-referrer" />
	</Fragment>
	<section class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
		<a href="/news/#nga" class="inline-flex items-center gap-1.5 text-sm text-muted transition hover:text-gold">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
			返回社区热帖
		</a>

		<header class="mt-5 border-b border-line pb-6">
			<div class="flex flex-wrap items-center gap-2 text-xs">
				<span class="rounded-md bg-dota/15 px-2 py-1 font-semibold text-dota-light">NGA 刀塔版块</span>
				<span class="text-faint">{formatMatchTime(thread.postedAt, now)}</span>
			</div>
			<h1 class="mt-3 font-display text-2xl leading-tight text-cream sm:text-3xl">{thread.title}</h1>
			<div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
				<span>楼主 {thread.author}</span>
				<span aria-hidden="true">·</span>
				<span>{thread.replies} 条回复</span>
				<span aria-hidden="true">·</span>
				<a href={ngaThreadUrl(thread.tid)} target="_blank" rel="noopener noreferrer" class="text-dota-light transition hover:text-gold">
					前往原帖 ↗
				</a>
			</div>
		</header>

		{
			detail?.content ? (
				<div class="nga-post mt-6 rounded-2xl border border-line bg-surface p-5 sm:p-8" set:html={renderNgaPost(detail.content)} />
			) : (
				<p class="mt-6 rounded-2xl border border-line bg-surface p-5 text-sm text-muted">
					正文抓取失败，稍后重新进入本页即可；也可以
					<a href={ngaThreadUrl(thread.tid)} target="_blank" rel="noopener noreferrer" class="text-dota-light hover:text-gold">前往原帖</a>
					阅读。
				</p>
			)
		}

		{
			detail && detail.hotReplies.length > 0 ? (
				<section class="mt-10">
					<h2 class="font-display text-lg text-cream">热门回复</h2>
					<ul class="mt-4 space-y-3" set:html={renderNgaFloors(detail, detail.hotReplies, now, { highlighted: true })} />
				</section>
			) : null
		}

		{
			replies.length > 0 ? (
				<section class="mt-10">
					<h2 class="font-display text-lg text-cream" data-floors-range data-first-floor={firstFloor}>
						回复 #{firstFloor} – #{replies[replies.length - 1].floor}
					</h2>
					<ul class="mt-4 space-y-3" data-floors-list set:html={renderNgaFloors(detail, replies, now)} />
				</section>
			) : null
		}

		{
			progress?.hasMore ? (
				<div class="mt-6 text-center text-sm text-faint" data-floors-more data-source="nga" data-id={thread.tid} data-next-page={progress.nextPage} data-remaining={progress.remaining}>
					<button
						type="button"
						class="rounded-md border border-line px-4 py-2 font-medium text-cream transition hover:border-dota hover:text-dota-light disabled:opacity-60"
						data-floors-more-button
					>
						加载更多回复（还有 {progress.remaining} 层）
					</button>
					<p class="mt-3" data-floors-more-note hidden></p>
					<p class="mt-3">
						也可以
						<a href={ngaThreadUrl(thread.tid)} target="_blank" rel="noopener noreferrer" class="text-dota-light hover:text-gold">
							前往原帖
						</a>
						看完整讨论。
					</p>
				</div>
			) : null
		}

		<p class="mt-10 text-center text-xs text-faint">
			NGA 对未登录访问隐藏了回复者昵称，站内只呈现正文与从引用中还原出的昵称。内容版权归 NGA 与原作者所有。
		</p>
	</section>

	<script>
		import '../../../scripts/communityMore';
	</script>
</Layout>
