---
import Layout from '../../../layouts/Layout.astro';
import type { HupuThread } from '../../../lib/hupuApi';
import { fetchHupuThreadDetail, fetchHupuThreads, hupuThreadUrl } from '../../../lib/hupuApi';
import { hupuProgress, renderHupuFloors } from '../../../lib/communityFloors';
import { formatCount, formatMatchTime } from '../../../lib/format';

interface Props {
	thread: HupuThread;
}

export async function getStaticPaths() {
	const threads = await fetchHupuThreads();
	return threads.map((thread) => ({ params: { pid: thread.pid }, props: { thread } }));
}

const { thread } = Astro.props;
// 时间格式化统一用 Unix 秒。
const now = Math.floor(Date.now() / 1000);
const detail = await fetchHupuThreadDetail(thread.pid);

/*
 * 亮评取前 10（接口给 50 条），楼层里已经在亮评中出现的去重。
 *
 * 楼层**不再只留 10 条**：虎扑自己每页就是 20 条，首屏把这 20 条（去重后）全摆出来，
 * 想看后面几页的点「加载更多」，由 `/api/community/floors` 接着取。
 */
const hot = (detail?.hotReplies ?? []).slice(0, 10);
const hotPids = new Set(hot.map((reply) => reply.pid));
const floors = (detail?.floors ?? []).filter((reply) => !hotPids.has(reply.pid));
/** 「还剩多少、下一跳是第几页」只有一处算术，见 `communityFloors.ts`。 */
const progress = detail ? hupuProgress(detail) : null;
/** 列表页的数字不如详情页权威，取得到就用详情页的。 */
const totalReplies = detail?.replies || thread.replies;
const createdAt = detail?.createdAt || thread.lastReplyAt;
---

<Layout
	title={`${thread.title} · 社区 · DOTA2 驿站`}
	description={detail?.summary || thread.title}
	breadcrumbs={[{ name: '资讯', href: '/news/' }, { name: thread.title }]}
>
	<Fragment slot="head">
		<meta name="referrer" content="no-referrer" />
	</Fragment>
	<section class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
		<a href="/news/#hupu" class="inline-flex items-center gap-1.5 text-sm text-muted transition hover:text-gold">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
			返回社区热帖
		</a>

		<header class="mt-5 border-b border-line pb-6">
			<div class="flex flex-wrap items-center gap-2 text-xs">
				<span class="rounded-md bg-dota/15 px-2 py-1 font-semibold text-dota-light">虎扑 DOTA2 区</span>
				<span class="text-faint">{formatMatchTime(createdAt, now)}</span>
				{detail?.location ? <span class="text-faint">· 发自 {detail.location}</span> : null}
			</div>
			<h1 class="mt-3 font-display text-2xl leading-tight text-cream sm:text-3xl">{thread.title}</h1>
			<div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
				<span>楼主 {thread.author}</span>
				<span aria-hidden="true">·</span>
				<span>{totalReplies} 条回复</span>
				{detail && detail.read > 0 ? <><span aria-hidden="true">·</span><span>{formatCount(detail.read)} 浏览</span></> : null}
				{detail && detail.lights > 0 ? <><span aria-hidden="true">·</span><span>{detail.lights} 亮</span></> : null}
				<span aria-hidden="true">·</span>
				<a href={hupuThreadUrl(thread.pid)} target="_blank" rel="noopener noreferrer" class="text-dota-light transition hover:text-gold">
					前往原帖 ↗
				</a>
			</div>
		</header>

		{
			detail?.content ? (
				<div class="hupu-post mt-6 rounded-2xl border border-line bg-surface p-5 sm:p-8" set:html={detail.content} />
			) : (
				<p class="mt-6 rounded-2xl border border-line bg-surface p-5 text-sm text-muted">
					正文抓取失败，稍后重新进入本页即可；也可以
					<a href={hupuThreadUrl(thread.pid)} target="_blank" rel="noopener noreferrer" class="text-dota-light hover:text-gold">前往原帖</a>
					阅读。
				</p>
			)
		}

		{
			hot.length > 0 ? (
				<section class="mt-10">
					<h2 class="font-display text-lg text-cream">亮评</h2>
					<ul class="mt-4 space-y-3" set:html={renderHupuFloors(hot, now, { highlighted: true })} />
				</section>
			) : null
		}

		{
			floors.length > 0 ? (
				<section class="mt-10">
					<h2 class="font-display text-lg text-cream">最新回复</h2>
					<ul class="mt-4 space-y-3" data-floors-list set:html={renderHupuFloors(floors, now)} />
				</section>
			) : null
		}

		{
			progress?.hasMore ? (
				<div class="mt-6 text-center text-sm text-faint" data-floors-more data-source="hupu" data-id={thread.pid} data-next-page={progress.nextPage} data-remaining={progress.remaining}>
					<button
						type="button"
						class="rounded-md border border-line px-4 py-2 font-medium text-cream transition hover:border-dota hover:text-dota-light disabled:opacity-60"
						data-floors-more-button
					>
						加载更多回复（还有 {progress.remaining} 条）
					</button>
					<p class="mt-3" data-floors-more-note hidden></p>
					<p class="mt-3">
						也可以
						<a href={hupuThreadUrl(thread.pid)} target="_blank" rel="noopener noreferrer" class="text-dota-light hover:text-gold">
							前往原帖
						</a>
						看完整讨论。
					</p>
				</div>
			) : null
		}

		<p class="mt-10 text-center text-xs text-faint">
			站内镜像主楼正文、亮评与回复，回复按虎扑自己的分页逐页展开（每页 20 条）。
			内容版权归虎扑与原作者所有。
		</p>
	</section>

	<script>
		import '../../../scripts/communityMore';
	</script>
</Layout>
