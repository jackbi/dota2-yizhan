---
import Layout from '../layouts/Layout.astro';
import PatchCard from '../components/PatchCard.astro';
import { PATCHES } from '../data/patches';
---

<Layout title="版本信息 · DOTA2 驿站" description="DOTA2 版本更新记录与后续版本前瞻。">
	<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
		<div class="mb-8">
			<p class="text-xs font-semibold uppercase tracking-[0.2em] text-dota-light">版本情报</p>
			<h1 class="mt-2 font-display text-3xl sm:text-4xl">版本与更新记录</h1>
			<p class="mt-3 max-w-2xl text-muted">追踪每次平衡性调整、大版本改动与未来更新前瞻，紧跟 meta 变化。</p>
		</div>

		<div class="relative space-y-6">
			<div class="absolute left-6 top-0 h-full w-px bg-line sm:left-7" aria-hidden="true"></div>
			{
				PATCHES.map((patch, i) => (
					<div class="relative pl-14 sm:pl-16">
						<span class:list={[
							'absolute left-0 top-5 flex h-12 w-12 items-center justify-center rounded-full border border-line bg-surface font-display text-xs sm:h-14 sm:w-14',
							i === 0 ? 'border-dota text-dota-light' : 'text-muted',
						]}>
							{patch.version}
						</span>
						<PatchCard patch={patch} />
					</div>
				))
			}
		</div>
	</section>
</Layout>
