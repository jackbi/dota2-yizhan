---
import Layout from '../layouts/Layout.astro';
import { fetchPatchUpdates, groupByMajor } from '../lib/patchesApi';

let updates: import('../lib/patchesApi').PatchUpdate[] = [];
let fetchFailed = false;
try {
	updates = await fetchPatchUpdates();
	if (!updates.length) fetchFailed = true;
} catch {
	fetchFailed = true;
}

// 8 年下来一百多个版本，摊平成时间线要滚十几屏；按大版本分组的粒度才和玩家的记忆对得上。
const groups = groupByMajor(updates);
const newest = updates[0];
const oldest = updates[updates.length - 1];
---

<Layout title="版本信息 · DOTA2 驿站" description="DOTA2 官方更新日志完整存档：从 7.08 到最新版本，每次平衡性调整按英雄与物品分类。">
	<Fragment slot="head">
		<meta name="referrer" content="no-referrer" />
	</Fragment>
	<section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
		<div class="mb-8 flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
			<div class="min-w-0">
				<p class="text-xs font-semibold uppercase tracking-[0.2em] text-dota-light">版本情报</p>
				<h1 class="mt-2 font-display text-3xl sm:text-4xl">版本与更新记录</h1>
				<p class="mt-3 max-w-2xl text-muted">
					官方更新日志的完整存档：每个版本的改动都按全局、物品、中立、英雄分好类，不用再翻外网。
				</p>
			</div>
			{
				updates.length > 0 ? (
					<p class="shrink-0 text-sm text-muted">
						<span class="font-display text-3xl text-gold">{updates.length}</span>
						<span class="ml-1.5">个版本</span>
						<span class="ml-3 font-mono text-xs text-faint">
							{oldest?.version} – {newest?.version}
						</span>
					</p>
				) : null
			}
		</div>

		{
			groups.length > 0 ? (
				<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
					{groups.map((group) => (
						<article class="rounded-2xl border border-line bg-surface p-4 transition hover:border-dota/40">
							<div class="flex items-baseline justify-between gap-3">
								<h2 class="font-display text-2xl text-gold">{group.major}</h2>
								<span class="text-xs text-faint">{group.items[0]?.date}</span>
							</div>
							<div class="mt-3 flex flex-wrap gap-1.5">
								{group.items.map((item) => (
									<a
										href={`/patches/${item.id}`}
										title={item.siteUrl ? `${item.version} 的日志在官方专题站上` : undefined}
										class={
											item.id === newest?.id
												? 'rounded-lg border border-dota/60 bg-dota/15 px-2.5 py-1 text-sm font-semibold text-dota-light transition hover:bg-dota/25'
												: 'rounded-lg border border-line bg-surface-2 px-2.5 py-1 text-sm text-cream transition hover:border-dota/50 hover:text-gold'
										}
									>
										{item.version}
										{item.siteUrl ? <span class="ml-1 text-[10px] text-faint">专题</span> : null}
									</a>
								))}
							</div>
						</article>
					))}
				</div>
			) : (
				<div class="rounded-2xl border border-line bg-surface px-6 py-16 text-center">
					<p class="text-muted">暂时取不到官方更新日志。</p>
					<p class="mt-2 text-xs text-faint">dota2.com 的数据接口不可用且本地没有缓存，下次构建会自动重试。</p>
				</div>
			)
		}

		{
			fetchFailed && updates.length > 0 ? (
				<p class="mt-10 text-center text-sm text-faint">
					本次未能刷新官网列表，以上为缓存内容。
				</p>
			) : null
		}
	</section>
</Layout>
