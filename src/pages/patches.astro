---
import Layout from '../layouts/Layout.astro';
import PatchCard from '../components/PatchCard.astro';
import { PATCHES } from '../data/patches';
import { fetchPatchUpdates } from '../lib/patchesApi';

let updates: import('../lib/patchesApi').PatchUpdate[] = [];
let fetchFailed = false;
try {
	updates = await fetchPatchUpdates(3);
	if (!updates.length) fetchFailed = true;
} catch {
	fetchFailed = true;
}
---

<Layout title="版本信息 · DOTA2 驿站" description="DOTA2 官方更新日志：追踪每次平衡性调整与大版本改动。">
	<Fragment slot="head">
		<meta name="referrer" content="no-referrer" />
	</Fragment>
	<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
		<div class="mb-8">
			<p class="text-xs font-semibold uppercase tracking-[0.2em] text-dota-light">版本情报</p>
			<h1 class="mt-2 font-display text-3xl sm:text-4xl">版本与更新记录</h1>
			<p class="mt-3 max-w-2xl text-muted">追踪每次平衡性调整、大版本改动与官方更新日志，紧跟 meta 变化。</p>
		</div>

		{
			updates.length > 0 ? (
				<ol class="relative space-y-6">
					<div class="absolute left-6 top-0 h-full w-px bg-line sm:left-7" aria-hidden="true"></div>
					{updates.map((update) => {
						const badge = update.version || update.date.slice(5);
						return (
							<li class="relative pl-14 sm:pl-16">
								<span class="absolute left-0 top-5 flex h-12 w-12 items-center justify-center rounded-full border border-line bg-surface font-display text-xs text-muted sm:h-14 sm:w-14">
									{badge}
								</span>
								<a
									href={`/patches/${update.id}`}
									class="group flex items-center gap-4 overflow-hidden rounded-2xl border border-line bg-surface p-4 transition hover:border-dota/50 hover:bg-surface-2"
								>
									{update.img ? (
										<img
											src={update.img}
											alt={update.title}
											loading="lazy"
											referrerpolicy="no-referrer"
											class="h-20 w-20 shrink-0 rounded-lg border border-line object-cover"
										/>
									) : (
										<span class="flex h-20 w-20 shrink-0 items-center justify-center rounded-lg bg-surface-2 font-display text-gold">
											{update.version || '更'}
										</span>
									)}
									<div class="min-w-0 flex-1">
										<div class="flex flex-wrap items-center gap-2">
											<span class="font-display text-xl text-gold">{update.version || '版本更新'}</span>
											<span class="rounded-md bg-dota/15 px-2 py-0.5 text-xs font-semibold text-dota-light">更新日志</span>
										</div>
										<h2 class="mt-1 truncate text-base font-medium text-cream">{update.title}</h2>
										<p class="mt-0.5 text-xs text-muted">{update.date}</p>
									</div>
									<svg class="h-5 w-5 shrink-0 text-faint transition group-hover:text-gold" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
										<path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								</a>
							</li>
						);
					})}
				</ol>
			) : (
				<div class="relative space-y-6">
					<div class="absolute left-6 top-0 h-full w-px bg-line sm:left-7" aria-hidden="true"></div>
					{PATCHES.map((patch, i) => (
						<div class="relative pl-14 sm:pl-16">
							<span
								class:list={[
									'absolute left-0 top-5 flex h-12 w-12 items-center justify-center rounded-full border border-line bg-surface font-display text-xs sm:h-14 sm:w-14',
									i === 0 ? 'border-dota text-dota-light' : 'text-muted',
								]}
							>
								{patch.version}
							</span>
							<PatchCard patch={patch} />
						</div>
					))}
				</div>
			)
		}

		{fetchFailed ? <p class="mt-10 text-center text-sm text-faint">官方更新日志暂不可用，以上为本地缓存数据。</p> : null}
	</section>
</Layout>
