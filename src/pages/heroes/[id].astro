---
import Layout from '../../layouts/Layout.astro';
import { fetchHeroList } from '../../lib/heroApi';

export async function getStaticPaths() {
	const list = await fetchHeroList();
	const order = ['STR', 'AGI', 'INT', 'UNI'];
	const sorted = [...list].sort((a, b) => order.indexOf(a.attr) - order.indexOf(b.attr) || a.name.localeCompare(b.name, 'zh'));
	return sorted.map((h, i) => {
		const prev = sorted[(i - 1 + sorted.length) % sorted.length];
		const next = sorted[(i + 1) % sorted.length];
		return {
			params: { id: String(h.id) },
			props: {
				id: h.id,
				name: h.name,
				nameEn: h.nameEn,
				prevId: prev.id,
				prevName: prev.name,
				nextId: next.id,
				nextName: next.name,
			},
		};
	});
}

const { id, name, nameEn, prevId, prevName, nextId, nextName } = Astro.props as {
	id: number;
	name: string;
	nameEn: string;
	prevId: number;
	prevName: string;
	nextId: number;
	nextName: string;
};
---

<Layout title={`${name} · 英雄资料 · DOTA2 驿站`} description={`${name}（${nameEn}）英雄详细数据与技能动画，实时来自官方接口。`}>
	<section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
		<nav class="mb-6 flex items-center gap-2 text-sm text-muted" aria-label="面包屑">
			<a href="/heroes" class="transition hover:text-dota-light">英雄资料</a>
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
			<span class="text-cream">{name}</span>
		</nav>

		<div id="hero-view" data-hero-id={id}>
			<!-- 骨架屏（加载完成后由脚本替换） -->
			<div class="overflow-hidden rounded-2xl border border-line bg-surface">
				<div class="grid grid-cols-1 lg:grid-cols-[1fr_360px]">
					<div class="space-y-4 p-8">
						<div class="h-9 w-48 animate-pulse rounded bg-surface-2"></div>
						<div class="h-4 w-64 animate-pulse rounded bg-surface-2"></div>
						<div class="h-24 w-full animate-pulse rounded bg-surface-2"></div>
					</div>
					<div class="h-[360px] animate-pulse bg-surface-2"></div>
				</div>
			</div>
		</div>

		<div id="hero-nav" class="mt-10 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-6">
			<a href={`/heroes/${prevId}`} class="flex items-center gap-2 rounded-lg border border-line px-4 py-2 text-sm transition hover:border-dota hover:text-dota-light">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path d="M19 12H5M11 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
				{prevName}
			</a>
			<a href={`/heroes/${nextId}`} class="flex items-center gap-2 rounded-lg border border-line px-4 py-2 text-sm transition hover:border-dota hover:text-dota-light">
				{nextName}
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</a>
		</div>
	</section>
</Layout>

<script>
	import { fetchHero, ATTRIBUTE_META, fmt } from '../../lib/heroApi';

	(() => {
		const view = document.getElementById('hero-view');
		if (!view) return;
		const id = view.dataset.heroId!;
		const esc = (s: string | null | undefined) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const mediaSources = (mp4: string, webm: string) => {
			const sources: string[] = [];
			if (webm) sources.push(`<source src="${esc(webm)}" type="video/webm">`);
			if (mp4) sources.push(`<source src="${esc(mp4)}" type="video/mp4">`);
			return sources.join('');
		};

		const renderError = () => {
			view.innerHTML = `
				<div class="rounded-2xl border border-line bg-surface p-10 text-center">
					<p class="text-muted">英雄数据加载失败，请检查网络后重试。</p>
					<button data-retry class="mt-4 rounded-lg bg-dota px-5 py-2.5 text-sm font-medium text-white transition hover:bg-dota-light">重新加载</button>
				</div>`;
			view.querySelector('[data-retry]')?.addEventListener('click', load);
		};

		const statTile = (label: string, value: string) =>
			`<div class="rounded-xl border border-line bg-surface p-4"><p class="text-xs text-faint">${label}</p><p class="mt-1 font-display text-lg text-cream">${value}</p></div>`;

		const load = async () => {
			try {
				const h = await fetchHero(id);
				const attr = ATTRIBUTE_META[h.attr];
				const s = h.stats;
				document.title = `${h.name} · 英雄资料 · DOTA2 驿站`;

				// 技能交互预览
				const skillTabs = h.abilities
					.map(
						(a, i) => `
						<button type="button" data-skill="${i}" class="skill-tab group flex items-center gap-3 rounded-xl border border-line bg-surface p-2 text-left transition" aria-selected="${i === 0}">
							<span class="flex h-12 w-12 shrink-0 overflow-hidden rounded-lg border border-line bg-surface-3">
								${a.img ? `<img src="${esc(a.img)}" alt="" referrerpolicy="no-referrer" loading="lazy" class="h-full w-full object-cover">` : `<span class="flex h-full w-full items-center justify-center font-display text-gold">${esc(a.nameLoc.slice(0, 1))}</span>`}
							</span>
							<span class="min-w-0">
								<span class="block truncate text-sm font-medium text-cream">${esc(a.nameLoc)}</span>
								<span class="block truncate text-xs text-faint">${a.isInborn ? '天生技能' : a.hasScepter || a.hasShard ? '含天赋升级' : '技能'}</span>
							</span>
						</button>`,
					)
					.join('');

				const first = h.abilities[0];
				const viewer = `
					<div class="overflow-hidden rounded-2xl border border-line bg-ink">
						<div class="relative aspect-video w-full bg-ink-2">
							${first?.videoWebm || first?.videoMp4 ? `
								<video id="ability-video" class="h-full w-full object-contain" autoplay muted loop playsinline preload="metadata" referrerpolicy="no-referrer" poster="${esc(first.img)}">${mediaSources(first.videoMp4, first.videoWebm)}</video>` : `
								<img src="${esc(first?.img)}" alt="${esc(first?.nameLoc)}" referrerpolicy="no-referrer" class="h-full w-full object-contain">`}
						</div>
						<div class="p-5">
							<h3 id="ability-name" class="font-display text-lg">${esc(first?.nameLoc ?? '')}</h3>
							<p id="ability-desc" class="mt-2 text-sm leading-relaxed text-muted">${esc(first?.desc ?? '')}</p>
							<div id="ability-tags" class="mt-3 flex flex-wrap gap-1.5">${first?.hasScepter ? '<span class="rounded bg-gold/15 px-2 py-0.5 text-xs text-gold">神杖升级</span>' : ''}${first?.hasShard ? '<span class="rounded bg-dota/15 px-2 py-0.5 text-xs text-dota-light">魔晶升级</span>' : ''}${first?.isInborn ? '<span class="rounded bg-zinc-600/15 px-2 py-0.5 text-xs text-zinc-400">天生技能</span>' : ''}</div>
						</div>
					</div>`;

				// 技能选择器：左侧列表 + 右侧动态预览
				const abilitiesBlock = h.abilities.length
					? `
						<h2 class="mb-4 font-display text-xl">技能动画</h2>
						<div class="grid grid-cols-1 gap-4 lg:grid-cols-[300px_1fr]">
							<div id="skill-list" class="flex flex-row gap-2 overflow-x-auto lg:flex-col" role="tablist" aria-label="技能列表">${skillTabs}</div>
							<div id="skill-viewer">${viewer}</div>
						</div>`
					: '';

				view.innerHTML = `
					<!-- 动态英雄展示 -->
					<div class="relative overflow-hidden rounded-2xl border border-line bg-ink">
						${h.topVideo ? `
							<video id="hero-top" class="h-[340px] w-full object-cover object-top sm:h-[420px]" autoplay muted loop playsinline preload="metadata" referrerpolicy="no-referrer" poster="${esc(h.img)}">${mediaSources('', h.topVideo)}</video>` : `
							<img src="${esc(h.img)}" alt="${esc(h.name)}" referrerpolicy="no-referrer" class="h-[340px] w-full object-cover object-top sm:h-[420px]">`}
						<div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/20 to-transparent" aria-hidden="true"></div>
						<div class="absolute inset-x-0 bottom-0 p-6 sm:p-8">
							<div class="flex flex-wrap items-end gap-x-4 gap-y-2">
								<h1 class="font-display text-4xl sm:text-5xl">${esc(h.name)}</h1>
								<span class="pb-1.5 text-lg text-muted">${esc(h.nameEn)}</span>
							</div>
							<div class="mt-3 flex flex-wrap gap-2">
								<span class="inline-flex items-center gap-1.5 rounded-md px-2.5 py-1 text-sm font-semibold" style="background:${attr.color}22;color:${attr.color}"><span style="color:${attr.color}">●</span> ${attr.label}</span>
								<span class="rounded-md bg-ink/60 px-2.5 py-1 text-sm backdrop-blur">${h.attack === 'melee' ? '近战' : '远程'}</span>
								<span class="rounded-md bg-ink/60 px-2.5 py-1 text-sm backdrop-blur">复杂度 ${'●'.repeat(h.complexity)}</span>
							</div>
							${h.roles.length ? `<div class="mt-3 flex flex-wrap gap-1.5">${h.roles.map((r) => `<span class="rounded bg-ink/60 px-2.5 py-1 text-sm text-gold backdrop-blur">${esc(r.label)}</span>`).join('')}</div>` : ''}
						</div>
					</div>

					<!-- 定位与背景 -->
					<div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
						<div class="rounded-2xl border border-line bg-surface p-6">
							<h2 class="font-display text-lg text-gold">英雄定位</h2>
							<p class="mt-2 leading-relaxed text-muted">${esc(h.hype)}</p>
						</div>
						<div class="rounded-2xl border border-line bg-surface p-6">
							<h2 class="font-display text-lg text-gold">背景故事</h2>
							<p class="mt-2 whitespace-pre-line leading-relaxed text-cream/90">${esc(h.bio)}</p>
						</div>
					</div>

					<div class="mt-10">${abilitiesBlock}</div>

					<h2 class="mt-10 mb-4 font-display text-xl">基础数值</h2>
					<div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
						${statTile('生命值', fmt(s.maxHealth))}
						${statTile('生命回复', fmt(s.healthRegen, 1))}
						${statTile('魔法值', fmt(s.maxMana))}
						${statTile('魔法回复', fmt(s.manaRegen, 1))}
						${statTile('护甲', fmt(s.armor, 1))}
						${statTile('魔抗', fmt(s.magicResistance) + '%')}
						${statTile('攻击力', fmt(s.damageMin) + ' - ' + fmt(s.damageMax))}
						${statTile('攻击间隔', fmt(s.attackRate, 2) + 's')}
						${statTile('攻击距离', fmt(s.attackRange))}
						${statTile('移动速度', fmt(s.moveSpeed))}
						${statTile('白天视野', fmt(s.sightDay))}
						${statTile('夜晚视野', fmt(s.sightNight))}
					</div>

					<h2 class="mt-10 mb-4 font-display text-xl">属性成长</h2>
					<div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
						${[
							['力量', s.strBase, s.strGain, '#C0392B'],
							['敏捷', s.agiBase, s.agiGain, '#2E8B57'],
							['智力', s.intBase, s.intGain, '#2980B9'],
						]
							.map(([label, base, gain, color]) => {
								const w = Math.min(100, ((Number(gain) as number) / 5) * 100);
								return `<div class="rounded-xl border border-line bg-surface p-4">
									<div class="flex items-center justify-between"><p class="text-sm" style="color:${color}">${label}</p><p class="font-display text-lg text-cream">${base} +${Number(gain).toFixed(1)}</p></div>
									<div class="mt-3 h-2 overflow-hidden rounded-full bg-surface-3"><div class="h-full rounded-full" style="width:${w}%;background:${color}"></div></div>
								</div>`;
							})
							.join('')}
					</div>`;

				// 技能交互
				const skillList = document.getElementById('skill-list');
				const viewerEl = document.getElementById('skill-viewer');
				const heroTop = document.getElementById('hero-top') as HTMLVideoElement | null;
				if (heroTop && reducedMotion) heroTop.removeAttribute('autoplay');

				const setSkill = (i: number) => {
					const a = h.abilities[i];
					if (!a) return;
					skillList?.querySelectorAll('.skill-tab').forEach((b, idx) => b.setAttribute('aria-selected', String(idx === i)));
					if (viewerEl) {
						const hasVideo = Boolean(a.videoWebm || a.videoMp4);
						viewerEl.innerHTML = `
							<div class="overflow-hidden rounded-2xl border border-line bg-ink">
								<div class="relative aspect-video w-full bg-ink-2">
									${hasVideo ? `<video class="ability-video h-full w-full object-contain" autoplay muted loop playsinline preload="metadata" referrerpolicy="no-referrer" poster="${esc(a.img)}">${mediaSources(a.videoMp4, a.videoWebm)}</video>` : `<img src="${esc(a.img)}" alt="${esc(a.nameLoc)}" referrerpolicy="no-referrer" class="h-full w-full object-contain">`}
								</div>
								<div class="p-5">
									<h3 class="font-display text-lg">${esc(a.nameLoc)}</h3>
									<p class="mt-2 text-sm leading-relaxed text-muted">${esc(a.desc)}</p>
									<div class="mt-3 flex flex-wrap gap-1.5">${a.hasScepter ? '<span class="rounded bg-gold/15 px-2 py-0.5 text-xs text-gold">神杖升级</span>' : ''}${a.hasShard ? '<span class="rounded bg-dota/15 px-2 py-0.5 text-xs text-dota-light">魔晶升级</span>' : ''}${a.isInborn ? '<span class="rounded bg-zinc-600/15 px-2 py-0.5 text-xs text-zinc-400">天生技能</span>' : ''}</div>
								</div>
							</div>`;
					}
				};

				skillList?.querySelectorAll('.skill-tab').forEach((btn) => {
					btn.addEventListener('click', () => setSkill(Number((btn as HTMLElement).dataset.skill)));
				});
			} catch (e) {
				console.error(e);
				renderError();
			}
		};

		load();
	})();
</script>
