---
import Layout from '../../layouts/Layout.astro';
import { formatIso } from '../../lib/format';
import { fetchHeroListCached } from '../../lib/heroList';
import { fetchHeroMeta, stratzConfigured } from '../../lib/stratzApi';
import { heroPatchIndex } from '../../lib/patchHeroes';

export async function getStaticPaths() {
	// 走带缓存的这层：这一份直接决定 127 个英雄页生不生成，裸 fetch 一失败整轮构建就中止。
	const list = await fetchHeroListCached();
	const order = ['STR', 'AGI', 'INT', 'UNI'];
	const sorted = [...list].sort((a, b) => order.indexOf(a.attr) - order.indexOf(b.attr) || a.name.localeCompare(b.name, 'zh'));
	return sorted.map((h, i) => {
		const prev = sorted[(i - 1 + sorted.length) % sorted.length];
		const next = sorted[(i + 1) % sorted.length];
		return {
			params: { id: String(h.id) },
			props: {
				id: h.id,
				name: h.name,
				nameEn: h.nameEn,
				prevId: prev.id,
				prevName: prev.name,
				nextId: next.id,
				nextName: next.name,
			},
		};
	});
}

const { id, name, nameEn, prevId, prevName, nextId, nextName } = Astro.props as {
	id: number;
	name: string;
	nameEn: string;
	prevId: number;
	prevName: string;
	nextId: number;
	nextName: string;
};

/** 近一周数据在构建期取一次，所有英雄页共用；取不到就整块不展示。 */
const meta = await fetchHeroMeta();

/*
 * 「这个英雄最近被改过没有」——玩家查英雄时最想知道的一件事，顺带把英雄页与版本页连起来。
 * 取不到（离线构建、上游挂了）就整块不展示，不留空标题。
 */
const heroPatches = (await heroPatchIndex()).get(id) ?? [];
const stat = meta?.heroes.get(id) ?? null;
/** 配了 token 却拿不到数据 = 抓取故障，明确说出来而不是静默留白。 */
const metaUnavailable = meta === null && stratzConfigured();
const winRate = stat && stat.matches > 0 ? (stat.wins / stat.matches) * 100 : 0;
const POSITION_LABEL = ['一号位', '二号位', '三号位', '四号位', '五号位'];
const POSITION_HINT: Record<number, string> = { 1: '优势路核心', 2: '中路', 3: '劣势路', 4: '游走辅助', 5: '保护辅助' };
---

<Layout
	title={`${name} · 英雄资料 · DOTA2 驿站`}
	description={`${name}（${nameEn}）英雄详细数据、技能动画与天赋树，实时来自官方接口。`}
	breadcrumbs={[{ name: '英雄', href: '/heroes' }, { name }]}
>
	<Fragment slot="head">
		<meta name="referrer" content="no-referrer" />
	</Fragment>
	<section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
		<nav class="mb-6 flex items-center gap-2 text-sm text-muted" aria-label="面包屑">
			<a href="/heroes" class="transition hover:text-dota-light">英雄资料</a>
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
			<span class="text-cream">{name}</span>
		</nav>

		{/*
			攻略的出口放在最上面：这是"我想知道这英雄现在怎么打"最直接的答案，
			而下面那些数值（属性、技能、天赋树）回答的是"这英雄是什么"。
		*/}
		<div class="mb-6">
			<a
				href={`/heroes/${id}/guides`}
				class="inline-flex items-center gap-2.5 rounded-lg border border-line bg-surface px-4 py-2 text-sm text-cream transition hover:border-dota/60 hover:bg-surface-2"
			>
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="text-dota-light">
					<path d="M4 6h16M4 12h16M4 18h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
				</svg>
				高手攻略
				<span class="text-xs text-faint">高分对局的加点与出装</span>
			</a>
		</div>

		{
			metaUnavailable ? (
				<p class="mb-6 rounded-2xl border border-line bg-surface/60 px-5 py-4 text-sm text-muted">
					本次构建没有取到近一周数据，下方为官方接口的英雄数值。
				</p>
			) : null
		}

		{
			meta && stat ? (
				<section class="mb-6 rounded-2xl border border-line bg-surface p-5" aria-label="近一周数据">
					<div class="flex flex-wrap items-baseline justify-between gap-2">
						<h2 class="font-display text-lg">近 {meta.windowDays} 天数据</h2>
						<p class="text-xs text-faint">{meta.bracketLabel} · 更新于 {formatIso(meta.updatedAt)} · 数据来自 STRATZ</p>
					</div>
					<dl class="mt-4 grid grid-cols-3 gap-3">
						<div class="rounded-xl border border-line bg-surface-2 px-4 py-3">
							<dt class="text-xs text-faint">出场</dt>
							<dd class="mt-1 font-display text-xl tabular-nums">{stat.matches.toLocaleString('zh-CN')}</dd>
						</div>
						<div class="rounded-xl border border-line bg-surface-2 px-4 py-3">
							<dt class="text-xs text-faint">胜率</dt>
							<dd class={`mt-1 font-display text-xl tabular-nums ${winRate >= 50 ? 'text-gold' : 'text-cream'}`}>{winRate.toFixed(1)}%</dd>
						</div>
						<div class="rounded-xl border border-line bg-surface-2 px-4 py-3">
							<dt class="text-xs text-faint">被禁用</dt>
							<dd class="mt-1 font-display text-xl tabular-nums">{stat.bans.toLocaleString('zh-CN')}</dd>
						</div>
					</dl>
					{
						stat.positions.length > 0 ? (
							<div class="mt-4">
								<p class="text-xs text-faint">按位置的出场与胜率</p>
								<ul class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-5">
									{stat.positions
										.filter((position) => position.matches > 0)
										.map((position) => (
											<li class="rounded-xl border border-line bg-surface-2 px-3 py-2" title={POSITION_HINT[position.position]}>
												<p class="text-xs text-muted">{POSITION_LABEL[position.position - 1]}</p>
												<p class="mt-0.5 text-sm tabular-nums text-cream">
													{position.matches.toLocaleString('zh-CN')} 场
													<span class="ml-1 text-xs text-faint">{(position.wins / position.matches * 100).toFixed(1)}%</span>
												</p>
											</li>
										))}
								</ul>
							</div>
						) : null
					}
				</section>
			) : null
		}

		<div id="hero-view" data-hero-id={id}>
			<!-- 骨架屏（加载完成后由脚本替换） -->
			<div class="overflow-hidden rounded-2xl border border-line bg-surface">
				<div class="grid grid-cols-1 lg:grid-cols-[1fr_360px]">
					<div class="space-y-4 p-8">
						<div class="h-9 w-48 animate-pulse rounded bg-surface-2"></div>
						<div class="h-4 w-64 animate-pulse rounded bg-surface-2"></div>
						<div class="h-24 w-full animate-pulse rounded bg-surface-2"></div>
					</div>
					<div class="h-[360px] animate-pulse bg-surface-2"></div>
				</div>
			</div>
		</div>

		{/*
			版本改动记录：英雄页 → 版本页的出口。只列被改到过这个英雄的版本，
			每条点进去是那一版的完整日志（版本页那边再把英雄名链回这里）。
		*/}
		{
			heroPatches.length > 0 ? (
				<section class="mt-10 border-t border-line pt-6" aria-labelledby="hero-patches-title">
					<h2 id="hero-patches-title" class="font-display text-xl">
						版本改动记录
					</h2>
					<p class="mt-2 text-sm text-muted">
						这个英雄在最近 {heroPatches.length} 个版本里被调整过（新 → 旧）。
					</p>
					<ul class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2">
						{heroPatches.slice(0, 12).map((patch) => (
							<li>
								<a
									href={`/patches/${patch.id}`}
									class="flex items-baseline gap-3 rounded-lg border border-line bg-surface/40 px-3 py-2 text-sm transition hover:border-dota/60 hover:bg-surface-2/60"
								>
									<span class="shrink-0 font-display text-gold">{patch.version}</span>
									<span class="shrink-0 text-xs text-faint tabular-nums">{patch.date}</span>
									<span class="truncate text-muted">{patch.summary}</span>
								</a>
							</li>
						))}
					</ul>
					{heroPatches.length > 12 ? (
						<p class="mt-3 text-xs text-faint">
							只列最近 12 个版本，全部改动见 <a href="/patches" class="text-dota-light hover:text-cream">版本信息</a>。
						</p>
					) : null}
				</section>
			) : null
		}

		<div id="hero-nav" class="mt-10 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-6">
			<a href={`/heroes/${prevId}`} class="flex items-center gap-2 rounded-lg border border-line px-4 py-2 text-sm transition hover:border-dota hover:text-dota-light">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path d="M19 12H5M11 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
				{prevName}
			</a>
			<a href={`/heroes/${nextId}`} class="flex items-center gap-2 rounded-lg border border-line px-4 py-2 text-sm transition hover:border-dota hover:text-dota-light">
				{nextName}
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</a>
		</div>
	</section>
</Layout>

<script>
	import { fetchHero, ATTRIBUTE_META, fmt, resolveTemplate, HERO_TALENT_OVERRIDE } from '../../lib/heroApi';

	(() => {
		const view = document.getElementById('hero-view');
		if (!view) return;
		const id = view.dataset.heroId!;
		const esc = (s: string | null | undefined) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

		// 使用单一 src（而非 <source>），确保 video 的 referrerpolicy 真正作用到资源请求
		const mediaSrc = (mp4: string, webm: string) => mp4 || webm;

		// 视频通过 innerHTML 注入后不会自动触发 autoplay，需显式触发播放。
		// 在 load() 完成前调用 play() 可能时机过早，因此监听 canplay/loadeddata 再播；
		// 若被浏览器自动播放策略拦截（NotAllowedError），则等首次用户交互后再补播。
		const playMedia = (root: ParentNode) => {
			root.querySelectorAll('video').forEach((v) => {
				const vid = v as HTMLVideoElement;
				vid.muted = true;
				vid.defaultMuted = true;
				vid.playsInline = true;
				vid.loop = true;
				vid.autoplay = true;
				vid.preload = 'auto';
				const tryPlay = () => {
					const p = vid.play();
					if (p) {
						p.catch((err) => {
							if (err?.name === 'NotAllowedError') {
								const once = () => vid.play().catch(() => {});
								['pointerdown', 'touchstart', 'keydown'].forEach((ev) =>
									document.addEventListener(ev, once, { once: true, capture: true }),
								);
							}
						});
					}
				};
				vid.addEventListener('canplay', tryPlay);
				vid.addEventListener('loadeddata', tryPlay);
				tryPlay();
			});
		};

		const renderError = () => {
			view.innerHTML = `
				<div class="rounded-2xl border border-line bg-surface p-10 text-center">
					<p class="text-muted">英雄数据加载失败，请检查网络后重试。</p>
					<button data-retry class="mt-4 rounded-lg bg-dota px-5 py-2.5 text-sm font-medium text-white transition hover:bg-dota-dark">重新加载</button>
				</div>`;
			view.querySelector('[data-retry]')?.addEventListener('click', load);
		};

		const load = async () => {
			try {
				const h = await fetchHero(id);
				const attr = ATTRIBUTE_META[h.attr];
				const s = h.stats;
				document.title = `${h.name} · 英雄资料 · DOTA2 驿站`;

				// ---- 官方 DetailsBar 用的三类小图标 ----
				const heroStatic = (p: string) => `https://www.dota2.com.cn/herostatic/${p}`;
				const attrIcon = (k: string) => heroStatic(`icons/hero_${k}.png`);
				const statIcon = (k: string) => heroStatic(`stats/icon_${k}.png`);
				const ATTR_NAMES: Record<string, string> = { strength: '力量', agility: '敏捷', intelligence: '智力' };
				const STAT_NAMES: Record<string, string> = {
					damage: '攻击力',
					attack_time: '攻击间隔',
					attack_range: '攻击距离',
					projectile_speed: '投射物速度',
					armor: '护甲',
					magic_resist: '魔法抗性',
					movement_speed: '移动速度',
					turn_rate: '转身速率',
					vision: '视野范围',
				};
				const attrRow = (k: string, base: number, gain: number) =>
					`<div class="flex items-center gap-2.5">
						<img src="${attrIcon(k)}" alt="" aria-hidden="true" referrerpolicy="no-referrer" loading="lazy" class="h-5 w-5 opacity-90">
						<span class="w-8 shrink-0 text-xs text-muted">${ATTR_NAMES[k]}</span>
						<span class="min-w-[2ch] font-display text-base text-cream tabular-nums">${base}</span>
						<span class="font-display text-xs text-emerald-400 tabular-nums">+${Number(gain).toFixed(1)}</span>
					</div>`;
				const statRow = (k: string, text: string) =>
					`<div class="flex items-center justify-between gap-3 py-0.5" title="${STAT_NAMES[k]}">
						<span class="flex items-center gap-2 text-xs text-muted">
							<img src="${statIcon(k)}" alt="" aria-hidden="true" referrerpolicy="no-referrer" loading="lazy" class="h-4 w-4 opacity-80">
							${STAT_NAMES[k]}
						</span>
						<span class="font-display text-sm text-cream tabular-nums">${text}</span>
					</div>`;
				const roleRow = (level: number, label: string) => {
					const w = (Math.min(3, level) / 3) * 100;
					return `<div class="flex items-center gap-3">
						<span class="w-11 shrink-0 text-xs text-muted">${esc(label)}</span>
						<div class="h-1.5 flex-1 overflow-hidden rounded-full bg-surface-3">
							<div class="h-full rounded-full bg-gradient-to-r from-dota to-dota-light transition-all" style="width:${w}%"></div>
						</div>
						<span class="hidden w-7 shrink-0 text-right text-[11px] text-gold/80 sm:inline" aria-hidden="true">${level ? '★'.repeat(level) : '—'}</span>
					</div>`;
				};

				// ---- 技能数据（含升级版） ----
				type Variant = 'base' | 'shard' | 'scepter';
				const variantOf = (a: any, v: Variant) =>
					v === 'shard'
						? { mp4: a.shardMp4, webm: a.shardWebm, poster: a.shardPoster, label: '魔晶升级' }
						: v === 'scepter'
							? { mp4: a.scepterMp4, webm: a.scepterWebm, poster: a.scepterPoster, label: '神杖升级' }
							: { mp4: a.videoMp4, webm: a.videoWebm, poster: a.videoPoster, label: '基础' };

				const skillTabs = h.abilities
					.map(
						(a, i) => `
						<button type="button" data-skill="${i}" class="skill-tab flex w-60 shrink-0 items-center gap-3 rounded-xl border border-line bg-surface p-2 text-left transition lg:w-full" aria-selected="${i === 0}">
							<span class="flex h-12 w-12 shrink-0 overflow-hidden rounded-lg border border-line bg-surface-3">
								${a.img ? `<img src="${esc(a.img)}" alt="" referrerpolicy="no-referrer" loading="lazy" class="h-full w-full object-cover">` : `<span class="flex h-full w-full items-center justify-center font-display text-gold">${esc(a.nameLoc.slice(0, 1))}</span>`}
							</span>
							<span class="min-w-0 flex-1">
								<span class="block truncate text-sm font-medium text-cream">${esc(a.nameLoc)}</span>
								<span class="block truncate text-xs text-faint">${a.isInborn ? '先天技能' : (a.hasScepter || a.hasShard) ? '含升级效果' : '技能'}</span>
							</span>
						</button>`,
					)
					.join('');

				const videoBlock = (a: any, v: Variant) => {
					const media = variantOf(a, v);
					const hasVideo = Boolean(media.mp4 || media.webm);
					return `<div class="relative aspect-video w-full bg-ink-2">
						${hasVideo ? `<video class="h-full w-full object-contain" autoplay muted loop playsinline preload="auto" referrerpolicy="no-referrer" poster="${esc(media.poster)}" src="${esc(mediaSrc(media.mp4, media.webm))}"></video>` : `<img src="${esc(media.poster)}" alt="${esc(a.nameLoc)}" referrerpolicy="no-referrer" class="h-full w-full object-contain">`}
					</div>`;
				};

				const viewerBody = (a: any, v: Variant) => {
					const media = variantOf(a, v);
					const variants = ['base', ...(a.hasShard ? ['shard'] : []), ...(a.hasScepter ? ['scepter'] : [])];
					const btns = variants.length > 1
						? `<div class="mt-4 flex flex-wrap gap-2">${variants.map((x) => `<button type="button" data-variant="${x}" class="variant-btn rounded-md px-3 py-1.5 text-xs font-medium transition" aria-pressed="${x === v}">${variantOf(a, x as Variant).label}</button>`).join('')}</div>`
						: '';
					return `
						<div class="overflow-hidden rounded-2xl border border-line bg-ink">
							${videoBlock(a, v)}
							<div class="p-5">
								<h3 class="font-display text-lg">${esc(a.nameLoc)}</h3>
								<p class="mt-2 text-sm leading-relaxed text-muted">${esc(a.desc)}</p>
								<div class="mt-3 flex flex-wrap gap-1.5">${a.isInborn ? '<span class="rounded bg-zinc-600/15 px-2 py-0.5 text-xs text-zinc-400">先天技能</span>' : ''}${a.hasScepter ? '<span class="rounded bg-gold/15 px-2 py-0.5 text-xs text-gold">神杖升级</span>' : ''}${a.hasShard ? '<span class="rounded bg-dota/15 px-2 py-0.5 text-xs text-dota-light">魔晶升级</span>' : ''}</div>
								${btns}
							</div>
						</div>`;
				};

				// ---- 天赋树（官方结构：图标 + 标题 + 左/等级/右，顺序 25→10）----
				const over = HERO_TALENT_OVERRIDE[h.id];
				const talentRow = (level: number, left: string, right: string) => `
					<div class="flex items-center gap-2 sm:gap-3">
						<div class="flex-1 rounded-xl border border-line bg-surface-2 px-3 py-2.5 text-sm text-cream sm:px-4 sm:py-3">${esc(left)}</div>
						<div class="flex h-9 w-12 shrink-0 items-center justify-center rounded-md bg-dota/15 font-display text-gold sm:h-10 sm:w-14">${level}</div>
						<div class="flex-1 rounded-xl border border-line bg-surface-2 px-3 py-2.5 text-sm text-cream sm:px-4 sm:py-3">${esc(right)}</div>
					</div>`;
				let talentBlock = '';
				if (over) {
					talentBlock = `	<h2 class="mt-10 mb-4 font-display text-xl">天赋树</h2>
						<div class="rounded-2xl border border-line bg-surface p-5 sm:p-6">
							<div class="mb-5 flex items-center gap-3">
								${over.attackIcon ? `<img src="${esc(over.attackIcon)}" alt="" referrerpolicy="no-referrer" width="36" height="36" class="h-9 w-9">` : ''}
								<span class="font-display text-lg text-cream">天赋树</span>
							</div>
							<div class="space-y-2">${over.levels.map((t) => talentRow(t.level, t.left, t.right)).join('')}</div>
						</div>`;
				} else if (h.talents.length) {
					const rows: { level: number; left: string; right: string }[] = [];
					for (let i = 0; i < h.talents.length; i += 2) {
						const level = (i / 2 + 1) * 5 + 5;
						const a = h.talents[i];
						const b = h.talents[i + 1] || { name: '', desc: '' };
						rows.push({ level, left: resolveTemplate(a.name, h.specialMap, a.key), right: resolveTemplate(b.name, h.specialMap, b.key) });
					}
					rows.reverse();
					talentBlock = `	<h2 class="mt-10 mb-4 font-display text-xl">天赋树</h2>
						<div class="rounded-2xl border border-line bg-surface p-5 sm:p-6">
							<div class="mb-5 flex items-center gap-3">
								<span class="font-display text-lg text-cream">天赋树</span>
								<span class="text-xs text-faint">部分数值官方未公开</span>
							</div>
							<div class="space-y-2">${rows.map((t) => talentRow(t.level, t.left, t.right)).join('')}</div>
						</div>`;
				}

				const abilitiesBlock = h.abilities.length
					? `	<h2 class="mt-10 mb-4 font-display text-xl">技能动画</h2>
						<div class="grid grid-cols-1 gap-4 lg:grid-cols-[300px_1fr]">
							<div id="skill-list" class="flex flex-row gap-2 overflow-x-auto lg:flex-col" role="tablist" aria-label="技能列表">${skillTabs}</div>
							<div id="skill-viewer">${viewerBody(h.abilities[0], 'base')}</div>
						</div>`
					: '';

				view.innerHTML = `
					<!-- 动态英雄展示 -->
					<div class="relative overflow-hidden rounded-3xl border border-line bg-ink-2">
						<div class="relative h-[420px] sm:h-[540px] lg:h-[640px]">
							${h.topVideo ? `
								<video id="hero-top" class="absolute inset-0 h-full w-full object-contain object-center" autoplay muted loop playsinline preload="auto" referrerpolicy="no-referrer" poster="${esc(h.topImg || h.img)}" src="${esc(h.topVideo)}"></video>` : `
								<img src="${esc(h.img)}" alt="${esc(h.name)}" referrerpolicy="no-referrer" class="absolute inset-0 h-full w-full object-contain object-center">`}
							<div class="pointer-events-none absolute inset-0 bg-[radial-gradient(60%_50%_at_50%_45%,rgba(198,82,44,0.18),transparent_70%)]" aria-hidden="true"></div>
							<div class="pointer-events-none absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-ink via-ink/40 to-transparent" aria-hidden="true"></div>
						</div>
						<div class="absolute inset-x-0 bottom-0 p-6 sm:p-8">
							<div class="flex flex-wrap items-end gap-x-4 gap-y-2">
								<h1 class="font-display text-4xl sm:text-5xl">${esc(h.name)}</h1>
								<span class="pb-1.5 text-lg text-muted">${esc(h.nameEn)}</span>
							</div>
							<div class="mt-3 flex flex-wrap gap-2">
								<span class="inline-flex items-center gap-1.5 rounded-md px-2.5 py-1 text-sm font-semibold" style="background:${attr.color}22;color:${attr.color}"><span style="color:${attr.color}">●</span> ${attr.label}</span>
								<span class="rounded-md bg-ink/60 px-2.5 py-1 text-sm backdrop-blur">${h.attack === 'melee' ? '近战' : '远程'}</span>
								<span class="rounded-md bg-ink/60 px-2.5 py-1 text-sm backdrop-blur">复杂度 ${'●'.repeat(h.complexity)}</span>
							</div>
							${h.roles.length ? `<div class="mt-3 flex flex-wrap gap-1.5">${h.roles.map((r) => `<span class="rounded bg-ink/60 px-2.5 py-1 text-sm text-gold backdrop-blur">${esc(r.label)}</span>`).join('')}</div>` : ''}
						</div>
					</div>

					<!-- 定位与背景 -->
					<div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
						<div class="rounded-2xl border border-line bg-surface p-6">
							<h2 class="font-display text-lg text-gold">英雄定位</h2>
							<p class="mt-2 leading-relaxed text-muted">${esc(h.hype)}</p>
						</div>
						<div class="rounded-2xl border border-line bg-surface p-6">
							<h2 class="font-display text-lg text-gold">背景故事</h2>
							<p class="mt-2 whitespace-pre-line leading-relaxed text-cream/90">${esc(h.bio)}</p>
						</div>
					</div>

					<div class="mt-10">${abilitiesBlock}</div>
			<div class="mt-10">${talentBlock}</div>

			<!-- 官方 DetailsBar 风格：属性 / 定位 / 数值 三段 -->
				<div class="mt-10 overflow-hidden rounded-2xl border border-line bg-gradient-to-r from-[#252728] to-[#101415] shadow-[0_10px_30px_rgba(0,0,0,0.45)]">
					<div class="flex flex-col gap-8 px-5 py-8 sm:px-8 lg:flex-row lg:items-stretch lg:gap-0 lg:px-10">
						<!-- 属性 -->
						<section class="flex flex-col lg:w-[340px] lg:shrink-0" aria-label="英雄属性">
							<h3 class="mb-5 flex items-center gap-3 text-xs font-semibold tracking-widest text-gold"><span class="h-px flex-1 bg-gradient-to-r from-gold/40 to-transparent"></span><span class="shrink-0">属性</span><span class="h-px flex-1 bg-gradient-to-l from-gold/40 to-transparent"></span></h3>
							<div class="flex items-center justify-center gap-6">
								<div class="flex flex-col items-center gap-2">
									<div class="overflow-hidden rounded-xl border border-line bg-ink-2 shadow-[inset_0_1px_0_rgba(255,255,255,0.06)]">
										<img src="${esc(h.img)}" alt="${esc(h.name)}" referrerpolicy="no-referrer" loading="lazy" class="h-32 w-32 object-cover">
									</div>
									<div class="w-32 space-y-1.5">
										<div class="flex items-center gap-2">
											<div class="h-1.5 flex-1 overflow-hidden rounded-full bg-ink"><div class="h-full w-full bg-[#C0392B]"></div></div>
											<span class="font-display text-sm text-cream tabular-nums">${fmt(s.maxHealth)}</span>
										</div>
										<p class="text-right text-[11px] leading-none text-muted tabular-nums">生命 +${fmt(s.healthRegen, 1)}</p>
										<div class="flex items-center gap-2">
											<div class="h-1.5 flex-1 overflow-hidden rounded-full bg-ink"><div class="h-full w-full bg-[#2980B9]"></div></div>
											<span class="font-display text-sm text-cream tabular-nums">${fmt(s.maxMana)}</span>
										</div>
										<p class="text-right text-[11px] leading-none text-muted tabular-nums">魔法 +${fmt(s.manaRegen, 1)}</p>
									</div>
								</div>
								<div class="flex flex-col justify-center gap-3">
									${attrRow('strength', s.strBase, s.strGain)}
									${attrRow('agility', s.agiBase, s.agiGain)}
									${attrRow('intelligence', s.intBase, s.intGain)}
								</div>
							</div>
						</section>

						<div class="hidden w-px bg-line/70 lg:block"></div>

						<!-- 定位 -->
						<section class="flex flex-col lg:w-1/3" aria-label="英雄定位">
							<h3 class="mb-5 flex items-center gap-3 text-xs font-semibold tracking-widest text-gold"><span class="h-px flex-1 bg-gradient-to-r from-gold/40 to-transparent"></span><span class="shrink-0">定位</span><span class="h-px flex-1 bg-gradient-to-l from-gold/40 to-transparent"></span></h3>
							<div class="flex flex-1 flex-col justify-center gap-2.5">${(h.roleBars || []).map((r) => roleRow(r.level, r.label)).join('')}</div>
						</section>

						<div class="hidden w-px bg-line/70 lg:block"></div>

						<!-- 数值 -->
						<section class="flex flex-col lg:w-1/3" aria-label="英雄数值">
							<h3 class="mb-5 flex items-center gap-3 text-xs font-semibold tracking-widest text-gold"><span class="h-px flex-1 bg-gradient-to-r from-gold/40 to-transparent"></span><span class="shrink-0">数值</span><span class="h-px flex-1 bg-gradient-to-l from-gold/40 to-transparent"></span></h3>
							<div class="grid flex-1 grid-cols-1 gap-x-8 gap-y-4 sm:grid-cols-3 lg:grid-cols-1">
								<div>
									<p class="mb-2 text-xs font-medium tracking-widest text-gold/90">攻击</p>
									<div class="space-y-0.5">
										${statRow('damage', `${fmt(s.damageMin)}-${fmt(s.damageMax)}`)}
										${statRow('attack_time', fmt(s.attackRate, 1))}
										${statRow('attack_range', fmt(s.attackRange))}
										${statRow('projectile_speed', fmt(s.projectileSpeed))}
									</div>
								</div>
								<div>
									<p class="mb-2 text-xs font-medium tracking-widest text-gold/90">防御</p>
									<div class="space-y-0.5">
										${statRow('armor', fmt(s.armor, 1))}
										${statRow('magic_resist', fmt(s.magicResistance) + '%')}
									</div>
								</div>
								<div>
									<p class="mb-2 text-xs font-medium tracking-widest text-gold/90">机动性</p>
									<div class="space-y-0.5">
										${statRow('movement_speed', fmt(s.moveSpeed))}
										${statRow('turn_rate', fmt(s.turnRate, 1))}
										${statRow('vision', `${s.sightDay} / ${s.sightNight}`)}
									</div>
								</div>
							</div>
						</section>
					</div>
				</div>`;

				// ---- 交互 ----
				playMedia(view);
				const skillList = document.getElementById('skill-list');
				const viewerEl = document.getElementById('skill-viewer');
				let current = 0;

				const setSkill = (i: number) => {
					current = i;
					const a = h.abilities[i];
					if (!a) return;
					skillList?.querySelectorAll('.skill-tab').forEach((b, idx) => b.setAttribute('aria-selected', String(idx === i)));
					if (viewerEl) {
						viewerEl.innerHTML = viewerBody(a, 'base');
						playMedia(viewerEl);
					}
					bindViewer();
				};

				const bindViewer = () => {
					viewerEl?.querySelectorAll<HTMLButtonElement>('.variant-btn').forEach((btn) => {
						btn.addEventListener('click', () => {
							const a = h.abilities[current];
							viewerEl!.innerHTML = viewerBody(a, btn.dataset.variant as Variant);
							playMedia(viewerEl!);
							bindViewer();
						});
					});
				};

				skillList?.querySelectorAll<HTMLElement>('.skill-tab').forEach((btn) => {
					btn.addEventListener('click', () => setSkill(Number(btn.dataset.skill)));
				});
				bindViewer();
			} catch (e) {
				console.error(e);
				renderError();
			}
		};

		load();
	})();
</script>
