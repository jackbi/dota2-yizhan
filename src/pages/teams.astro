---
import Layout from '../layouts/Layout.astro';
import type { LeagueTier } from '../data/types';
import { formatIso, formatMatchTime } from '../lib/format';
import { LEAGUE_TIER_META, bestTierOf, isFirstTier } from '../lib/leagueTier';
import { LIQUIPEDIA_SOURCE_URL } from '../lib/liquipediaApi';
import type { TeamDetail } from '../lib/tournamentIndex';
import { getTournamentIndex } from '../lib/tournamentIndex';
import { getTournaments } from '../lib/tournamentsApi';

/**
 * 战队列表。
 *
 * 数据就是 `/teams/<队>` 那些页面用的同一份索引——它已经把窗口内出现过的每支队的战绩与
 * 对阵聚合好了，这里只换一种呈现方式，不额外抓任何东西（`getTournamentIndex()` 内部就是
 * 拿 `getTournaments()` 的结果算的，两个一起调也只抓一轮）。
 *
 * **排序按"谁在打"**，不是按胜率也不是按名字：这一页的读者多半是从赛事页点过来的，
 * 想知道的是正在进行的比赛里有谁。没打完对阵的排前面、按下一场的时间升序，其余按最近一场
 * 赛果倒序。混在一起排的话，休赛期的队会插在正在打的队中间。
 *
 * 名单会随赛程增长（一轮构建几十支，长期下来几百支），所以配一个按队名过滤的搜索框——
 * 交互和英雄页那套一致：构建期已经把卡片画进 HTML，脚本只切可见性，不再回服务器要数据。
 *
 * **默认只显示一线队**。Dota 2 没有官方的一线队名单（理由与实测见 `lib/leagueTier.ts`），
 * 所以这里的口径是「窗口内打过 T1 或 T2 赛事」，页面上要把这句话写给读者看，
 * 而不是挂一个「一线队」的牌子就完事——它是近似，读者有权知道近似在哪。
 */

const [index, bundle] = await Promise.all([getTournamentIndex(), getTournaments()]);
// 时间格式化工具统一使用 Unix 秒，Date.now() 是毫秒。
const now = Math.floor(Date.now() / 1000);

/** 一支队伍在这张列表上要用到的东西。 */
interface TeamRow {
	team: TeamDetail;
	/** 窗口内已完赛的场次与胜率；一场没打时胜率是 null，不按 0% 显示。 */
	played: number;
	winRate: number | null;
	/** 最近一场未打完对阵的开赛时间；没有就是 null。 */
	next: number | null;
	/** 手上有没有正在打的那一场。 */
	live: boolean;
	/** 最近一场已完赛的开赛时间；没有就是 null。 */
	last: number | null;
	/** 窗口内打过的最好档位；一场正式赛事都没打过时是 undefined。 */
	bestTier?: LeagueTier;
}

const rows: TeamRow[] = [...index.teams.values()].map((team) => {
	// `team.matches` 由索引按开赛时间倒序排好，所以第一场已完赛的就是最近那场。
	const completed = team.matches.filter((match) => match.status === 'completed');
	const pending = team.matches.filter((match) => match.status !== 'completed');
	const played = team.wins + team.losses;
	return {
		team,
		played,
		winRate: played > 0 ? Math.round((team.wins / played) * 100) : null,
		next: pending.length > 0 ? Math.min(...pending.map((match) => match.startTime)) : null,
		live: pending.some((match) => match.status === 'live'),
		last: completed.length > 0 ? completed[0].startTime : null,
		bestTier: bestTierOf(team.events),
	};
});

rows.sort((a, b) => {
	if (a.next !== null && b.next !== null) return a.next - b.next;
	if (a.next !== null) return -1;
	if (b.next !== null) return 1;
	return (b.last ?? 0) - (a.last ?? 0);
});

const firstTierRows = rows.filter((row) => isFirstTier(row.bestTier));
const FILTERS = [
	{ id: 'first', label: '一线队', count: firstTierRows.length },
	{ id: 'all', label: '全部', count: rows.length },
] as const;

/** 队标没有、或那张图没取回来时用的占位——和详情页保持一致。 */
function initial(name: string): string {
	return name.trim().slice(0, 2).toUpperCase();
}
---

<Layout
	title="战队 · DOTA2 驿站"
	description="DOTA2 职业战队名录：队标、窗口内的胜负数与胜率，以及每支队正在参加或最近打过的赛事。"
>
	<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
		<div class="mb-6">
			<p class="text-xs font-semibold uppercase tracking-[0.2em] text-dota-light">职业战队</p>
			<h1 class="mt-2 font-display text-3xl sm:text-4xl">战队名录</h1>
			<p class="mt-3 max-w-2xl text-muted">
				当前数据窗口内出现过的职业战队，默认只列一线队，按是否还有比赛排在最前面。点开任意一队看它的队员、赛程与历史赛果。
			</p>
			{/*
				口径要写出来：Dota 2 没有官方的一线队名单，这里是"窗口内打过 T1/T2 赛事"的近似，
				读者有权知道它在哪里不准（理由与实测见 lib/leagueTier.ts）。
			*/}
			<p class="mt-2 max-w-2xl text-xs text-faint">
				一线队 = 这段时间里打过一级或二级赛事（T1 / T2）的队伍，档位来自 Liquipedia 对赛事的定级。这是近似口径：打进 T1 预选赛的队伍也会被算进来，而休赛期没打 T1/T2 的强队会被漏掉。
			</p>
		</div>

		<div class="mb-8 flex flex-wrap items-center gap-x-4 gap-y-2 rounded-xl border border-line bg-surface px-4 py-3 text-xs">
			<span class="text-muted">
				数据更新于 {formatIso(bundle.updatedAt)} ·
				<a href={LIQUIPEDIA_SOURCE_URL} target="_blank" rel="noopener noreferrer" class="text-dota-light underline-offset-2 hover:underline">
					队名与队标来自 Liquipedia
				</a>
			</span>
			{
				bundle.sources.map((source) => (
					<span class="inline-flex items-center gap-1.5 text-muted">
						<span class:list={['h-1.5 w-1.5 rounded-full', source.ok ? 'bg-[#4ade80]' : 'bg-faint']}></span>
						{source.label}
					</span>
				))
			}
			{bundle.degraded ? <span class="text-gold">实时数据源暂不可用，以下为降级结果</span> : null}
		</div>

		{
			rows.length > 0 ? (
				<>
					<div class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-3">
						<div id="team-tabs" class="flex flex-wrap gap-2" role="group" aria-label="按档位筛选">
							{FILTERS.map((f) => (
								<button
									type="button"
									data-tier={f.id}
									class="rounded-lg border border-line px-4 py-2 text-sm font-medium transition aria-pressed:border-dota aria-pressed:bg-dota/15 aria-pressed:text-dota-light"
									aria-pressed={f.id === 'first' ? 'true' : 'false'}
								>
									{f.label}
									<span class="ml-1 text-xs text-faint">{f.count}</span>
								</button>
							))}
						</div>
						<h2 class="text-sm text-muted">
							<span id="team-count">共 {firstTierRows.length} 支战队</span>
							<span id="team-playing" class="text-faint"> · {firstTierRows.filter((row) => row.next !== null).length} 支还有比赛</span>
						</h2>
						<label class="relative block w-full md:ml-auto md:w-80">
							<span class="sr-only">搜索战队</span>
							<svg
								class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-faint"
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								aria-hidden="true"
							>
								<circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8" />
								<path d="M21 21l-4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
							</svg>
							<input
								id="team-search"
								type="search"
								placeholder="搜索战队名"
								class="w-full rounded-full border border-line bg-surface py-2.5 pl-11 pr-4 text-sm text-cream placeholder:text-faint focus:border-dota focus:outline-none"
							/>
						</label>
					</div>

					<div id="team-grid" data-tier="first" class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
						{rows.map((row) => (
							<a
								href={`/teams/${row.team.id}`}
								data-name={row.team.name.toLowerCase()}
								data-tier={isFirstTier(row.bestTier) ? 'first' : 'other'}
								data-playing={row.next !== null ? '1' : '0'}
								class="team-card group flex items-center gap-3 rounded-2xl border border-line bg-surface p-4 transition hover:-translate-y-0.5 hover:border-dota/50 hover:bg-surface-2"
							>
								<span class="relative flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-line bg-surface-2 text-xs font-semibold text-faint">
									{initial(row.team.name)}
									{row.team.logo ? (
										<img
											src={row.team.logo}
											alt=""
											loading="lazy"
											referrerpolicy="no-referrer"
											class="absolute inset-0 h-full w-full object-cover"
										/>
									) : null}
								</span>

								<span class="min-w-0 flex-1">
									<span class="flex items-center gap-1.5">
										<span class="min-w-0 truncate font-display text-base text-cream transition group-hover:text-dota-light">
											{row.team.name}
										</span>
										{row.live ? (
											<span class="shrink-0 rounded bg-[#22c55e]/15 px-1.5 py-0.5 text-[10px] font-semibold text-[#4ade80]">比赛中</span>
										) : null}
									</span>
									{/*
										档位徽章挂在战绩这一行的**最前面**：放在队名旁边会把长队名挤到只剩一半
										（4 列布局下一张卡只有 200 出头可放文字），战绩这行本来就是截断的。
									*/}
									<span class="mt-1 flex items-center gap-1.5 text-xs text-muted">
										{row.bestTier ? (
											<span
												class:list={['shrink-0 rounded px-1.5 py-0.5 text-[10px] font-semibold', LEAGUE_TIER_META[row.bestTier].cls]}
											>
												{LEAGUE_TIER_META[row.bestTier].label}
											</span>
										) : null}
										<span class="min-w-0 truncate">
											{row.played > 0 ? `${row.team.wins} 胜 ${row.team.losses} 负` : '暂无完赛记录'}
											{row.winRate === null ? '' : ` · 胜率 ${row.winRate}%`}
											{row.team.events.length > 0 ? ` · ${row.team.events.length} 项赛事` : ''}
										</span>
									</span>
									<span class="mt-0.5 block truncate text-xs text-faint">
										{
											row.next !== null
												? `下一场 ${formatMatchTime(row.next, now)}`
												: row.last !== null
													? `最近一场 ${formatMatchTime(row.last, now)}`
													: '赛程待定'
										}
									</span>
								</span>
							</a>
						))}
					</div>

					{/*
						首屏就得决定这句话要不要出：默认视图是「只看一线队」，而窗口里一支 T1/T2 队都没有
						（只跑了 T3/T4，或这一轮档位整块没解析出来）时，网格是空的。这句文案要是不出，
						读者看到的就是「共 0 支战队」加一片空白，没有任何解释——服务端按实际条数决定，
						脚本起来之后再接管。
					*/}
					<p id="team-empty" class="py-16 text-center text-sm text-faint" hidden={firstTierRows.length > 0}>
						没有符合条件的战队。
					</p>
				</>
			) : (
				<div class="rounded-2xl border border-line bg-surface px-6 py-16 text-center">
					<p class="text-muted">暂时拿不到战队数据。</p>
					<p class="mt-2 text-sm text-faint">赛事数据源恢复后，这里会自动显示最新的战队名录。</p>
				</div>
			)
		}
	</section>
</Layout>

<style>
	/*
	 * 默认视图是「只看一线队」。这一条走 CSS 而不是等脚本把卡片一张张藏起来：脚本要等页面
	 * 加载完才跑，那之前读者会先看到全部 52 支、再"跳"成 21 支；没有 JS 时更是一直看到全部，
	 * 而上面的筛选按钮还写着「一线队」。脚本通过切容器的 `data-tier` 属性来切换，
	 * 搜索仍然是逐张卡片的行内 `display`——两者互不干扰（行内样式只在搜索命中时才写）。
	 */
	#team-grid[data-tier='first'] .team-card:not([data-tier='first']) {
		display: none;
	}
</style>

<script>
	/*
	 * 两件事：按档位筛选（一线队 / 全部）与按队名搜索，两者是「与」的关系。
	 *
	 * 卡片在构建期就画进 HTML 了，脚本不去回服务器要数据——和英雄页那边同一个理由：
	 * 那份数据服务端已经渲染过一遍，客户端再来一次不但白打一次接口，抓不到时整栏还会空掉。
	 *
	 * 「N 支还有比赛」跟着当前筛选重算，而不是只在没筛选时显示：默认视图就是筛过的
	 * （一线队），藏起来等于读者永远看不到这个信息。
	 */
	(() => {
		const grid = document.getElementById('team-grid');
		const count = document.getElementById('team-count');
		const playing = document.getElementById('team-playing');
		const tabs = document.getElementById('team-tabs');
		const search = document.getElementById('team-search') as HTMLInputElement | null;
		const empty = document.getElementById('team-empty');
		if (!grid || !count || !search) return;

		const cards = Array.from(grid.querySelectorAll<HTMLAnchorElement>('a[data-name]'));
		if (!cards.length) return;

		let tier = 'first';

		const apply = (): void => {
			const q = search.value.trim().toLowerCase();
			let shown = 0;
			let playingShown = 0;
			for (const card of cards) {
				const visible = (tier === 'all' || card.dataset.tier === 'first') && (!q || (card.dataset.name ?? '').includes(q));
				/*
				 * 只写搜索这一维：档位那一维由容器上的 `data-tier` 与上面那条 CSS 规则负责，
				 * 这样首屏（脚本还没跑时）就已经是筛过的。写 `''` 是清掉行内样式、交还给 CSS，
				 * 不是「显示」——被 CSS 挡住的卡片仍然会被挡住。
				 */
				card.style.display = visible ? '' : 'none';
				if (!visible) continue;
				shown += 1;
				if (card.dataset.playing === '1') playingShown += 1;
			}
			count.textContent = shown ? `共 ${shown} 支战队` : '没有符合条件的战队';
			if (playing) {
				playing.textContent = playingShown > 0 ? ` · ${playingShown} 支还有比赛` : '';
				playing.hidden = playingShown === 0;
			}
			if (empty) empty.hidden = shown > 0;
		};

		tabs?.querySelectorAll<HTMLButtonElement>('button[data-tier]').forEach((btn) => {
			btn.addEventListener('click', () => {
				tier = btn.dataset.tier ?? 'all';
				grid.dataset.tier = tier;
				tabs.querySelectorAll('button[data-tier]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
				btn.setAttribute('aria-pressed', 'true');
				apply();
			});
		});

		search.addEventListener('input', apply);

		/*
		 * 首屏也跑一次：服务端已经按「一线队」把卡片与空提示画对了，这里再对齐一遍计数与空提示，
		 * 免得「服务端那套」和「脚本这套」哪天走岔（例如以后默认档位改了而模板没跟着改）。
		 * 空查询下它只写 `display: ''`，不会改变首屏看到的东西。
		 */
		apply();
	})();
</script>
