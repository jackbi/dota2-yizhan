---
import Layout from '../layouts/Layout.astro';
import TeamCard from '../components/TeamCard.astro';
import { formatIso } from '../lib/format';
import { TEAM_PORTAL_URL } from '../lib/liquipediaApi';
import type { TeamDetail } from '../lib/tournamentIndex';
import { getTournamentIndex } from '../lib/tournamentIndex';
import { getTournaments } from '../lib/tournamentsApi';

/**
 * 战队列表。
 *
 * 数据就是 `/teams/<队>` 那些页面用的同一份索引——它已经聚合好了每支队的战绩与对阵。
 *
 * **名单来自 Liquipedia 的 `Portal:Teams`，按地区分组**。这里换过一次口径：原先的名录是
 * "这几届赛事里出现过谁"，再用赛事档位猜哪支算一线队——那样的名单必然走样（打进 T1 预选赛的
 * 二线队会被算进来，休赛期没打 T1/T2 的强队会被漏掉，档位本来就是赛事的属性）。门户是
 * Liquipedia 人工维护的活跃战队名单，且天然按地区分好组，所以档位不再给**队伍**分层：
 * 它继续管赛事（`/tournaments` 的档位筛选），名录这里只用地区。
 *
 * 地区是 Liquipedia 的**队籍登记**，不是俱乐部起源地：OG 在东南亚（`location=Philippines`）、
 * LGD Gaming 在南美、GamerLegion 在北美——页面上要把这句话写出来，否则读者会以为分错了。
 *
 * 窗口里出现过、门户没收录的队伍放进最后那个折叠区块，不让它们从站上消失（对阵页与赛事页
 * 都还链着它们）；门户整个抓不到时退回"窗口里出现过的队伍"单列一区（见 `tournamentIndex`）。
 *
 * **组内排序按"谁在打"**，不是按胜率也不是按名字：这一页的读者多半是想看现在有谁在比赛。
 * 没打完对阵的排前面、按下一场的时间升序，其余按最近一场赛果倒序。
 *
 * 搜索框按队名过滤：构建期已经把卡片画进 HTML，脚本只切可见性，不再回服务器要数据
 * （和英雄页那套一致）。
 */

const [index, bundle] = await Promise.all([getTournamentIndex(), getTournaments()]);
// 时间格式化工具统一使用 Unix 秒，Date.now() 是毫秒。
const now = Math.floor(Date.now() / 1000);

/** 一支队伍在这张列表上要用到的东西。 */
interface TeamRow {
	team: TeamDetail;
	/** 窗口内已完赛的场次与胜率；一场没打时胜率是 null，不按 0% 显示。 */
	played: number;
	winRate: number | null;
	/** 最近一场未打完对阵的开赛时间；没有就是 null。 */
	next: number | null;
	/** 手上有没有正在打的那一场。 */
	live: boolean;
	/** 最近一场已完赛的开赛时间；没有就是 null。 */
	last: number | null;
}

const rows: TeamRow[] = [...index.teams.values()].map((team) => {
	// `team.matches` 由索引按开赛时间倒序排好，所以第一场已完赛的就是最近那场。
	const completed = team.matches.filter((match) => match.status === 'completed');
	const pending = team.matches.filter((match) => match.status !== 'completed');
	const played = team.wins + team.losses;
	return {
		team,
		played,
		winRate: played > 0 ? Math.round((team.wins / played) * 100) : null,
		next: pending.length > 0 ? Math.min(...pending.map((match) => match.startTime)) : null,
		live: pending.some((match) => match.status === 'live'),
		last: completed.length > 0 ? completed[0].startTime : null,
	};
});

rows.sort((a, b) => {
	if (a.next !== null && b.next !== null) return a.next - b.next;
	if (a.next !== null) return -1;
	if (b.next !== null) return 1;
	return (b.last ?? 0) - (a.last ?? 0);
});

const rowOf = new Map(rows.map((row) => [row.team.id, row]));

/*
 * 门户的每个地区一区；门户没给任何地区（抓不到、也没有缓存）时退化成"全部"一区，
 * 页面照常可用，只是没有分组。
 */
const sections =
	index.regions.length > 0
		? index.regions
				.map((region) => ({
					key: region.key,
					label: region.label,
					rows: region.teamIds.map((id) => rowOf.get(id)).filter((row): row is TeamRow => !!row),
				}))
				.filter((section) => section.rows.length > 0)
		: [{ key: 'all', label: '全部', rows }];

/** 窗口里出现过、门户没收录的队伍。门户抓不到时这一定是空的（那时 `portalIds` 也是空的）。 */
const unlisted = sections.length > 0 && index.portalIds.size > 0 ? rows.filter((row) => !index.portalIds.has(row.team.id)) : [];

---

<Layout
	title="战队 · DOTA2 驿站"
	description="DOTA2 职业战队名录：按地区分组的活跃战队，含队标、窗口内的胜负数与胜率，以及每支队正在参加或最近打过的赛事。"
>
	<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
		<div class="mb-6">
			<p class="text-xs font-semibold uppercase tracking-[0.2em] text-dota-light">职业战队</p>
			<h1 class="mt-2 font-display text-3xl sm:text-4xl">战队名录</h1>
			<p class="mt-3 max-w-2xl text-muted">
				按地区列出目前活跃的职业战队，组内按是否还有比赛排序。点开任意一队看它的队员、赛程与历史赛果。
			</p>
			{/*
				口径要写出来：地区是 Liquipedia 的队籍登记，不是俱乐部起源地——OG 在东南亚、
				LGD Gaming 在南美、GamerLegion 在北美都是这个原因。不写的话读者会以为分错了。
			*/}
			<p class="mt-2 max-w-2xl text-xs text-faint">
				名单与地区来自 Liquipedia 的活跃战队门户（
				<a href={TEAM_PORTAL_URL} target="_blank" rel="noopener noreferrer" class="text-dota-light underline-offset-2 hover:underline">
					Portal:Teams
				</a>
				），地区按它的队籍登记——不是俱乐部的起源地，OG、LGD Gaming 这些队都会出现在与印象不同的地区里。
			</p>
		</div>

		<div class="mb-8 flex flex-wrap items-center gap-x-4 gap-y-2 rounded-xl border border-line bg-surface px-4 py-3 text-xs">
			<span class="text-muted">
				数据更新于 {formatIso(bundle.updatedAt)} ·
				<a href={TEAM_PORTAL_URL} target="_blank" rel="noopener noreferrer" class="text-dota-light underline-offset-2 hover:underline">
					队名与队标来自 Liquipedia
				</a>
			</span>
			{
				bundle.sources.map((source) => (
					<span class="inline-flex items-center gap-1.5 text-muted">
						<span class:list={['h-1.5 w-1.5 rounded-full', source.ok ? 'bg-[#4ade80]' : 'bg-faint']}></span>
						{source.label}
					</span>
				))
			}
			{bundle.degraded ? <span class="text-gold">实时数据源暂不可用，以下为降级结果</span> : null}
		</div>

		{
			rows.length > 0 ? (
				<>
					<div class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-3">
						<h2 class="text-sm text-muted">
							<span id="team-count">共 {rows.length} 支战队</span>
							<span id="team-playing" class="text-faint"> · {rows.filter((row) => row.next !== null).length} 支还有比赛</span>
						</h2>
						<label class="relative block w-full md:ml-auto md:w-80">
							<span class="sr-only">搜索战队</span>
							<svg
								class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-faint"
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								aria-hidden="true"
							>
								<circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8" />
								<path d="M21 21l-4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
							</svg>
							<input
								id="team-search"
								type="search"
								placeholder="搜索战队名"
								class="w-full rounded-full border border-line bg-surface py-2.5 pl-11 pr-4 text-sm text-cream placeholder:text-faint focus:border-dota focus:outline-none"
							/>
						</label>
					</div>

					<div id="team-sections" class="space-y-10">
						{sections.map((section) => (
							<section data-region={section.key}>
								<div class="mb-4 flex items-baseline gap-3 border-b border-line pb-2">
									<h2 class="font-display text-xl">{section.label}</h2>
									<span data-region-count class="text-xs text-faint">{section.rows.length} 支</span>
								</div>
								<div data-grid class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
									{section.rows.map((row) => (
										<TeamCard {...row} now={now} />
									))}
								</div>
							</section>
						))}
					</div>

					{/*
						窗口里出现过、门户没收录的队伍：名录换了主来源，但这些队伍仍然有页面（对阵页、
						赛事页都链着它们），从名录里搜不到就太别扭了。折起来放在最后，不占首屏。
					*/}
					{unlisted.length > 0 ? (
						<details id="team-unlisted" class="mt-10 rounded-2xl border border-line bg-surface/60 px-4 py-3">
							<summary class="cursor-pointer text-sm text-muted">
								还有 {unlisted.length} 支窗口内出现过的队伍（Liquipedia 门户未收录）
							</summary>
							<p class="mt-2 text-xs text-faint">
								这些队伍出现在我们抓到的赛程里，但不在 Liquipedia 的活跃战队名录上——多为二线队、青训队或临时组队，因此没有地区归属。
							</p>
							<div data-grid class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
								{unlisted.map((row) => (
									<TeamCard {...row} now={now} />
								))}
							</div>
						</details>
					) : null}

					{/* 搜索没命中时出这一句；服务端按实际条数决定要不要渲染，脚本起来之后再接管。 */}
					<p id="team-empty" class="py-16 text-center text-sm text-faint" hidden={rows.length > 0}>
						没有符合条件的战队。
					</p>
				</>
			) : (
				<div class="rounded-2xl border border-line bg-surface px-6 py-16 text-center">
					<p class="text-muted">暂时拿不到战队数据。</p>
					<p class="mt-2 text-sm text-faint">赛事数据源恢复后，这里会自动显示最新的战队名录。</p>
				</div>
			)
		}
	</section>
</Layout>

<style>
	/*
	 * 「窗口里出现过、门户没收录」那一块折起来时，里面的卡片不该被搜索算进去——但搜索命中时
	 * 又要能看见，所以脚本会在命中时把 details 打开（见下面的 apply()），这里只负责展开动画
	 * 之外的观感：`summary` 的默认三角留着，读者一眼能看出可以点。
	 */
	#team-unlisted[open] > summary {
		color: var(--color-cream);
	}
</style>

<script>
	/*
	 * 按队名搜索：逐张卡片切可见性，再按地区重算计数。
	 *
	 * 卡片在构建期就画进 HTML 了，脚本不去回服务器要数据——和英雄页那边同一个理由：
	 * 那份数据服务端已经渲染过一遍，客户端再来一次不但白打一次接口，抓不到时整栏还会空掉。
	 *
	 * 地区区块里一支都没剩时把整个区块收掉，否则读者会看到「西欧 0 支」下面一片空白。
	 * 「N 支还有比赛」跟着当前筛选重算：它是这一页最有用的一个数字（谁现在在打）。
	 */
	(() => {
		const sections = Array.from(document.querySelectorAll<HTMLElement>('#team-sections section[data-region]'));
		const unlisted = document.getElementById('team-unlisted');
		const count = document.getElementById('team-count');
		const playing = document.getElementById('team-playing');
		const search = document.getElementById('team-search') as HTMLInputElement | null;
		const empty = document.getElementById('team-empty');
		if (!sections.length || !count || !search) return;

		const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-name]'));
		if (!cards.length) return;

		const apply = (): void => {
			const q = search.value.trim().toLowerCase();
			let shown = 0;
			let playingShown = 0;
			for (const card of cards) {
				const hit = !q || (card.dataset.name ?? '').includes(q);
				card.style.display = hit ? '' : 'none';
				if (!hit) continue;
				shown += 1;
				if (card.dataset.playing === '1') playingShown += 1;
			}

			for (const section of sections) {
				const visible = Array.from(section.querySelectorAll<HTMLAnchorElement>('a[data-name]')).filter(
					(card) => card.style.display !== 'none',
				).length;
				section.hidden = visible === 0;
				const label = section.querySelector<HTMLElement>('[data-region-count]');
				if (label) label.textContent = `${visible} 支`;
			}

			count.textContent = shown > 0 ? `共 ${shown} 支战队` : '没有符合条件的战队';
			if (playing) {
				playing.textContent = playingShown > 0 ? ` · ${playingShown} 支还有比赛` : '';
				playing.hidden = playingShown === 0;
			}
			if (empty) empty.hidden = shown > 0;

			/*
			 * 折叠块（「门户未收录」那一批）要跟着搜索走两件事：
			 * 里面一张都没命中时整块收掉，否则搜索"spirit"时它还会挂着"还有 22 支"；
			 * 命中了就自动展开——不展开的话，搜到了却什么也看不见。
			 * 清空搜索时不自动收起：读者刚展开过，替他做决定更烦。
			 */
			if (unlisted) {
				const inside = Array.from(unlisted.querySelectorAll<HTMLAnchorElement>('a[data-name]')).filter(
					(card) => card.style.display !== 'none',
				).length;
				unlisted.hidden = q.length > 0 && inside === 0;
				if (q.length > 0 && inside > 0) unlisted.open = true;
			}
		};

		search.addEventListener('input', apply);
	})();
</script>
