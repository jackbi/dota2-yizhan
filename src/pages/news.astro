---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import type { NewsCardItem } from '../data/types';
import { RUMOR_NEWS } from '../data/news';
import { NEWS_FILTERS, fetchOfficialNews, toNewsCard, type OfficialNews } from '../lib/newsApi';

let articles: OfficialNews[] = [];
try {
	articles = await fetchOfficialNews();
} catch {
	articles = [];
}

/** 列表卡片额外带上所属栏目，用于前端筛选。 */
type Card = NewsCardItem & { cats: string[] };

const officialCards: Card[] = articles.map((item, index) => ({
	...toNewsCard(item, index === 0),
	cats: ['all', ...item.feeds],
}));

const rumorCards: Card[] = RUMOR_NEWS.map((item) => ({ ...item, cats: ['rumor'] }));
const cards = [...officialCards, ...rumorCards];

// 综合新闻汇总官网全部栏目，其余按官网栏目筛选。
const TABS = [
	{ id: 'all', label: '综合新闻' },
	...NEWS_FILTERS.filter((feed) => feed.id !== 'general'),
	{ id: 'rumor', label: '小道消息' },
];
const countOf = (id: string) => cards.filter((card) => card.cats.includes(id)).length;
---

<Layout title="新闻 · DOTA2 驿站" description="DOTA2 官方新闻、赛事动态与社区小道消息，正文在站内直接阅读。">
	<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
		<div class="mb-8">
			<p class="text-xs font-semibold uppercase tracking-[0.2em] text-dota-light">资讯中心</p>
			<h1 class="mt-2 font-display text-3xl sm:text-4xl">新闻 & 小道消息</h1>
			<p class="mt-3 max-w-2xl text-muted">
				官方新闻取自 DOTA2 官网，正文在站内直接阅读，不用再跳转到别处。
			</p>
		</div>

		<div id="news-tabs" class="mb-8 flex flex-wrap gap-2" role="group" aria-label="新闻分类">
			{
				TABS.map((tab) => (
					<button
						type="button"
						data-cat={tab.id}
						class="rounded-lg border border-line px-4 py-2 text-sm font-medium transition aria-pressed:border-dota aria-pressed:bg-dota/15 aria-pressed:text-dota-light"
						aria-pressed={tab.id === 'all' ? 'true' : 'false'}
					>
						{tab.label}
						<span class="ml-1 text-xs text-faint">{countOf(tab.id)}</span>
					</button>
				))
			}
		</div>

		{
			articles.length === 0 ? (
				<p class="mb-6 rounded-2xl border border-line bg-surface px-5 py-4 text-sm text-muted">
					官方新闻暂不可用：构建期没有取到 dota2.com.cn 的列表，也没有可用的本地缓存。以下为站内小道消息。
				</p>
			) : null
		}

		<div id="news-list" class="grid grid-cols-1 gap-4 lg:grid-cols-2">
			{
				cards.map((card) => (
					<div data-cats={card.cats.join(',')}>
						<NewsCard item={card} />
					</div>
				))
			}
		</div>

		<p id="news-empty" class="py-16 text-center text-sm text-faint" hidden>
			该栏目暂时还没有内容。
		</p>

		<p class="mt-10 text-center text-xs text-faint">
			官方新闻版权归 DOTA2 官方网站所有，本站仅作站内阅读与归档。
		</p>
	</section>
</Layout>

<script>
	(() => {
		const tabs = document.getElementById('news-tabs');
		const list = document.getElementById('news-list');
		const empty = document.getElementById('news-empty');
		if (!tabs || !list) return;
		const cards = Array.from(list.querySelectorAll<HTMLElement>('[data-cats]'));
		const apply = (cat: string) => {
			let shown = 0;
			for (const card of cards) {
				const matched = (card.dataset.cats ?? '').split(',').includes(cat);
				card.hidden = !matched;
				if (matched) shown++;
			}
			if (empty) empty.hidden = shown > 0;
		};
		tabs.querySelectorAll<HTMLButtonElement>('button').forEach((btn) => {
			btn.addEventListener('click', () => {
				tabs.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', 'false'));
				btn.setAttribute('aria-pressed', 'true');
				apply(btn.dataset.cat ?? 'all');
			});
		});
		// 无脚本时保留全部卡片，有脚本时先按默认栏目收敛一次，避免与高亮的标签页对不上。
		const active = tabs.querySelector<HTMLButtonElement>('button[aria-pressed="true"]');
		apply(active?.dataset.cat ?? 'all');
	})();
</script>
