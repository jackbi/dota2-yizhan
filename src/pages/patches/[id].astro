---
import Layout from '../../layouts/Layout.astro';
import { fetchPatchUpdates, fetchArticle } from '../../lib/patchesApi';

export async function getStaticPaths() {
	const updates = await fetchPatchUpdates(3);
	return updates.map((update) => ({ params: { id: update.id }, props: { update } }));
}

const { update } = Astro.props;

let content = '';
let failed = false;
try {
	content = await fetchArticle(update.href);
	if (!content) failed = true;
} catch {
	failed = true;
}
---

<Layout title={`${update.title} · 版本信息 · DOTA2 驿站`} description={`${update.title}（${update.date}）官方更新日志正文。`}>
	<Fragment slot="head">
		<meta name="referrer" content="no-referrer" />
	</Fragment>
	<section class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
		<a href="/patches" class="inline-flex items-center gap-1.5 text-sm text-muted transition hover:text-gold">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
			返回版本页
		</a>

		<header class="mt-5 border-b border-line pb-6">
			<div class="flex flex-wrap items-center gap-3">
				<span class="font-display text-3xl text-gold">{update.version || '版本更新'}</span>
				<span class="rounded-md bg-dota/15 px-2 py-1 text-xs font-semibold text-dota-light">更新日志</span>
			</div>
			<h1 class="mt-3 font-display text-2xl leading-tight text-cream sm:text-3xl">{update.title}</h1>
			<p class="mt-2 text-sm text-muted">{update.date} · 官方更新日志</p>
		</header>

		<div class="mt-6 rounded-2xl border border-line bg-surface p-6 sm:p-8">
			{
				content ? (
					<div class="patch-content" set:html={content} />
				) : (
					<p class="text-muted">
						正文加载失败，
						<a href={update.href} target="_blank" rel="noopener noreferrer" class="text-dota-light underline-offset-2 hover:underline">
							前往官方查看原文
						</a>
						。
					</p>
				)
			}
		</div>
	</section>
</Layout>

<style>
	.patch-content {
		--content-max: 72ch;
	}
	.patch-content h2 {
		font-family: var(--font-display);
		color: var(--color-gold);
		font-size: 1.35rem;
		margin: 1.75rem 0 0.75rem;
		line-height: 1.4;
	}
	.patch-content h2:first-child {
		margin-top: 0;
	}
	.patch-content h3 {
		color: var(--color-cream);
		font-size: 1.1rem;
		font-weight: 600;
		margin: 1.25rem 0 0.5rem;
	}
	.patch-content p {
		color: var(--color-cream);
		line-height: 1.9;
		margin: 0.75rem 0;
	}
	.patch-content ul,
	.patch-content ol {
		padding-left: 1.4rem;
		margin: 0.75rem 0;
		color: var(--color-cream);
	}
	.patch-content li {
		line-height: 1.8;
		margin: 0.35rem 0;
	}
	.patch-content strong {
		color: var(--color-cream);
		font-weight: 600;
	}
	.patch-content a {
		color: var(--color-dota-light);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.patch-content img {
		max-width: 100%;
		height: auto;
		border-radius: 0.75rem;
		border: 1px solid var(--color-line);
		margin: 0.75rem 0;
	}
	.patch-content table {
		width: 100%;
		border-collapse: collapse;
		margin: 1rem 0;
		font-size: 0.9rem;
	}
	.patch-content th,
	.patch-content td {
		border: 1px solid var(--color-line);
		padding: 0.5rem 0.75rem;
		color: var(--color-cream);
		text-align: left;
	}
	.patch-content th {
		background: var(--color-surface-2);
		font-weight: 600;
	}
</style>
