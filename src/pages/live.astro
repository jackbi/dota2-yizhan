---
import Layout from '../layouts/Layout.astro';
import LiveGrid from '../components/LiveGrid.astro';
import { OB_MEMBERS } from '../data/ob';
import { fetchLiveSnapshot } from '../lib/liveApi';
import { formatIso } from '../lib/format';

const snapshot = await fetchLiveSnapshot();
const liveCount = OB_MEMBERS.filter((m) => {
	const s = snapshot.statuses[`${m.platform}:${m.roomId}`];
	return s?.state === 'live' && !s.ownerMismatch;
}).length;
---

<Layout title="分屏直播 · DOTA2 驿站" description="网页端分屏直播，聚合观看多位 OB 主播，并显示构建期抓取的开播状态。">
	<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
		<div class="mb-8">
			<p class="text-xs font-semibold uppercase tracking-[0.2em] text-dota-light">DOTA2 驿站 · 分屏直播</p>
			<h1 class="mt-2 font-display text-3xl sm:text-4xl">聚合分屏，一屏多路</h1>
			<p class="mt-3 max-w-2xl text-muted">
				选择想要观看的主播，切换分屏数量，在一个页面随时掌握多路直播间动态。
				每个画面右下角都能直接跳到官方直播间。
			</p>
			<p class="mt-3 text-sm text-faint">
				开播状态抓取于 <span class="text-cream/80">{formatIso(snapshot.at)}</span>（静态站点快照，不随时间刷新），
				当前 {liveCount} 位在播。热度为平台口径，不等于观看人数。
			</p>
		</div>

		<LiveGrid members={OB_MEMBERS} snapshot={snapshot} />
	</section>
</Layout>
