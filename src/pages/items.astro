---
import Layout from '../layouts/Layout.astro';
---

<Layout title="装备资料 · DOTA2 驿站" description="DOTA2 装备库，实时来自官方 itemscategory 接口，按基础 / 升级 / 中立分类浏览。">
	<Fragment slot="head">
		<meta name="referrer" content="no-referrer" />
	</Fragment>
	<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
		<div class="mb-8">
			<p class="text-xs font-semibold uppercase tracking-[0.2em] text-dota-light">装备图鉴</p>
			<h1 class="mt-2 font-display text-3xl sm:text-4xl">装备资料库</h1>
			<p class="mt-3 max-w-2xl text-muted">数据实时来自 DOTA2 官方接口。点击装备可查看价格、效果与合成配方。</p>
		</div>

		<div class="mb-6 flex flex-wrap items-center gap-3">
			<div id="item-tabs" class="flex flex-wrap items-center gap-2" role="group" aria-label="按栏筛选">
				<button type="button" data-section="all" class="filter-chip" aria-pressed="true">全部</button>
				<button type="button" data-section="basic" class="filter-chip" aria-pressed="false">基础</button>
				<button type="button" data-section="upgrade" class="filter-chip" aria-pressed="false">升级</button>
				<button type="button" data-section="neutral" class="filter-chip" aria-pressed="false">中立</button>
			</div>

			<label class="relative block w-full sm:ml-auto sm:w-80">
				<span class="sr-only">搜索装备</span>
				<svg class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-faint" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8" />
					<path d="M21 21l-4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
				</svg>
				<input
					id="item-search"
					type="search"
					placeholder="搜索装备名（中文 / 英文）"
					class="w-full rounded-full border border-line bg-surface py-2.5 pl-11 pr-4 text-sm text-cream placeholder:text-faint focus:border-dota focus:outline-none"
				/>
			</label>
		</div>

		<p id="item-count" class="mb-4 text-sm text-muted">正在加载装备数据…</p>

		<div id="item-status" class="hidden rounded-2xl border border-line bg-surface p-8 text-center">
			<p class="text-muted">装备数据加载失败，请检查网络后重试。</p>
			<button id="item-retry" type="button" class="mt-4 rounded-lg bg-dota px-5 py-2.5 text-sm font-medium text-white transition hover:bg-dota-light">重新加载</button>
		</div>

		<div id="item-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{Array.from({ length: 6 }).map(() => (
				<div class="flex animate-pulse flex-col overflow-hidden rounded-2xl border border-line bg-surface">
					<div class="aspect-[16/9] bg-surface-2"></div>
					<div class="space-y-2 p-4">
						<div class="h-4 rounded bg-surface-3"></div>
						<div class="h-3 w-2/3 rounded bg-surface-3"></div>
					</div>
				</div>
			))}
		</div>
	</section>
</Layout>

<style>
	.filter-chip {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding: 5px 14px;
		border-radius: 999px;
		border: 1px solid var(--color-line);
		background: transparent;
		color: var(--color-muted);
		font-size: 13px;
		cursor: pointer;
		transition: border-color 0.15s, color 0.15s, background 0.15s;
	}
	.filter-chip:hover {
		color: var(--color-cream);
		border-color: var(--color-dota-light);
	}
	.filter-chip[aria-pressed='true'] {
		background: rgb(173 61 40 / 0.14);
		border-color: var(--color-dota);
		color: var(--color-gold);
	}
</style>

<script>
	import { fetchItemSections, loadItemDetails, cleanItemText } from '../lib/itemApi';

	(() => {
		const tabs = document.getElementById('item-tabs');
		const grid = document.getElementById('item-grid');
		const count = document.getElementById('item-count');
		const search = document.getElementById('item-search') as HTMLInputElement | null;
		const status = document.getElementById('item-status');
		const retry = document.getElementById('item-retry') as HTMLButtonElement | null;
		if (!tabs || !grid || !count) return;

		let sections: import('../lib/itemApi').ItemSection[] = [];
		let active = 'all';
		let q = '';
		let detailMap: Record<string, import('../lib/itemApi').ItemDetail> | null = null;

		const esc = (s: string) =>
			s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
		const fmtCost = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(1).replace(/\.0$/, '')}k` : String(n));
		const fullCost = (n: number) => n.toLocaleString('en-US');
		const clean = (s: string) => cleanItemText(s);

		const tile = (it: import('../lib/itemApi').ItemListItem) => `
			<button type="button" data-item="${esc(it.name)}" class="group flex flex-col overflow-hidden rounded-2xl border border-line/60 bg-surface shadow-[0_1px_0_rgba(255,255,255,0.03)] transition duration-200 hover:-translate-y-0.5 hover:border-dota/40 hover:bg-surface-2 hover:shadow-lg hover:shadow-dota/10">
				<span class="relative aspect-square w-full overflow-hidden bg-gradient-to-br from-surface-2 to-surface-3">
					<img src="${esc(it.imgUrl)}" alt="${esc(it.nameLoc)}" loading="lazy" referrerpolicy="no-referrer" class="h-full w-full object-contain p-4 transition duration-300 group-hover:scale-105">
					<span class="pointer-events-none absolute inset-x-0 bottom-0 h-1/4 bg-gradient-to-t from-surface/70 to-transparent" aria-hidden="true"></span>
				</span>
				<span class="flex min-w-0 items-center justify-between gap-2 px-3 pb-3 pt-2">
					<span class="min-w-0">
						<span class="block truncate text-sm font-medium leading-tight text-cream">${esc(it.nameLoc)}</span>
						<span class="mt-0.5 block text-xs tabular-nums text-gold">${fmtCost(it.cost)}</span>
					</span>
					<svg class="h-4 w-4 shrink-0 text-faint transition group-hover:text-gold" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
				</span>
			</button>`;

		const render = () => {
			const ql = q.trim().toLowerCase();
			const visible = sections.filter((s) => active === 'all' || s.key === active);
			let html = '';
			let shown = 0;
			for (const sec of visible) {
				let groupsHtml = '';
				let secCount = 0;
				for (const grp of sec.groups) {
					const items = grp.items.filter((it) => !ql || (it.nameLoc + ' ' + it.name).toLowerCase().includes(ql));
					if (!items.length) continue;
					secCount += items.length;
					groupsHtml += `
						<div class="mb-8">
							<h3 class="mb-3 flex items-center gap-2 font-display text-lg text-cream">
								<span class="text-gold">${esc(grp.name)}</span>
								<span class="text-xs font-normal text-faint">${items.length} 件</span>
							</h3>
							<div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">${items.map(tile).join('')}</div>
						</div>`;
				}
				if (!groupsHtml) continue;
				shown += secCount;
				html += `<section class="mb-10">
					<h2 class="mb-4 flex items-center gap-2 font-display text-2xl text-gold">${esc(sec.label)}<span class="text-xs font-normal text-faint">${secCount} 件</span></h2>
					${groupsHtml}
				</section>`;
			}
			count.textContent = shown ? `共 ${shown} 件装备` : '未找到匹配的装备';
			grid.innerHTML = html || `<div class="col-span-full rounded-2xl border border-line bg-surface p-10 text-center text-muted">没有符合筛选条件的装备。</div>`;
		};

		const section = (title: string, body: string) => `
			<div class="mt-5">
				<h4 class="mb-2 text-xs font-semibold tracking-widest text-gold/90">${esc(title)}</h4>
				<p class="whitespace-pre-line text-sm leading-relaxed text-muted">${esc(body)}</p>
			</div>`;

		const closeModal = () => {
			document.getElementById('item-modal')?.remove();
			document.removeEventListener('keydown', onModalKey);
		};
		const onModalKey = (e: KeyboardEvent) => {
			if (e.key === 'Escape') closeModal();
		};

		const openItem = async (name: string, listItem: import('../lib/itemApi').ItemListItem) => {
			try {
				if (!detailMap) detailMap = await loadItemDetails();
			} catch (e) {
				console.error(e);
			}
			const d = detailMap?.[name];
			const nameLoc = d?.nameLoc || listItem.nameLoc;
			const nameEn = d?.nameEn || '';
			const imgUrl = d?.imgUrl || listItem.imgUrl;
			const cost = d?.cost || listItem.cost;
			const isActive = /主动|使用/.test(`${d?.desc || ''}${d?.attrib || ''}`);
			const components = (d?.components || '').split(/[;,]/).map((s) => s.trim()).filter(Boolean);
			const compChips = components.slice(0, 12).map((key) => {
				const c = detailMap?.[key];
				return `<span class="flex items-center gap-1.5 rounded-lg border border-line bg-surface-2 px-2 py-1 text-xs text-cream">
					${c?.imgUrl ? `<img src="${esc(c.imgUrl)}" alt="" loading="lazy" referrerpolicy="no-referrer" class="h-5 w-5 object-contain">` : ''}
					<span>${esc(c?.nameLoc || key)}</span>
				</span>`;
			}).join('');
			const meta = [
				d?.cd ? `冷却 ${esc(d.cd)}` : '',
				d?.mc ? `魔法消耗 ${esc(d.mc)}` : '',
			].filter(Boolean).join('　·　');
			const desc = clean(d?.desc || '');
			const attrib = clean(d?.attrib || '');
			const notes = clean(d?.notes || '');
			const lore = clean(d?.lore || '');

			const modal = document.createElement('div');
			modal.id = 'item-modal';
			modal.className = 'fixed inset-0 z-50 flex items-center justify-center p-4';
			modal.setAttribute('role', 'dialog');
			modal.setAttribute('aria-modal', 'true');
			modal.innerHTML = `
				<div class="absolute inset-0 bg-black/70 backdrop-blur-sm" data-close></div>
				<div class="relative w-full max-w-2xl overflow-y-auto rounded-2xl border border-line bg-surface p-6 shadow-2xl" style="max-height:86vh">
					<button type="button" data-close aria-label="关闭" class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full border border-line bg-ink/60 text-muted transition hover:text-cream">✕</button>
					<div class="flex items-start gap-4 pr-10">
						<div class="flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-line bg-ink-2">
							<img src="${esc(imgUrl)}" alt="${esc(nameLoc)}" referrerpolicy="no-referrer" class="h-full w-full object-contain">
						</div>
						<div class="min-w-0 flex-1">
							<h3 class="font-display text-xl leading-tight text-cream">${esc(nameLoc)}</h3>
							<p class="mt-0.5 text-sm text-muted">${esc(nameEn)}</p>
							<p class="mt-2 font-display text-lg text-gold tabular-nums">${fullCost(cost)} <span class="text-xs text-faint">金币</span></p>
							<span class="mt-2 inline-flex rounded-md px-2 py-0.5 text-xs font-medium ${isActive ? 'bg-dota/15 text-dota-light' : 'bg-zinc-600/15 text-zinc-400'}">${isActive ? '主动' : '被动'}</span>
						</div>
					</div>
					${desc ? section('描述', desc) : ''}
					${attrib ? section('效果', attrib) : ''}
					${notes ? section('备注', notes) : ''}
					${lore ? section('背景', lore) : ''}
					${compChips ? section('合成配方', `<div class="flex flex-wrap gap-2">${compChips}</div>`) : ''}
					${meta ? section('基础信息', meta) : ''}
				</div>`;
			document.body.appendChild(modal);
			modal.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', closeModal));
			document.addEventListener('keydown', onModalKey);
			(modal.querySelector('button[data-close]') as HTMLButtonElement | null)?.focus();
		};

		grid.addEventListener('click', (e) => {
			const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-item]');
			if (!btn) return;
			const name = btn.dataset.item!;
			const listItem = sections.flatMap((s) => s.groups.flatMap((g) => g.items)).find((it) => it.name === name);
			if (listItem) openItem(name, listItem);
		});

		tabs?.querySelectorAll<HTMLButtonElement>('button[data-section]').forEach((btn) => {
			btn.addEventListener('click', () => {
				active = btn.dataset.section!;
				tabs.querySelectorAll('button[data-section]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
				btn.setAttribute('aria-pressed', 'true');
				render();
			});
		});

		search?.addEventListener('input', () => {
			q = search.value ?? '';
			render();
		});

		const load = async () => {
			grid.classList.remove('hidden');
			if (status) status.classList.add('hidden');
			count.textContent = '正在加载装备数据…';
			try {
				sections = await fetchItemSections();
				render();
			} catch (e) {
				console.error(e);
				grid.innerHTML = '';
				if (status) status.classList.remove('hidden');
				count.textContent = '加载失败';
			}
		};
		retry?.addEventListener('click', load);
		load();
	})();
</script>
