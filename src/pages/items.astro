---
import Layout from '../layouts/Layout.astro';
import { fetchItemSections } from '../lib/itemApi';

/*
 * 装备列表在构建期就取好、画进 HTML。
 *
 * 原先这一整块是客户端 `fetchItemSections()` 现拉的，构建产物里**一件装备名都没有**——
 * 百度基本不执行 JS，Google 要等二次渲染，那一步还得依赖 dota2.com.cn 的连通性。
 * 现在服务端渲染，客户端只做筛选与悬浮详情（详情仍是按需拉的 JSONP，614 件一次性下太大）。
 *
 * 取不到不算构建失败：换成一句"下一轮构建会重试"，别让页面看着像坏了。
 */
const itemSections = await fetchItemSections().catch(() => null);
const itemTotal = itemSections?.reduce((total, sec) => total + sec.groups.reduce((n, g) => n + g.items.length, 0), 0) ?? 0;
---

<Layout title="装备资料 · DOTA2 驿站" description="DOTA2 装备库，实时来自官方 itemscategory 接口，按基础 / 升级 / 中立分类浏览。">
	<Fragment slot="head">
		<meta name="referrer" content="no-referrer" />
	</Fragment>
	<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
		<div class="mb-8">
			<p class="text-xs font-semibold uppercase tracking-[0.2em] text-dota-light">装备图鉴</p>
			<h1 class="mt-2 font-display text-3xl sm:text-4xl">装备资料库</h1>
			<p class="mt-3 max-w-2xl text-muted">数据实时来自 DOTA2 官方接口。点击装备可查看价格、效果与合成配方。</p>
			<p class="mt-4">
				<a
					href="/heroes"
					class="inline-flex items-center gap-1.5 rounded-lg border border-line px-4 py-2 text-sm text-cream transition hover:border-dota hover:text-dota-light"
				>
					查英雄资料
					<span aria-hidden="true">→</span>
				</a>
			</p>
		</div>

		<div class="sticky top-16 z-40 -mx-4 mb-6 border-b border-line/60 bg-ink/95 px-4 py-3 backdrop-blur-xl sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8">
			<div class="flex flex-wrap items-center gap-3">
				<nav class="flex items-center gap-1.5 text-sm" aria-label="装备分类">
					<a href="#sec-basic" class="rounded-lg border border-line/60 px-3 py-1.5 text-muted transition hover:border-dota/50 hover:text-cream">基础</a>
					<a href="#sec-upgrade" class="rounded-lg border border-line/60 px-3 py-1.5 text-muted transition hover:border-dota/50 hover:text-cream">升级</a>
					<a href="#sec-neutral" class="rounded-lg border border-line/60 px-3 py-1.5 text-muted transition hover:border-dota/50 hover:text-cream">中立</a>
				</nav>

				<label class="relative block w-full sm:ml-auto sm:w-80">
					<span class="sr-only">搜索装备</span>
					<svg class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-faint" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8" />
						<path d="M21 21l-4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
					</svg>
					<input
						id="item-search"
						type="search"
						placeholder="搜索装备名（中文 / 英文）"
						class="w-full rounded-full border border-line bg-surface py-2.5 pl-11 pr-4 text-sm text-cream placeholder:text-faint focus:border-dota focus:outline-none"
					/>
				</label>
			</div>
		</div>

		<p id="item-count" class="mb-4 text-sm text-muted">{itemSections ? `共 ${itemTotal} 件装备` : '装备数据暂缺'}</p>

		{
			itemSections ? null : (
				<div class="rounded-2xl border border-line bg-surface p-8 text-center">
					<p class="text-muted">本次构建没有取到官方装备数据，这一块先空着，下一轮构建会重试。</p>
				</div>
			)
		}

		<p id="item-empty" class="hidden rounded-2xl border border-line bg-surface p-10 text-center text-muted">没有符合筛选条件的装备。</p>

		<div id="item-grid">
			{itemSections?.map((sec) => (
				<section id={`sec-${sec.key}`} data-section class="mb-12 scroll-mt-24">
					<h2 class="mb-4 flex items-end gap-3 font-display text-2xl text-gold">
						{sec.label}
						<span data-section-count class="pb-1 text-xs font-normal text-faint">
							{sec.groups.reduce((n, g) => n + g.items.length, 0)} 件
						</span>
					</h2>
					<div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6">
						{sec.groups.flatMap((group) =>
							group.items.map((it) => (
								<a
									href={`/items/${it.name}`}
									data-item={it.name}
									data-name={`${it.nameLoc} ${it.name}`.toLowerCase()}
									data-loc={it.nameLoc}
									data-img={it.imgUrl}
									data-cost={it.cost}
									class="group flex flex-col overflow-hidden rounded-2xl border border-line/60 bg-surface shadow-[0_1px_0_rgba(255,255,255,0.03)] transition duration-200 hover:-translate-y-0.5 hover:border-dota/40 hover:bg-surface-2 hover:shadow-lg hover:shadow-dota/10"
								>
									<span class="relative aspect-square w-full overflow-hidden bg-gradient-to-br from-surface-2 to-surface-3">
										<img
											src={it.imgUrl}
											alt={it.nameLoc}
											loading="lazy"
											referrerpolicy="no-referrer"
											class="h-full w-full object-contain p-3 transition duration-300 group-hover:scale-105"
										/>
										<span class="absolute left-2 top-2 rounded-md bg-ink/70 px-1.5 py-0.5 text-[11px] text-muted backdrop-blur">
											{group.name}
										</span>
										<span class="absolute right-2 top-2 flex items-center gap-1 rounded-md bg-ink/70 px-1.5 py-0.5 text-xs font-medium tabular-nums text-gold backdrop-blur">
											<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
												<circle cx="12" cy="12" r="10" fill="var(--color-gold)" />
												<circle cx="12" cy="12" r="6.5" fill="var(--color-gold-deep)" />
											</svg>
											{it.cost.toLocaleString('en-US')}
										</span>
										<span class="pointer-events-none absolute inset-x-0 bottom-0 h-1/4 bg-gradient-to-t from-surface/70 to-transparent" aria-hidden="true" />
									</span>
									<span class="block min-w-0 px-3 pb-3 pt-2">
										<span class="block break-words text-sm font-medium leading-snug text-cream">{it.nameLoc}</span>
									</span>
								</a>
							)),
						)}
					</div>
				</section>
			))}
		</div>

		<button id="back-top" type="button" aria-label="回到顶部" class="fixed bottom-6 right-6 z-40 flex h-11 w-11 items-center justify-center rounded-full border border-line bg-surface/90 text-cream opacity-0 shadow-lg backdrop-blur transition duration-200 hover:border-dota/50 hover:bg-surface-2 hover:text-gold pointer-events-none">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
		</button>
	</section>
</Layout>

<style>
	.filter-chip {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding: 5px 14px;
		border-radius: 999px;
		border: 1px solid var(--color-line);
		background: transparent;
		color: var(--color-muted);
		font-size: 13px;
		cursor: pointer;
		transition: border-color 0.15s, color 0.15s, background 0.15s;
	}
	.filter-chip:hover {
		color: var(--color-cream);
		border-color: var(--color-dota-light);
	}
	.filter-chip[aria-pressed='true'] {
		background: rgb(198 82 44 / 0.14);
		border-color: var(--color-dota);
		color: var(--color-gold);
	}
</style>

<script>
	import { loadItemDetails, cleanItemText } from '../lib/itemApi';

	/*
	 * 装备列表已经在构建期画进 HTML（见上面的 `itemSections`），这里只做两件事：
	 * 按关键词筛卡片、给卡片挂悬浮详情。
	 *
	 * 不再像以前那样先拉一次分类接口再整块重渲染：那份数据服务端已经渲染过，
	 * 客户端再来一次只会白打一次接口，抓不到时整页还是空的。
	 * 装备详情（614 件的价格 / 效果 / 配方）仍然按需拉——一次性下太大，没必要进首屏。
	 */
	(() => {
		const grid = document.getElementById('item-grid');
		const count = document.getElementById('item-count');
		const empty = document.getElementById('item-empty');
		const search = document.getElementById('item-search') as HTMLInputElement | null;

		const cards = grid ? Array.from(grid.querySelectorAll<HTMLElement>('[data-item]')) : [];
		const sections = grid ? Array.from(grid.querySelectorAll<HTMLElement>('[data-section]')) : [];
		let detailMap: Record<string, import('../lib/itemApi').ItemDetail> | null = null;

		const esc = (s: string) =>
			s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
		const fullCost = (n: number) => n.toLocaleString('en-US');
		const clean = (s: string) => cleanItemText(s);
		const MANA_ICON = 'https://cdn.dota2.com.cn/apps/dota2/images/tooltips/mana.png';
		const CD_ICON = 'https://cdn.dota2.com.cn/apps/dota2/images/tooltips/cooldown.png';

		/*
		 * 筛选 = 给卡片切可见性，再顺手把空掉的分类整块藏起来、更新分类里的件数。
		 *
		 * 用内联 `display` 而不是 `class="hidden"`：卡片自带 `flex`，两个工具类谁覆盖谁
		 * 要看样式表里的顺序，内联样式则一定生效。
		 */
		const applyFilter = () => {
			const ql = (search?.value ?? '').trim().toLowerCase();
			let shown = 0;
			for (const card of cards) {
				const visible = !ql || (card.dataset.name ?? '').includes(ql);
				card.style.display = visible ? '' : 'none';
				if (visible) shown += 1;
			}
			for (const section of sections) {
				const visibleCount = Array.from(section.querySelectorAll<HTMLElement>('[data-item]')).filter(
					(card) => card.style.display !== 'none',
				).length;
				section.style.display = visibleCount > 0 ? '' : 'none';
				const badge = section.querySelector('[data-section-count]');
				if (badge) badge.textContent = `${visibleCount} 件`;
			}
			if (count) count.textContent = shown ? `共 ${shown} 件装备` : '未找到匹配的装备';
			empty?.classList.toggle('hidden', shown > 0);
		};

		const sectionText = (title: string, body: string) =>
			body
				? `<section class="mt-5">
					<h4 class="mb-2 flex items-center gap-2 text-xs font-semibold tracking-widest text-gold">
						<span class="h-1.5 w-1.5 rounded-full bg-gold"></span>${esc(title)}
					</h4>
					<div class="rounded-xl border border-line/60 bg-surface-2/40 px-4 py-3">
						<p class="whitespace-pre-line text-sm leading-relaxed text-cream/90">${esc(body)}</p>
					</div>
				</section>`
				: '';
		const sectionHtml = (title: string, html: string) =>
			html
				? `<section class="mt-5">
					<h4 class="mb-2 flex items-center gap-2 text-xs font-semibold tracking-widest text-gold">
						<span class="h-1.5 w-1.5 rounded-full bg-gold"></span>${esc(title)}
					</h4>
					<div class="rounded-xl border border-line/60 bg-surface-2/40 px-4 py-3">${html}</div>
				</section>`
				: '';

		// ---- 悬浮详情（代替弹窗） ----
		const tip = document.createElement('div');
		tip.id = 'item-tip';
		tip.className =
			'fixed z-[60] w-[380px] max-w-[calc(100vw-16px)] max-h-[70vh] overflow-y-auto rounded-2xl border border-line bg-surface p-5 shadow-2xl opacity-0 pointer-events-none transition-opacity duration-150';
		tip.setAttribute('role', 'tooltip');
		tip.style.visibility = 'hidden';
		tip.style.left = '-9999px';
		tip.style.top = '0';
		document.body.appendChild(tip);

		let hideTimer = 0;
		const hideTip = () => {
			window.clearTimeout(hideTimer);
			tip.classList.add('opacity-0', 'pointer-events-none');
			tip.style.visibility = 'hidden';
		};
		const scheduleHide = () => {
			window.clearTimeout(hideTimer);
			hideTimer = window.setTimeout(hideTip, 120);
		};
		const cancelHide = () => window.clearTimeout(hideTimer);

		const positionTip = (anchor: HTMLElement) => {
			const r = anchor.getBoundingClientRect();
			const gap = 10;
			const m = 8;
			const tw = tip.offsetWidth;
			const th = tip.offsetHeight;
			let left = r.right + gap;
			if (left + tw > window.innerWidth - m) left = r.left - gap - tw;
			if (left < m) left = Math.min(m, window.innerWidth - tw - m);
			let top = r.top;
			if (top + th > window.innerHeight - m) top = window.innerHeight - m - th;
			if (top < m) top = m;
			tip.style.left = `${left}px`;
			tip.style.top = `${top}px`;
		};

		/*
		 * 悬浮详情只拿卡片自己身上的 data-*：卡片是构建期渲染的，本来就把名字、图标、
		 * 价格带在属性里了，没必要为了这些再在客户端留一份列表。
		 * 详细文案（描述 / 效果 / 配方）还是要 `detailMap`，那是按需拉的。
		 */
		const showTip = (anchor: HTMLElement) => {
			const key = anchor.dataset.item ?? '';
			const d = detailMap?.[key];
			const nameLoc = d?.nameLoc || anchor.dataset.loc || key;
			const nameEn = d?.nameEn || '';
			const imgUrl = d?.imgUrl || anchor.dataset.img || '';
			const cost = d?.cost || Number(anchor.dataset.cost) || 0;
			const isActive = /主动|使用/.test(`${d?.desc || ''}${d?.attrib || ''}`);
			// `*` 是接口里的标记（那件要拿升级件来合），展示时去掉。
			const components = (d?.requirements ?? []).map((key) => key.replace(/\*$/, '')).filter(Boolean);
			const compChips = components.slice(0, 12).map((key) => {
				const c = detailMap?.[key];
				return `<span class="flex items-center gap-1.5 rounded-lg border border-line bg-surface-2 px-2 py-1 text-xs text-cream">
					${c?.imgUrl ? `<img src="${esc(c.imgUrl)}" alt="" loading="lazy" referrerpolicy="no-referrer" class="h-5 w-5 object-contain">` : ''}
					<span>${esc(c?.nameLoc || key)}</span>
				</span>`;
			}).join('');
			const metaRow =
				(d?.cd
					? `<span class="flex items-center gap-1.5 text-sm text-cream tabular-nums"><img src="${CD_ICON}" alt="冷却时间" title="冷却时间" referrerpolicy="no-referrer" loading="lazy" class="h-[18px] w-[18px] object-contain"><span>${esc(d.cd)}</span></span>`
					: '') +
				(d?.mc
					? `<span class="flex items-center gap-1.5 text-sm text-cream tabular-nums"><img src="${MANA_ICON}" alt="魔法消耗" title="魔法消耗" referrerpolicy="no-referrer" loading="lazy" class="h-[18px] w-[18px] object-contain"><span>${esc(d.mc)}</span></span>`
					: '');
			const desc = clean(d?.desc || '');
			const attrib = clean(d?.attrib || '');
			const notes = clean(d?.notes || '');
			const lore = clean(d?.lore || '');
			const body =
				(desc ? sectionText('描述', desc) : '') +
				(attrib ? sectionText('效果', attrib) : '') +
				(notes ? sectionText('备注', notes) : '') +
				(lore ? sectionText('背景故事', lore) : '') +
				(compChips ? sectionHtml('合成配方', `<div class="flex flex-wrap gap-2">${compChips}</div>`) : '') +
				(metaRow ? sectionHtml('基础信息', `<div class="flex flex-wrap items-center gap-x-5 gap-y-2">${metaRow}</div>`) : '');

			tip.innerHTML = `
				<div class="flex items-start gap-3">
					<div class="flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-line/60 bg-ink-2">
						<img src="${esc(imgUrl)}" alt="${esc(nameLoc)}" referrerpolicy="no-referrer" class="h-full w-full object-contain p-1">
					</div>
					<div class="min-w-0 flex-1">
						<h3 class="font-display text-base leading-tight text-cream">${esc(nameLoc)}</h3>
						<p class="mt-0.5 truncate text-xs text-muted">${esc(nameEn)}</p>
						<div class="mt-1.5 flex flex-wrap items-center gap-2">
							<span class="font-display text-sm text-gold tabular-nums">${fullCost(cost)} <span class="text-[10px] font-normal text-faint">金币</span></span>
							<span class="inline-flex rounded px-1.5 py-0.5 text-[11px] font-medium ${isActive ? 'bg-dota/15 text-dota-light' : 'bg-zinc-600/15 text-zinc-400'}">${isActive ? '主动' : '被动'}</span>
						</div>
					</div>
				</div>
				${body ? `<div class="mt-3 border-t border-line/60 pt-1">${body}</div>` : ''}
				<a href="/items/${encodeURIComponent(key)}" class="mt-3 flex items-center gap-1 border-t border-line/60 pt-2 text-xs text-dota-light transition hover:text-gold">看详情<span aria-hidden="true">→</span></a>`;

			tip.classList.remove('opacity-0', 'pointer-events-none');
			tip.style.visibility = 'visible';
			positionTip(anchor);
			window.clearTimeout(hideTimer);
		};

		tip.addEventListener('mouseenter', cancelHide);
		tip.addEventListener('mouseleave', scheduleHide);

		// 卡片不再重建，所以每个只管挂一次监听。
		for (const btn of cards) {
			btn.addEventListener('mouseenter', () => showTip(btn));
			btn.addEventListener('mouseleave', scheduleHide);
			btn.addEventListener('focus', () => showTip(btn));
			btn.addEventListener('blur', hideTip);
		}

		search?.addEventListener('input', applyFilter);

		/*
		 * 详情按需拉一次就够，失败也不影响列表本身——那时悬浮框用卡片上的
		 * data-* 渲染，只是少了描述与配方。
		 */
		loadItemDetails()
			.then((map) => {
				detailMap = map;
			})
			.catch(() => {});

		// ---- 回到顶部 ----
		const backTop = document.getElementById('back-top') as HTMLButtonElement | null;
		if (backTop) {
			const onScroll = () => {
				const show = window.scrollY > 480;
				backTop.classList.toggle('opacity-0', !show);
				backTop.classList.toggle('pointer-events-none', !show);
			};
			window.addEventListener('scroll', onScroll, { passive: true });
			onScroll();
			backTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
		}
	})();
</script>
