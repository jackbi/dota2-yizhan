---
import Layout from '../../layouts/Layout.astro';
import MatchRow from '../../components/MatchRow.astro';
import RosterMemberCard from '../../components/RosterMemberCard.astro';
import { formatRange } from '../../lib/format';
import type { RosterMember } from '../../lib/liquipediaParse';
import { localizePatchIcons } from '../../lib/patchIcons';
import { heroIconKey } from '../../lib/patchNotes';
import { fetchPatchNames } from '../../lib/patchesApi';
import { EVENT_STATUS_META } from '../../lib/statusMeta';
import type { TeamDetail } from '../../lib/tournamentIndex';
import { getTournamentIndex } from '../../lib/tournamentIndex';
import { isPathSegment } from '../../lib/routeSlug';

interface Props {
	team: TeamDetail;
}

export async function getStaticPaths() {
	const index = await getTournamentIndex();
	const paths = [];
	for (const team of index.teams.values()) {
		/*
		 * 队伍 id 会成为路径段，而它是从外部队名拼出来的。实测踩过一次：OpenDota 实时对局里
		 * 出现队名 `team yosi/vape`，路径被当成两段，Astro 抛 `Missing parameter: id`
		 * 把**整个构建**打断——线上只能停在上一份产物上。id 现在都过了 `routeSlug`，
		 * 这里是兜底：真有不安全的 id 就跳过这一个队伍页并出声，别带走整站。
		 */
		if (!isPathSegment(team.id)) {
			console.warn(`[teams] 跳过路径不安全的队伍 id：${JSON.stringify(team.id)}（${team.name}）`);
			continue;
		}
		paths.push({
			params: { id: team.id },
			props: { team },
		});
	}
	return paths;
}

/*
 * 名单（现役 / 替补 / 教练组）已经在索引里取好了，见 `tournamentIndex` 里的
 * `fetchLiquipediaTeamRosters`。这里不再按队逐个去要——那会变成几十个请求，
 * 而 Liquipedia 的条款要求低频调用。
 */
const { team } = Astro.props;
const roster = team.roster;
const now = Math.floor(Date.now() / 1000);

/*
 * 招牌英雄的图标复用更新日志那一套（同一个 Valve CDN、同一个已发布目录），不新开图片通道——
 * 图标只有 20px 大，多存一份没有意义。
 *
 * 英雄名与图标 key 都取自**名字表**（`fetchPatchNames()`，就是更新日志那条线在用的那份：
 * datafeed 的内部名 `npc_dota_hero_kez` → `kez`，与 `heroIconUrl()` 拼地址同源）。
 *
 * **不要从官方英雄列表的图片文件名反推 key**：127 个英雄里 5 个的文件名不是
 * `npc_dota_hero_<key>.png`——凯 / 瑪西 / 獸 是 UUID、琼英碧灵是 `muerta_hphover`
 * （实测），反推出来的地址必然 404，那几位在页面上就永远没有图标（凯当时就在名单里），
 * 百戏大王只是碰巧推对。名字表拿不到时整块降级：不显示英雄，只留名单——
 * 这一块是附加信息，不该让整页失败。
 */
const poolHeroIds = [...new Set((roster?.players ?? []).flatMap((member) => member.heroPool?.heroes.map((h) => h.heroId) ?? []))];
const heroById = new Map<number, { name: string; key: string }>();
try {
	const names = await fetchPatchNames();
	for (const [id, hero] of names.heroes) heroById.set(id, { name: hero.name, key: hero.key });
} catch {
	// 拿不到就退化成"没有招牌英雄"，下面两处都会自然跳过。
}

/*
 * 只取**这一页真要画的那几个**图标。以前这里传的是 `heroById` 的全量（整份英雄列表），
 * 后果不只是多算几步：`localizeImages()` 命中也会把 mtime 刷成当前时间，而构建末尾的
 * `publishImages()` 正是按 mtime 判断"本轮用到过"——于是每张战队页都把 127 张图标全量
 * 拷进 `dist/patch-heroes/`，连一个英雄都不显示的队伍（没有名单）也不例外。
 * 判据本来就算好了，用它。
 */
const poolHeroes = poolHeroIds.flatMap((heroId) => {
	const hero = heroById.get(heroId);
	return hero ? [{ key: hero.key, name: hero.name }] : [];
});
const heroIcons =
	poolHeroes.length > 0 ? await localizePatchIcons({ heroes: poolHeroes, items: [] }) : new Map<string, string>();

/** 一位选手的招牌英雄（名字 + 图标都备好）。英雄列表拿不到时返回空数组。 */
function heroChips(member: RosterMember): { name: string; icon?: string; games: number; wins: number }[] {
	return (member.heroPool?.heroes ?? []).flatMap((stat) => {
		const hero = heroById.get(stat.heroId);
		if (!hero) return [];
		return [{ name: hero.name, icon: heroIcons.get(heroIconKey(hero.key)), games: stat.games, wins: stat.wins }];
	});
}

/** 口径文案。跨版本的那一批不能写版本号——那会让人以为这也是本版本的数据。 */
function heroScopeLabel(member: RosterMember): string | undefined {
	const pool = member.heroPool;
	if (!pool) return undefined;
	return pool.scope === 'patch' ? `${pool.version} 版本` : '近 90 天';
}

/** 号位按国内习惯说。 */
const POSITION_LABEL: Record<number, string> = { 1: '一号位', 2: '二号位', 3: '三号位', 4: '四号位', 5: '五号位' };
/** 教练组的角色名翻一下；认不出的原样留着——宁可页面上留英文，也别编一个不存在的头衔。 */
const ROLE_LABEL: Record<string, string> = {
	coach: '教练',
	'head coach': '主教练',
	analyst: '分析师',
	manager: '经理',
	'team manager': '领队',
};
function roleLabel(role: string): string {
	return role
		.split('/')
		.map((part) => ROLE_LABEL[part.trim().toLowerCase()] ?? part.trim())
		.filter(Boolean)
		.join('/');
}

/** 未打完的对阵（进行中/未开赛/延期）按开赛时间升序，先看最近的。 */
const scheduled = team.matches.filter((m) => m.status !== 'completed').sort((a, b) => a.startTime - b.startTime);
const finished = team.matches.filter((m) => m.status === 'completed');

const played = team.wins + team.losses;
const winRate = played > 0 ? Math.round((team.wins / played) * 100) : null;

function initial(name: string): string {
	return name.trim().slice(0, 2).toUpperCase();
}
---

<Layout
	title={`${team.name} · 战队 · DOTA2 驿站`}
	description={`${team.name} 的队员、赛程与赛果：当前数据窗口内 ${team.matches.length} 场对阵，${team.wins} 胜 ${team.losses} 负。`}
	breadcrumbs={[{ name: '战队', href: '/teams' }, { name: team.name }]}
>
	<section class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
		<a href="/teams" class="inline-flex items-center gap-1.5 text-sm text-muted transition hover:text-gold">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
			返回战队名录
		</a>

		<header class="mt-5 flex items-center gap-4 border-b border-line pb-6">
			<span class="relative flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-line bg-plate text-sm font-semibold text-plate-ink">
				{initial(team.name)}
				{
					team.logo ? (
						<img
							src={team.logo}
							alt=""
							loading="lazy"
							referrerpolicy="no-referrer"
							class="absolute inset-0 h-full w-full object-contain p-1"
						/>
					) : null
				}
			</span>
			<div class="min-w-0">
				<h1 class="truncate font-display text-3xl leading-tight sm:text-4xl">{team.name}</h1>
				<p class="mt-2 text-sm text-muted">
					{played > 0 ? `${team.wins} 胜 ${team.losses} 负` : '暂无已完赛记录'}
					<span class="text-faint"> · 当前数据窗口内 {team.matches.length} 场对阵</span>
				</p>
			</div>
		</header>

		<div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
			<div class="rounded-xl border border-line bg-surface px-4 py-3">
				<p class="text-xs text-faint">已完赛</p>
				<p class="mt-1 font-display text-2xl">{played}</p>
			</div>
			<div class="rounded-xl border border-line bg-surface px-4 py-3">
				<p class="text-xs text-faint">胜</p>
				<p class="mt-1 font-display text-2xl text-[#4ade80]">{team.wins}</p>
			</div>
			<div class="rounded-xl border border-line bg-surface px-4 py-3">
				<p class="text-xs text-faint">负</p>
				<p class="mt-1 font-display text-2xl text-muted">{team.losses}</p>
			</div>
			<div class="rounded-xl border border-line bg-surface px-4 py-3">
				<p class="text-xs text-faint">胜率</p>
				<p class="mt-1 font-display text-2xl">{winRate === null ? '—' : `${winRate}%`}</p>
			</div>
		</div>

		{
			roster && (roster.players.length > 0 || roster.standins.length > 0 || roster.staff.length > 0) ? (
				<section class="mt-10">
					<div class="flex flex-wrap items-baseline justify-between gap-2">
						<h2 class="font-display text-xl">人员名单</h2>
						{
							team.wiki ? (
								<a
									href={`https://liquipedia.net/dota2/${team.wiki}`}
									target="_blank"
									rel="noopener noreferrer"
									class="text-xs text-faint transition hover:text-gold"
								>
									名单来自 Liquipedia ↗
								</a>
							) : null
						}
					</div>
					<p class="mt-2 text-xs text-faint">
						招牌英雄只算正式比赛（STRATZ 不开放天梯对局），优先当前版本、样本不足才回退到近 90 天；每行末尾标的是实际口径，图标后的数字是场次/胜场。
					</p>

					{
						roster.players.length > 0 ? (
							<div class="mt-4 grid grid-cols-1 gap-2">
								{roster.players.map((member) => (
									<RosterMemberCard
										member={member}
										badge={POSITION_LABEL[member.position ?? 0] ?? '位置待定'}
										heroes={heroChips(member)}
										heroScope={heroScopeLabel(member)}
									/>
								))}
							</div>
						) : null
					}

					{
						roster.standins.length > 0 ? (
							<>
								<h3 class="mt-6 text-sm font-semibold text-muted">替补</h3>
								<div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
									{roster.standins.map((member) => (
										<RosterMemberCard member={member} badge="替补" />
									))}
								</div>
							</>
						) : null
					}

					{
						roster.staff.length > 0 ? (
							<>
								<h3 class="mt-6 text-sm font-semibold text-muted">教练组</h3>
								<div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
									{roster.staff.map((member) => (
										<RosterMemberCard member={member} badge={member.role ? roleLabel(member.role) : '教练组'} />
									))}
								</div>
							</>
						) : null
					}
				</section>
			) : (
				<p class="mt-10 border-t border-line pt-6 text-xs text-faint">
					该队暂无人员名单：队标与名单都取自 Liquipedia，只有被它收录的队伍才有维护好的现役名单。
				</p>
			)
		}

		{
			scheduled.length > 0 ? (
				<section class="mt-10">
					<h2 class="font-display text-xl">即将进行</h2>
					<div class="mt-4 grid grid-cols-1 gap-3 lg:grid-cols-2">
						{scheduled.map((match) => (
							<MatchRow match={match} now={now} showEvent />
						))}
					</div>
				</section>
			) : null
		}

		{
			finished.length > 0 ? (
				<section class="mt-10">
					<h2 class="font-display text-xl">历史赛果</h2>
					<div class="mt-4 grid grid-cols-1 gap-3 lg:grid-cols-2">
						{finished.map((match) => (
							<MatchRow match={match} now={now} showEvent />
						))}
					</div>
				</section>
			) : null
		}

		{
			team.events.length > 0 ? (
				<section class="mt-10">
					<h2 class="font-display text-xl">参赛赛事</h2>
					<div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
						{team.events.map((event) => (
							<a
								href={`/tournaments/${event.id}`}
								class="flex items-center justify-between gap-3 rounded-xl border border-line bg-surface px-4 py-3 transition hover:border-dota/40 hover:bg-surface-2"
							>
								<span class="min-w-0">
									<span class="block truncate text-sm text-cream">{event.name}</span>
									<span class="mt-1 block text-xs text-faint">{formatRange(event.startTime, event.endTime)}</span>
								</span>
								<span class:list={['shrink-0 rounded-md px-2 py-0.5 text-xs font-semibold', EVENT_STATUS_META[event.status].cls]}>
									{EVENT_STATUS_META[event.status].label}
								</span>
							</a>
						))}
					</div>
				</section>
			) : null
		}
	</section>
</Layout>
