---
import Layout from '../../layouts/Layout.astro';
import MatchRow from '../../components/MatchRow.astro';
import { formatRange } from '../../lib/format';
import type { TeamRoster } from '../../lib/opendota';
import { loadTeamRoster } from '../../lib/opendota';
import { EVENT_STATUS_META } from '../../lib/statusMeta';
import type { TeamDetail } from '../../lib/tournamentIndex';
import { getTournamentIndex } from '../../lib/tournamentIndex';
import { isPathSegment } from '../../lib/routeSlug';

interface Props {
	team: TeamDetail;
	/** OpenDota 的队员名单；该队未被收录时为 null。 */
	roster: TeamRoster | null;
}

export async function getStaticPaths() {
	const index = await getTournamentIndex();
	// 串行取阵容：限速是按请求间隔做的，并发会把间隔打乱。
	const paths = [];
	for (const team of index.teams.values()) {
		/*
		 * 队伍 id 会成为路径段，而它是从外部队名拼出来的。实测踩过一次：OpenDota 实时对局里
		 * 出现队名 `team yosi/vape`，路径被当成两段，Astro 抛 `Missing parameter: id`
		 * 把**整个构建**打断——线上只能停在上一份产物上。id 现在都过了 `routeSlug`，
		 * 这里是兜底：真有不安全的 id 就跳过这一个队伍页并出声，别带走整站。
		 */
		if (!isPathSegment(team.id)) {
			console.warn(`[teams] 跳过路径不安全的队伍 id：${JSON.stringify(team.id)}（${team.name}）`);
			continue;
		}
		paths.push({
			params: { id: team.id },
			props: { team, roster: await loadTeamRoster({ id: team.id, name: team.name, logo: team.logo }) },
		});
	}
	return paths;
}

const { team, roster } = Astro.props;
const now = Math.floor(Date.now() / 1000);

/** 未打完的对阵（进行中/未开赛/延期）按开赛时间升序，先看最近的。 */
const scheduled = team.matches.filter((m) => m.status !== 'completed').sort((a, b) => a.startTime - b.startTime);
const finished = team.matches.filter((m) => m.status === 'completed');

const played = team.wins + team.losses;
const winRate = played > 0 ? Math.round((team.wins / played) * 100) : null;

function initial(name: string): string {
	return name.trim().slice(0, 2).toUpperCase();
}
---

<Layout
	title={`${team.name} · 赛事 · DOTA2 驿站`}
	description={`${team.name} 的赛程与赛果：当前数据窗口内 ${team.matches.length} 场对阵，${team.wins} 胜 ${team.losses} 负。`}
>
	<section class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
		<a href="/tournaments" class="inline-flex items-center gap-1.5 text-sm text-muted transition hover:text-gold">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
			返回赛事列表
		</a>

		<header class="mt-5 flex items-center gap-4 border-b border-line pb-6">
			<span class="relative flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-line bg-surface-2 text-sm font-semibold text-faint">
				{initial(team.name)}
				{
					team.logo ? (
						<img
							src={team.logo}
							alt=""
							loading="lazy"
							referrerpolicy="no-referrer"
							class="absolute inset-0 h-full w-full object-cover"
						/>
					) : null
				}
			</span>
			<div class="min-w-0">
				<h1 class="truncate font-display text-3xl leading-tight sm:text-4xl">{team.name}</h1>
				<p class="mt-2 text-sm text-muted">
					{played > 0 ? `${team.wins} 胜 ${team.losses} 负` : '暂无已完赛记录'}
					<span class="text-faint"> · 当前数据窗口内 {team.matches.length} 场对阵</span>
				</p>
			</div>
		</header>

		<div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
			<div class="rounded-xl border border-line bg-surface px-4 py-3">
				<p class="text-xs text-faint">已完赛</p>
				<p class="mt-1 font-display text-2xl">{played}</p>
			</div>
			<div class="rounded-xl border border-line bg-surface px-4 py-3">
				<p class="text-xs text-faint">胜</p>
				<p class="mt-1 font-display text-2xl text-[#4ade80]">{team.wins}</p>
			</div>
			<div class="rounded-xl border border-line bg-surface px-4 py-3">
				<p class="text-xs text-faint">负</p>
				<p class="mt-1 font-display text-2xl text-muted">{team.losses}</p>
			</div>
			<div class="rounded-xl border border-line bg-surface px-4 py-3">
				<p class="text-xs text-faint">胜率</p>
				<p class="mt-1 font-display text-2xl">{winRate === null ? '—' : `${winRate}%`}</p>
			</div>
		</div>

		{
			roster ? (
				<section class="mt-10">
					<div class="flex flex-wrap items-baseline justify-between gap-2">
						<h2 class="font-display text-xl">队员名单</h2>
						<a
							href={`https://www.opendota.com/teams/${roster.teamId}`}
							target="_blank"
							rel="noopener noreferrer"
							class="text-xs text-faint transition hover:text-gold"
						>
							数据来自 OpenDota ↗
						</a>
					</div>
					<div class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2">
						{roster.members.map((member) => (
							<div class="flex items-center gap-3 rounded-xl border border-line bg-surface px-4 py-3">
								<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-line bg-surface-2 text-[10px] font-semibold text-faint">
									{initial(member.name)}
								</span>
								<span class="min-w-0 flex-1">
									<span class="flex items-center gap-1.5">
										<span class="min-w-0 truncate text-sm text-cream">{member.name}</span>
										{member.isCurrent ? (
											<span class="shrink-0 rounded bg-dota/15 px-1.5 py-0.5 text-[10px] text-dota-light">在队</span>
										) : null}
									</span>
									<span class="mt-0.5 block text-xs text-faint">
										{member.games} 场 · 胜率 {member.games > 0 ? Math.round((member.wins / member.games) * 100) : 0}%
									</span>
								</span>
							</div>
						))}
					</div>
				</section>
			) : (
				<p class="mt-10 border-t border-line pt-6 text-xs text-faint">
					该队暂无队员数据：只有被 OpenDota 收录的职业队伍才能提供阵容。
				</p>
			)
		}

		{
			scheduled.length > 0 ? (
				<section class="mt-10">
					<h2 class="font-display text-xl">即将进行</h2>
					<div class="mt-4 grid grid-cols-1 gap-3 lg:grid-cols-2">
						{scheduled.map((match) => (
							<MatchRow match={match} now={now} showEvent />
						))}
					</div>
				</section>
			) : null
		}

		{
			finished.length > 0 ? (
				<section class="mt-10">
					<h2 class="font-display text-xl">历史赛果</h2>
					<div class="mt-4 grid grid-cols-1 gap-3 lg:grid-cols-2">
						{finished.map((match) => (
							<MatchRow match={match} now={now} showEvent />
						))}
					</div>
				</section>
			) : null
		}

		{
			team.events.length > 0 ? (
				<section class="mt-10">
					<h2 class="font-display text-xl">参赛赛事</h2>
					<div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
						{team.events.map((event) => (
							<a
								href={`/tournaments/${event.id}`}
								class="flex items-center justify-between gap-3 rounded-xl border border-line bg-surface px-4 py-3 transition hover:border-dota/40 hover:bg-surface-2"
							>
								<span class="min-w-0">
									<span class="block truncate text-sm text-cream">{event.name}</span>
									<span class="mt-1 block text-xs text-faint">{formatRange(event.startTime, event.endTime)}</span>
								</span>
								<span class:list={['shrink-0 rounded-md px-2 py-0.5 text-xs font-semibold', EVENT_STATUS_META[event.status].cls]}>
									{EVENT_STATUS_META[event.status].label}
								</span>
							</a>
						))}
					</div>
				</section>
			) : null
		}
	</section>
</Layout>
