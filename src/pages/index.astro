---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import LiveCard from '../components/LiveCard.astro';
import NewsCard from '../components/NewsCard.astro';
import TournamentCard from '../components/TournamentCard.astro';
import { OB_MEMBERS } from '../data/ob';
import { getTournaments } from '../lib/tournamentsApi';
import { fetchLiveSnapshot } from '../lib/liveApi';
import { fetchOfficialNews, toNewsCard } from '../lib/newsApi';
import { fetchCommunityThreads } from '../lib/ngaApi';
import { fetchPatchUpdates } from '../lib/patchesApi';

/** 首页只放两条官方新闻；取不到（离线且无缓存）时整块不展示。 */
let featuredNews: import('../data/types').NewsCardItem[] = [];
try {
	const official = await fetchOfficialNews();
	featuredNews = official.slice(0, 2).map((item) => toNewsCard(item, true));
} catch {
	featuredNews = [];
}

/** 社区热议取 24 小时榜的前几条，同样取不到就不展示。 */
let hotThreads: import('../lib/ngaApi').CommunityThread[] = [];
try {
	hotThreads = (await fetchCommunityThreads()).filter((thread) => thread.windows.includes(1)).slice(0, 5);
} catch {
	hotThreads = [];
}
/** 最新版本取官方「更新日志」列表的第一条（列表按时间倒序）；取不到就不展示。 */
let latestPatch: import('../lib/patchesApi').PatchUpdate | null = null;
try {
	latestPatch = (await fetchPatchUpdates(1))[0] ?? null;
} catch {
	latestPatch = null;
}

const bundle = await getTournaments();
/** 首页直播条只放构建期确实在播的人；拿不到状态就整块不展示，不编造。 */
const liveSnapshot = await fetchLiveSnapshot();
const liveMembers = OB_MEMBERS.filter((m) => {
	const s = liveSnapshot.statuses[`${m.platform}:${m.roomId}`];
	return s?.state === 'live' && !s.roomRetaken;
});
// 时间格式化工具统一使用 Unix 秒，Date.now() 是毫秒。
const now = Math.floor(Date.now() / 1000);
const notFinished = bundle.events.filter((e) => e.status !== 'completed');
const upcoming = (notFinished.length > 0 ? notFinished : bundle.events).slice(0, 3);

const FEATURES = [
	{ href: '/live', title: '分屏直播', desc: '在一个页面聚合观看多位 OB 主播，自由切换分屏布局。', icon: 'screen' },
	{ href: '/ob', title: 'OB 大家庭', desc: 'OB 十人名单、真实姓名、荣誉、直播间与开播状态快照。', icon: 'users' },
	{ href: '/news', title: '官方新闻', desc: 'DOTA2 官网资讯与赛事动态，正文在站内直接阅读。', icon: 'news' },
	{ href: '/community', title: '社区热帖', desc: '汇总 NGA 刀塔版块的热帖榜，跟着社区追当前最热的讨论。', icon: 'chat' },
	{ href: '/tournaments', title: '官方赛事', desc: 'TI、Major、ESL 等大赛赛程、奖金与直播状态一览。', icon: 'trophy' },
	{ href: '/patches', title: '版本信息', desc: '跟踪最新版本号、平衡性改动与后续更新前瞻。', icon: 'patch' },
	{ href: '/heroes', title: '英雄与装备', desc: '查阅英雄属性、定位与主流出装思路。', icon: 'sword' },
] as const;
---

<Layout>
	<!-- Hero -->
	<section class="relative overflow-hidden">
		<div class="pointer-events-none absolute -top-24 right-0 h-96 w-96 rounded-full bg-dota/20 blur-[120px]"></div>
		<div class="pointer-events-none absolute bottom-0 left-0 h-72 w-72 rounded-full bg-gold/10 blur-[120px]"></div>
		<div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
			<div class="max-w-3xl">
				<span class="inline-flex items-center gap-2 rounded-full border border-dota/40 bg-dota/10 px-3 py-1 text-xs font-medium text-dota-light">
					<span class:list={['h-1.5 w-1.5 rounded-full bg-dota-light', liveMembers.length > 0 && 'animate-pulse']}></span>
					{liveMembers.length > 0 ? `OB 天团 · ${liveMembers.length} 位正在直播` : 'OB 大家庭 · 十位老将'}
				</span>
				<h1 class="mt-6 font-display text-4xl leading-tight sm:text-5xl lg:text-6xl">
					DOTA2
					<span class="block text-dota-light">一站式玩家驿站</span>
				</h1>
				<p class="mt-5 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
					聚合 OB 大家庭直播、网页端多路分屏、官方新闻与赛事、版本更新，以及英雄装备资料。
					让每一次打开，都能跟上刀塔世界的最新脉搏。
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a href="/live" class="group inline-flex items-center gap-2 rounded-lg bg-dota px-5 py-3 font-medium text-white shadow-lg shadow-dota/30 transition hover:bg-dota-light">
						进入分屏直播
						<svg class="transition group-hover:translate-x-0.5" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</a>
					<a href="/ob" class="inline-flex items-center gap-2 rounded-lg border border-line px-5 py-3 font-medium text-cream transition hover:border-dota hover:text-dota-light">
						看 OB 大家庭
					</a>
					<a href="/heroes" class="inline-flex items-center gap-2 rounded-lg border border-line px-5 py-3 font-medium text-cream transition hover:border-dota hover:text-dota-light">
						英雄资料
					</a>
				</div>
			</div>

			<!-- Live now strip -->
			<div class="mt-12 rounded-2xl border border-line bg-surface/60 p-5 backdrop-blur">
				<div class="mb-4 flex items-center justify-between">
					<h2 class="flex items-center gap-2 font-display text-lg">
						<span
							class:list={[
								'flex h-2.5 w-2.5 rounded-full',
								liveMembers.length > 0 ? 'animate-pulse bg-[#22c55e]' : 'bg-zinc-500',
							]}
						></span>
						{liveMembers.length > 0 ? '正在直播' : '开播状态'}
					</h2>
					<a href="/live" class="text-sm text-dota-light transition hover:text-gold">全部直播 →</a>
				</div>
				<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
					{liveMembers.slice(0, 4).map((m) => <LiveCard member={m} live={liveSnapshot.statuses[`${m.platform}:${m.roomId}`]} />)}
					{liveMembers.length === 0 && (
						<p class="col-span-full rounded-xl border border-line bg-ink/60 p-4 text-sm text-muted">
							这个构建时刻没有抓到正在开播的房间。开播状态是构建期快照，可能只是恰好都没在播——
							<a href="/ob" class="text-dota-light hover:text-gold">去 OB 大家庭</a> 可以看每个人的固定直播间。
						</p>
					)}
				</div>
			</div>
		</div>
	</section>

	<!-- Features -->
	<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
		<SectionHeader eyebrow="站点板块" title="你想看的，都在这里" subtitle="七大板块随心探索，覆盖直播、资讯、社区、赛事与资料。" />
		<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{FEATURES.map((f) => (
				<a href={f.href} class="group flex flex-col rounded-2xl border border-line bg-surface p-6 transition hover:-translate-y-0.5 hover:border-dota/50 hover:bg-surface-2">
					<span class="flex h-11 w-11 items-center justify-center rounded-lg bg-dota/15 text-dota-light transition group-hover:bg-dota group-hover:text-white">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							{f.icon === 'screen' && <path d="M3 5h18v11H3zM8 20h8M12 16v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />}
							{f.icon === 'users' && <path d="M16 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM2 20a6 6 0 0 1 12 0M13 20a6 6 0 0 1 12 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />}
							{f.icon === 'news' && <path d="M4 4h16v16H4zM8 8h8M8 12h8M8 16h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />}
							{f.icon === 'trophy' && <path d="M8 4h8v4a4 4 0 0 1-8 0zM8 5H4v2a3 3 0 0 0 3 3M16 5h4v2a3 3 0 0 1-3 3M12 12v4M8 20h8M9 20v-2h6v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />}
							{f.icon === 'patch' && <path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6zM9 12l2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />}
							{f.icon === 'chat' && <path d="M4 5h16v11H9l-5 4zM8 9h8M8 12h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />}
							{f.icon === 'sword' && <path d="M14 4l6 6-9 9-5 1 1-5zM4 20l3-3M12 6l6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />}
						</svg>
					</span>
					<h3 class="mt-4 font-display text-lg">{f.title}</h3>
					<p class="mt-2 text-sm leading-relaxed text-muted">{f.desc}</p>
				</a>
			))}
		</div>
	</section>

	<!-- News preview -->
	{
		featuredNews.length > 0 ? (
			<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
				<SectionHeader eyebrow="资讯" title="最新资讯" href="/news" linkText="全部资讯" />
				<div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
					{featuredNews.map((n) => (
						<NewsCard item={n} />
					))}
				</div>
			</section>
		) : null
	}

	<!-- Community hot threads -->
	{
		hotThreads.length > 0 ? (
			<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
				<SectionHeader eyebrow="社区" title="社区热议" href="/community" linkText="全部热帖" />
				<ol class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-surface">
					{hotThreads.map((thread, index) => (
						<li>
							<a href={`/community/nga/${thread.tid}`} class="group flex items-center gap-4 px-4 py-3 transition hover:bg-surface-2">
								<span class="w-5 shrink-0 text-center font-display text-sm text-faint">{index + 1}</span>
								<span class="min-w-0 flex-1 truncate text-sm text-cream transition group-hover:text-dota-light">{thread.title}</span>
								<span class="hidden shrink-0 text-xs text-faint sm:inline">{thread.author}</span>
								<span class="shrink-0 rounded bg-gold/15 px-2 py-0.5 text-xs font-semibold text-gold" title="回复数">
									{thread.replies}
								</span>
							</a>
						</li>
					))}
				</ol>
			</section>
		) : null
	}

	<!-- Upcoming tournaments -->
	<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
		<SectionHeader eyebrow="赛事" title="近期官方赛事" href="/tournaments" linkText="全部赛事" />
			<div class="grid grid-cols-1 gap-4 md:grid-cols-3">
				{upcoming.map((t) => <TournamentCard event={t} now={now} />)}
			</div>
	</section>

	<!-- Latest patch -->
	<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
		<SectionHeader eyebrow="版本" title="最新版本动态" href="/patches" linkText="全部版本" />
		{
			latestPatch ? (
				<a
					href={`/patches/${latestPatch.id}`}
					class="group flex items-center gap-5 overflow-hidden rounded-2xl border border-line bg-surface p-6 transition hover:border-dota/50 hover:bg-surface-2"
				>
					{latestPatch.img ? (
						<img
							src={latestPatch.img}
							alt=""
							loading="lazy"
							referrerpolicy="no-referrer"
							class="h-24 w-24 shrink-0 rounded-xl border border-line object-cover"
						/>
					) : (
						<span class="flex h-24 w-24 shrink-0 items-center justify-center rounded-xl bg-surface-2 font-display text-lg text-gold">
							{latestPatch.version}
						</span>
					)}
					<span class="min-w-0 flex-1">
						<span class="flex flex-wrap items-center gap-2">
							<span class="font-display text-3xl text-gold">{latestPatch.version || '版本更新'}</span>
							<span class="rounded-md bg-dota/15 px-2 py-0.5 text-xs font-semibold text-dota-light">最新更新日志</span>
						</span>
						<span class="mt-1.5 block truncate text-sm text-cream">{latestPatch.title}</span>
						<span class="mt-0.5 block text-xs text-muted">{latestPatch.date} · 来源：DOTA2 官网</span>
					</span>
					<svg
						class="h-5 w-5 shrink-0 text-faint transition group-hover:translate-x-0.5 group-hover:text-gold"
						width="22"
						height="22"
						viewBox="0 0 24 24"
						fill="none"
						aria-hidden="true"
					>
						<path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</a>
			) : (
				<p class="rounded-2xl border border-line bg-surface px-6 py-10 text-center text-sm text-muted">
					暂时取不到官方更新日志，稍后会重试。
				</p>
			)
		}
	</section>
</Layout>
