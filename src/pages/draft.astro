---
import Layout from '../layouts/Layout.astro';
import { loadDraftData } from '../lib/draftData';
import { formatMatchTime } from '../lib/format';
import { ATTRIBUTE_ICON } from '../lib/heroApi';
import { getTournaments } from '../lib/tournamentsApi';
import type { EsportsMatch } from '../data/types';

/**
 * 阵容分析：观赛时手动录 BP，再由数据层与模型一起给出建议。
 *
 * 页面本身是静态的，英雄数据与号位胜率在构建期写进来（见 `lib/draftData.ts`），
 * 唯一的运行时外部依赖是用户自己的 DeepSeek key，直接从浏览器发出去，服务端不经手。
 */

const data = await loadDraftData();
const payload = JSON.stringify(data);

/**
 * 比赛选择器用的赛程快照。
 *
 * 这是构建期的：跟站内赛程页一样不会自己刷新。观赛时通常已经知道自己看的是哪场，
 * 所以它只是省去打字的入口，选不到就手输队名。
 */
const bundle = await getTournaments();
const now = Math.floor(Date.now() / 1000);
const byId = new Map<string, EsportsMatch>();
for (const match of [...bundle.live, ...bundle.events.flatMap((event) => event.matches ?? [])]) {
	if (!byId.has(match.id)) byId.set(match.id, match);
}
/** 排序：进行中 → 未开赛（近的在前）→ 已结束（新的在前）。 */
const statusRank = (match: EsportsMatch): number => (match.status === 'live' ? 0 : match.status === 'upcoming' ? 1 : 2);
const matches = [...byId.values()]
	.sort((a, b) => statusRank(a) - statusRank(b) || (statusRank(a) === 2 ? b.startTime - a.startTime : a.startTime - b.startTime))
	.slice(0, 24);
const matchLabel = (match: EsportsMatch): string => {
	const status = match.status === 'live' ? '进行中' : match.startTime > now ? '未开赛' : '已结束';
	/**
	 * 实时接口给的比赛偶尔没有开赛时间（`startTime` 是 0），直接算会得到 NaN，
	 * 格式化函数会抛 RangeError 把整页构建打断，所以这里先挡住。
	 */
	if (!Number.isFinite(match.startTime) || match.startTime <= 0) return `${match.home.name} vs ${match.away.name} · ${match.eventName} · ${status}`;
	const time =
		status === '未开赛'
			? formatMatchTime(match.startTime, now)
			: `${Math.abs(Math.round((now - match.startTime) / 3600))} 小时${status === '进行中' ? '前开赛' : '前'}`;
	return `${match.home.name} vs ${match.away.name} · ${match.eventName} · ${time}`;
};

/**
 * 赛程里的队伍 id 有两种来源：走 OpenDota 的那条线是 `od-team-<数字 id>`，可以直接用；
 * 别的来源（Liquipedia 那条线）没有 id，就不写这个属性——前端会回落到按队名查
 * `/draft-teams.json`。**不在这里猜 id**：猜错等于把别人的 BP 习惯装到这场对手头上。
 */
const teamIdOf = (team: { id: string }): string => /^od-team-(\d+)$/.exec(team.id)?.[1] ?? '';
---

<Layout
	title="阵容分析 · DOTA2 驿站"
	description="队长模式的 BP 陪练台：手动录入双方 ban/pick，按号位胜率给出建议，可选用自己的 DeepSeek key 让模型解释每一手。"
>
	<section class="draft-page mx-auto max-w-[1800px] px-4 py-8 sm:px-6 lg:px-8">
		<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
			<div>
				<p class="text-xs font-semibold uppercase tracking-[0.2em] text-dota-light">阵容分析</p>
				<h1 class="mt-2 font-display text-3xl sm:text-4xl">BP 陪练台</h1>
				<p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">
					看比赛时把双方的 ban/pick 点进来，轮到你这边时看建议。顺序按 7.40 起的队长模式：24 手、每队 7 禁 5 选，
					后选方握着最后一手禁用和最后一手挑选。号位胜率取 {data.bracketLabel}近 {data.windowDays} 天的统计。
				</p>
			</div>
			<div class="flex flex-wrap items-center gap-2 text-xs">
				<span class:list={['rounded-full border px-3 py-1', data.hasPositionData ? 'border-line text-muted' : 'border-dota/50 text-dota-light']}>
					{data.hasPositionData ? `号位样本覆盖 ${data.heroes.length} 个英雄` : '号位样本缺失，建议只看职业热度'}
				</span>
				<span class="rounded-full border border-line px-3 py-1 text-muted">
					职业样本 {data.proSample.picks} 出场 / {data.proSample.bans} 被禁
				</span>
				{data.matchupPairs > 0 ? (
					<span class="rounded-full border border-line px-3 py-1 text-muted">对位 {data.matchupPairs.toLocaleString('zh-CN')} 对</span>
				) : null}
				{data.patch.version ? (
					<span class:list={['rounded-full border px-3 py-1', data.patch.straddles ? 'border-gold-deep text-gold' : 'border-line text-muted']}>
						版本 {data.patch.version}
						{data.patch.straddles ? ' · 样本跨版本' : ''}
					</span>
				) : null}
			</div>
		</div>

		<!-- 控制条 -->
		<div class="mb-5 flex flex-wrap items-center gap-x-4 gap-y-3 rounded-2xl border border-line bg-surface/60 px-4 py-3">
			<!--
				下拉的宽度不能交给 min-width 决定：原生 select 会按最长的 option 撑开（比赛名加赛事名很长），
				在窄屏上直接把整页顶出横向滚动条。这里限定成"窄屏占满、宽屏固定"。
			-->
			<label class="flex w-full min-w-0 items-center gap-2 text-xs text-muted sm:w-auto">
				选比赛
				<select id="draft-match" class="w-full min-w-0 flex-1 rounded-lg border border-line bg-surface-2 px-2 py-1.5 text-xs text-cream sm:w-72 sm:flex-none">
					<option value="">不选，手动填队名</option>
					{matches.map((match) => (
						<option value={match.id} data-home={match.home.name} data-away={match.away.name} data-home-id={teamIdOf(match.home)} data-away-id={teamIdOf(match.away)}>
							{matchLabel(match)}
						</option>
					))}
				</select>
			</label>

			<label class="flex items-center gap-2 text-xs text-muted">
				我方
				<input id="draft-our-team" type="text" maxlength="24" placeholder="留空也行" class="w-36 rounded-lg border border-line bg-surface-2 px-2 py-1.5 text-xs text-cream placeholder:text-faint" />
			</label>
			<label class="flex items-center gap-2 text-xs text-muted">
				对方
				<input id="draft-their-team" type="text" maxlength="24" placeholder="留空也行" class="w-36 rounded-lg border border-line bg-surface-2 px-2 py-1.5 text-xs text-cream placeholder:text-faint" />
			</label>

			<div class="flex items-center gap-2 text-xs text-muted" role="group" aria-label="我方阵营" data-bp-only>
				<span>我方阵营</span>
				<button type="button" data-side="radiant" class="filter-chip">天辉</button>
				<button type="button" data-side="dire" class="filter-chip">夜魇</button>
			</div>
			<div class="flex items-center gap-2 text-xs text-muted" role="group" aria-label="先选权" data-bp-only>
				<span>先选权</span>
				<button type="button" data-first-pick="ours" class="filter-chip">我方</button>
				<button type="button" data-first-pick="theirs" class="filter-chip">对方</button>
			</div>
			<!--
				跳过 BP：不走 24 手禁用/挑选，直接给两边各挑五个英雄再看对比。
				给"只想复盘一套阵容"和"已经知道两边选了什么"这两种场景用。
			-->
			<label class="flex items-center gap-2 text-xs text-muted" title="不走 24 手 ban/pick，直接给两边各选五个英雄">
				<input id="draft-direct-mode" type="checkbox" class="h-3.5 w-3.5 accent-[#c6522c]" />
				直接选阵容
			</label>
			<label class="flex items-center gap-2 text-xs text-muted" data-bp-only>
				<input id="draft-ai-side" type="checkbox" class="h-3.5 w-3.5 accent-[#c6522c]" />
				对面交给 AI
			</label>

			<div class="ml-auto flex items-center gap-2" data-bp-only>
				<button id="draft-undo" type="button" class="filter-chip">撤销</button>
				<button id="draft-skip" type="button" class="filter-chip">跳过这手</button>
				<button id="draft-reset" type="button" class="filter-chip">清空</button>
			</div>
		</div>

		<!--
			「对面擅长什么」那行：只有指定了对方队名、而且真取到数据时才出现。
			初值用内联 display 而不是留空元素——空段落在版面里照样占一段间距。
		-->
		<p id="draft-foe-status" class="mb-4 text-xs leading-relaxed text-muted" style="display: none"></p>

		<!--
			阵容复盘：双方各五个号位都落人之后才开放（脚本控制 disabled）。
			放在两种模式都能看到的位置——「直接选阵容」那条路没有逐手建议，这里就是主输出。
		-->
		<div class="mb-5 flex flex-wrap items-center gap-3">
			<button id="draft-verdict" type="button" class="filter-chip" disabled>分析双方阵容</button>
			<span id="draft-verdict-status" class="text-xs text-faint" role="status" aria-live="polite"></span>
		</div>
		<div id="draft-verdict-box" class="mb-5" style="display: none"></div>

		<!-- 当前手 -->
		<div id="draft-banner" class="mb-5 flex flex-wrap items-center gap-x-4 gap-y-2 rounded-2xl border border-line bg-surface-2/70 px-4 py-3 text-sm" role="status" aria-live="polite">
			<span id="draft-banner-step" class="font-display text-lg text-gold">第 1 手</span>
			<span id="draft-banner-turn" class="text-cream">我方禁用</span>
			<span id="draft-banner-detail" class="text-xs text-faint"></span>
		</div>

		<div class="grid grid-cols-1 items-start gap-5 xl:grid-cols-[minmax(0,1fr)_360px]">
			<!--
				左列：英雄池 + 建议。建议紧挨着池子放，因为候选卡片点一下就是录入这一手，
				眼睛和鼠标都不用跑到另一栏去；顺带把左列的高度撑起来，跟右边的 BP 板差不多齐。
			-->
			<div class="flex min-w-0 flex-col gap-5">
				<!-- 英雄池 -->
				<div id="draft-pool-panel" class="rounded-2xl border border-line bg-surface/60 p-4">
				<div class="mb-3 flex flex-wrap items-center gap-x-6 gap-y-3">
					<label class="flex items-center gap-2 text-xs text-muted">
						搜索
						<input id="draft-search" type="search" placeholder="英雄名或英文名" class="w-40 rounded-lg border border-line bg-surface-2 px-2 py-1.5 text-xs text-cream placeholder:text-faint" />
					</label>
					<div class="flex items-center gap-2 text-xs text-muted" role="group" aria-label="按属性筛选">
						<span>属性</span>
						<button type="button" data-attr="all" class="filter-chip" aria-pressed="true">全部</button>
						<button type="button" data-attr="STR" class="filter-chip" aria-pressed="false" title="力量英雄">
							<img src={ATTRIBUTE_ICON.STR} alt="" loading="lazy" referrerpolicy="no-referrer" />力量
						</button>
						<button type="button" data-attr="AGI" class="filter-chip" aria-pressed="false" title="敏捷英雄">
							<img src={ATTRIBUTE_ICON.AGI} alt="" loading="lazy" referrerpolicy="no-referrer" />敏捷
						</button>
						<button type="button" data-attr="INT" class="filter-chip" aria-pressed="false" title="智力英雄">
							<img src={ATTRIBUTE_ICON.INT} alt="" loading="lazy" referrerpolicy="no-referrer" />智力
						</button>
						<button type="button" data-attr="UNI" class="filter-chip" aria-pressed="false" title="全才英雄">
							<img src={ATTRIBUTE_ICON.UNI} alt="" loading="lazy" referrerpolicy="no-referrer" />全才
						</button>
					</div>
					<div class="flex items-center gap-2 text-xs text-muted" role="group" aria-label="按号位筛选">
						<span>号位</span>
						<button type="button" data-position="all" class="filter-chip" aria-pressed="true">全部</button>
						{[1, 2, 3, 4, 5].map((position) => (
							<button type="button" data-position={position} class="filter-chip" aria-pressed="false" title={`只看有 ${position} 号位样本的英雄`}>{position}</button>
						))}
					</div>
					<span id="draft-pool-count" class="ml-auto text-xs text-faint"></span>
				</div>
					<div id="draft-pool" class="pool-root" aria-label="英雄池"></div>
					<p id="draft-pool-hint" class="mt-3 text-xs text-faint"></p>
				</div>

				<!-- 建议 -->
				<section id="draft-advice-panel" class="rounded-2xl border border-line bg-surface/60 p-4" aria-label="建议">
					<!--
						轮到对面时这块是主界面：AI 替对面落子。默认自动出招，想自己代打就取消上面的勾选，
						这时按钮会露出来，由人点一下。
					-->
					<div id="draft-ai-move" class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2 rounded-xl border border-line bg-surface-2/60 px-3 py-2 text-sm" style="display: none">
						<span id="draft-ai-who" class="text-cream"></span>
						<span id="draft-ai-status" class="text-xs text-faint" role="status" aria-live="polite"></span>
						<button id="draft-ai-play" type="button" class="filter-chip" style="display: none">让 AI 走这一手</button>
					</div>
					<div class="flex flex-wrap items-center gap-3">
						<button id="draft-advice-toggle" type="button" class="filter-chip" aria-expanded="false" aria-controls="draft-advice-body">看建议（不剧透）</button>
						<!-- 初值用内联 style：Tailwind 的 `hidden` 类优先级更高，脚本摘不掉，元素会永远是隐藏的。 -->
						<button id="draft-advice-ai" type="button" class="filter-chip" style="display: none">让 AI 解释这几手</button>
						<span id="draft-advice-status" class="text-xs text-faint" role="status" aria-live="polite"></span>
					</div>
					<div id="draft-advice-body" style="display: none">
						<p id="draft-advice-summary" class="mt-4 text-sm text-cream"></p>
						<p id="draft-composition" class="mt-2 text-xs text-faint"></p>
						<div id="draft-lineup" class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-5"></div>
						<div id="draft-advice-cards" class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-3"></div>
					</div>
				</section>
			</div>

			<!--
				直接选阵容：跳过 24 手 BP，两边各挑五个英雄。
				「填我方 / 填对方」决定下一次点英雄池往哪边放；格子点了就把人移出去。
			-->
			<div id="draft-direct-panel" class="rounded-2xl border border-line bg-surface/60 p-4" style="display: none">
				<div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-muted">
					<span>点英雄池里的英雄，填到</span>
					<button type="button" id="draft-direct-ours" class="filter-chip" aria-pressed="true">我方</button>
					<button type="button" id="draft-direct-theirs" class="filter-chip" aria-pressed="false">对方</button>
					<span id="draft-direct-hint" class="text-faint" role="status" aria-live="polite"></span>
				</div>
				<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
					<div>
						<p id="draft-direct-label-ours" class="mb-2 text-xs font-semibold text-gold">我方阵容</p>
						<div id="draft-direct-slots-ours" class="grid grid-cols-5 gap-2"></div>
					</div>
					<div>
						<p id="draft-direct-label-theirs" class="mb-2 text-xs font-semibold text-dota-light">对方阵容</p>
						<div id="draft-direct-slots-theirs" class="grid grid-cols-5 gap-2"></div>
					</div>
				</div>
				<p class="mt-3 text-xs text-faint">点格子可以移除那个英雄；点英雄池里已经选中的英雄也能移除。两边各满五个，「分析双方阵容」就会亮。</p>
			</div>

			<!-- BP 板 -->
			<div id="draft-board-panel" class="draft-board rounded-2xl border border-line bg-surface/60 p-4">
				<!--
					照客户端的排法：两侧是阵营列，中间夹一列手号，**一行一手**按顺序往下走。
					禁用和挑选不是两段，而是在同一列里按手号混排：禁用格打叉变灰，挑选格是头像。
				-->
				<div class="draft-board-head">
					<p class="draft-side-label" data-side="radiant">
						<span class="draft-side-name" id="draft-label-radiant">天辉</span>
						<span class="draft-column-badge" id="draft-badge-radiant"></span>
					</p>
					<p class="draft-board-head-mid"></p>
					<p class="draft-side-label" data-side="dire">
						<span class="draft-side-name" id="draft-label-dire">夜魇</span>
						<span class="draft-column-badge" id="draft-badge-dire"></span>
					</p>
				</div>
				<div id="draft-board-grid" class="draft-board-grid"></div>
				<p class="mt-2 text-xs text-faint">一行一手，中间是手号；禁用打叉变灰，挑选是头像，顺序与客户端一致。</p>
			</div>
		</div>

		<!-- 设置 -->
		<section class="mt-5 rounded-2xl border border-line bg-surface/60 p-4" aria-label="设置">
			<h2 class="font-display text-lg">AI 解释（可选）</h2>
			<p class="mt-2 text-xs leading-relaxed text-muted">
				填自己的 DeepSeek key，请求从这台浏览器直接发给 DeepSeek，本站不经手也不保存。
				key 存在本机 localStorage 里，公共电脑上别存。没填也能用：上面的建议完全由站点数据算出。
			</p>
			<div class="mt-3 flex flex-wrap items-end gap-3">
				<label class="flex items-center gap-2 text-xs text-muted">
					API key
					<input id="draft-key" type="password" autocomplete="off" placeholder="sk-..." class="w-64 rounded-lg border border-line bg-surface-2 px-2 py-1.5 text-xs text-cream placeholder:text-faint" />
				</label>
				<label class="flex items-center gap-2 text-xs text-muted">
					模型
					<select id="draft-model" class="rounded-lg border border-line bg-surface-2 px-2 py-1.5 text-xs text-cream">
						<option value="deepseek-flash">deepseek-flash</option>
						<option value="deepseek-v4-pro">deepseek-v4-pro</option>
					</select>
				</label>
				<button id="draft-test" type="button" class="filter-chip">测试连接</button>
				<button id="draft-clear" type="button" class="filter-chip">清除 key</button>
				<span id="draft-key-state" class="text-xs text-faint"></span>
			</div>
		</section>

		<p class="mt-6 text-xs leading-relaxed text-faint">
			数据口径：号位胜率来自 STRATZ 的 {data.bracketLabel}统计（近 {data.windowDays} 天，单个号位少于 {data.minPositionMatches} 场不计），
			对应版本 {data.patch.version || '未知'}{data.patch.date ? `（${data.patch.date} 发布）` : ''}{data.patch.straddles ? '，这批样本跨了一次版本更新，胜率混着旧版本的场次' : ''}；
			职业出场与被禁来自 OpenDota 的职业样本，总量只有 {data.proSample.picks} 出场 / {data.proSample.bans} 被禁，只能当热度看。
			对位（谁好打谁）来自 STRATZ 的高分局统计，只按场次筛（≥ {data.matchupMinGames} 场，接近五五开的也留着），
			共 {data.matchupPairs.toLocaleString('zh-CN')} 对；它不区分分路，是个粗口径的克制信号。
			分路对位（线上谁打谁、和谁走一路）是另一份数据：同样来自 STRATZ 的高分局统计，按号位记录线上胜负，
			只留记了结果 ≥ {data.laneMinGames} 场的格子，单独加载；它只做横向对比，**不进上面的胜率**。
			建议是按号位胜率做的启发式估计，不是胜率预测，也不代表任何队伍的真实战术。
		</p>

		<noscript>
			<p class="mt-6 rounded-2xl border border-line bg-surface px-5 py-4 text-sm text-muted">
				BP 陪练台要靠 JavaScript 才能录入与计算。页面上方的英雄数据是构建期生成的，脚本被禁用时看不到。
			</p>
		</noscript>
	</section>

	<!-- 构建期数据：英雄、号位胜率、职业样本。用 is:inline 避免被当成模块打包。 -->
	<script type="application/json" id="draft-data" set:html={payload} is:inline />
</Layout>

<!--
	`is:global` 是必须的，不是图省事：英雄池、BP 格子、候选卡片这些节点都是脚本建出来的，
	而 Astro 默认会把样式编译成 `.hero-tile[data-astro-cid-xxx]` 这种带作用域属性的选择器，
	动态节点上没有这个属性，规则等于全部失效（实测症状：英雄格子退回 256px 的原始图片尺寸，
	BP 格子变成 31px 的小方块，整页被拉成七千多像素高）。

	不用再套一层 `.draft-page` 前缀：这个样式块只属于本页，打包出来只在 /draft 加载，
	`.filter-chip` 虽然在英雄页和装备页也有同名类，但那边各有自己的作用域规则，互不影响。
-->
<style is:global>
	.filter-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		border: 1px solid var(--color-line);
		border-radius: 0.5rem;
		padding: 0.35rem 0.6rem;
		font-size: 0.75rem;
		color: var(--color-muted);
		background: var(--color-surface-2);
		transition: color 0.12s ease-in-out, border-color 0.12s ease-in-out;
	}
	.filter-chip:hover {
		color: var(--color-cream);
		border-color: var(--color-gold-deep);
	}
	.filter-chip[aria-pressed='true'] {
		color: var(--color-cream);
		border-color: var(--color-dota);
		background: color-mix(in srgb, var(--color-dota) 22%, var(--color-surface-2));
	}
	.filter-chip:disabled {
		opacity: 0.4;
	}

	/*
	 * BP 板照客户端的排法：天辉一列、夜魇一列，中间夹一列手号，一行一手。
	 * 禁用与挑选在**同一列里**按手号混排（禁用格打叉变灰、挑选格是头像），
	 * 而不是先排完七个禁用再排五个挑选。
	 */
	.draft-page .draft-board {
		--radiant-color: #62a86f;
		--dire-color: var(--color-dota);
	}
	.draft-page .draft-board-head,
	.draft-page .draft-row {
		display: grid;
		/* 两侧等宽，中间固定给手号：三列对齐，行与行之间才是齐的。 */
		grid-template-columns: minmax(0, 1fr) 2.5rem minmax(0, 1fr);
		gap: 0.25rem;
	}
	.draft-page .draft-board-head {
		align-items: end;
		margin-bottom: 0.375rem;
	}
	.draft-page .draft-side-label {
		display: flex;
		align-items: baseline;
		gap: 0.35rem;
		font-size: 0.8rem;
		color: var(--color-cream);
	}
	.draft-page .draft-side-label[data-side='radiant'] .draft-side-name {
		color: var(--radiant-color);
	}
	.draft-page .draft-side-label[data-side='dire'] {
		grid-column: 3;
		justify-content: flex-end;
	}
	.draft-page .draft-side-label[data-side='dire'] .draft-side-name {
		color: var(--dire-color);
	}
	.draft-page .draft-column-badge {
		font-size: 0.65rem;
		color: var(--color-gold);
	}
	.draft-page .draft-board-grid {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}
	.draft-page .draft-row {
		align-items: stretch;
	}
	/*
	 * 框按客户端的实测尺寸写死：禁用 55×30、挑选 70×40。挑选框是禁用框整只放大一档的
	 * 观感，禁用只是个缩略图加个叉，挑选才是看阵容的地方。
	 * 两边都朝中间的手号列贴齐，尺寸变化只影响外侧那一半，手号列不会跟着晃。
	 */
	.draft-page .draft-row[data-action='ban'] {
		--cell-width: 55px;
		--cell-height: 30px;
	}
	.draft-page .draft-row[data-action='pick'] {
		--cell-width: 70px;
		--cell-height: 40px;
	}
	.draft-page .draft-row {
		/* 尺寸写死之后行不再伸缩，多出来的高度留给面板（左边会把它分到属性组之间）。 */
		flex: 0 0 auto;
	}
	/* 阶段之间留一道缝：禁用段与挑选段交替，看的时候能一眼分段。 */
	.draft-page .draft-row[data-phase-start='true'] {
		margin-top: 0.35rem;
	}
	.draft-page .draft-cell {
		position: relative;
		overflow: hidden;
		width: var(--cell-width, 100%);
		height: var(--cell-height, 30px);
		border-radius: 0.3rem;
		border: 1px solid var(--color-line);
		background: rgb(0 0 0 / 0.35);
	}
	.draft-page .draft-cell[data-side='radiant'] {
		justify-self: end;
	}
	.draft-page .draft-cell[data-side='dire'] {
		justify-self: start;
	}
	.draft-page .draft-cell img {
		/*
		 * 绝对定位：格子的高度由行高（栅格）决定，头像只负责填满它。
		 * 用 `height: 100%` 的话，父元素高度不确定时百分比失效，图片会按自己的比例
		 * 把整行撑开（实测 24 行被撑到 1900px 高）。
		 */
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}
	.draft-page .draft-cell[data-state='filled'] {
		border-color: color-mix(in srgb, var(--cell-color, var(--color-line)) 70%, transparent);
	}
	/* 禁用：变灰再打一个叉，与客户端一致。 */
	.draft-page .draft-cell[data-action='ban'][data-state='filled'] img {
		/* 别压太狠：禁用格本来就矮，再压黑就只剩一团墨，认不出是哪个英雄。 */
		filter: brightness(0.68) saturate(0.8);
	}
	.draft-page .draft-cell[data-action='ban'][data-state='filled']::after {
		content: '✕';
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		font-size: 0.75rem;
		line-height: 1;
		color: #ff6b4a;
		text-shadow: 0 0 2px rgb(0 0 0 / 0.95), 0 0 5px rgb(0 0 0 / 0.9);
	}
	.draft-page .draft-cell[data-side='radiant'] {
		--cell-color: var(--radiant-color);
	}
	.draft-page .draft-cell[data-side='dire'] {
		--cell-color: var(--dire-color);
	}
	.draft-page .draft-step {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.05rem;
		font-size: 0.6rem;
		line-height: 1;
		color: var(--color-faint);
	}
	.draft-page .draft-step-action {
		font-size: 0.55rem;
	}
	.draft-page .draft-row[data-current='true'] .draft-step-action {
		font-size: 0.5rem;
	}
	.draft-page .draft-row[data-current='true'] .draft-step {
		color: var(--color-gold);
	}
	.draft-page .draft-row[data-current='true'] .draft-cell {
		border-color: var(--color-gold);
		box-shadow: 0 0 0 1px var(--color-gold);
	}

	/*
	 * 并排布局（xl 起）里让右边填满整列：面板会被栅格拉到与左边等高，
	 * 多出来的高度平均分给 24 行（有下限，别在小屏笔记本上压没）。
	 */
	@media (min-width: 1280px) {
		.draft-page .draft-board {
			display: flex;
			flex-direction: column;
		}
		.draft-page .draft-board-grid {
			flex: 1 1 auto;
			min-height: 0;
		}
	}

	.hero-tile {
		position: relative;
		overflow: hidden;
		/* 竖版头像：45×80，跟客户端的英雄池一样，脸在格子里认得出来。 */
		width: 45px;
		height: 80px;
		border-radius: 0.25rem;
		border: 1px solid var(--color-line);
		background: var(--color-surface-2);
		transition: border-color 0.12s ease-in-out, transform 0.12s ease-in-out;
	}

	.pool-root {
		/*
		 * 照客户端：四个属性各占一列并排，每列里是竖版头像墙。
		 * 第一版是四组上下堆叠，一屏只看得到半组，挑人要来回滚。
		 */
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		align-items: start;
		gap: 0.75rem;
	}
	.pool-group {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		min-width: 0;
	}
	.pool-group-title {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		color: var(--color-muted);
	}
	.pool-group-icon {
		width: 14px;
		height: 14px;
		flex: 0 0 auto;
	}
	/* 筛选按钮里的属性图标，比分组标题里的小一号。 */
	.filter-chip img {
		width: 12px;
		height: 12px;
		flex: 0 0 auto;
	}
	.pool-grid {
		display: grid;
		/* 定宽排：格子固定 45 宽，一行几个由列宽决定（1600 宽下每列六个）。 */
		grid-template-columns: repeat(auto-fill, 45px);
		justify-content: start;
		gap: 3px;
	}

	.advice-card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		border: 1px solid var(--color-line);
		border-radius: 0.75rem;
		background: var(--color-surface-2);
		padding: 0.75rem;
		text-align: left;
	}
	.advice-card:hover {
		border-color: var(--color-gold-deep);
	}
	.advice-card[disabled] {
		opacity: 0.55;
	}
	.lineup-slot {
		border: 1px solid var(--color-line);
		border-radius: 0.5rem;
		background: var(--color-surface-2);
		padding: 0.4rem 0.5rem;
		font-size: 0.7rem;
		color: var(--color-muted);
	}
	.lineup-slot[data-settled='true'] {
		border-color: var(--color-gold-deep);
		color: var(--color-cream);
	}
	.hero-tile:hover {
		border-color: var(--color-gold-deep);
		transform: translateY(-1px);
	}
	.hero-tile img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}
	.hero-tile-name {
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		padding: 0.1rem 0.15rem;
		font-size: 0.55rem;
		line-height: 1.2;
		/* 45px 宽塞四个字刚好，再长就省略，别把格子撑破。 */
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		color: var(--color-cream);
		background: linear-gradient(to top, rgb(0 0 0 / 0.72), rgb(0 0 0 / 0));
	}
	.hero-tile[data-used='ban'] {
		/* 与 BP 板上的禁用格同一档：再暗就认不出英雄了。 */
		filter: brightness(0.68) saturate(0.8);
	}
	.hero-tile[data-used='pick'] {
		filter: grayscale(0.6) brightness(0.7);
	}
	.hero-tile[data-used] .hero-tile-name::after {
		content: attr(data-used-label);
		display: block;
		font-size: 0.55rem;
		color: var(--color-gold);
	}
	/*
		直接选阵容的格子：空位是虚线框加号位数字，填上之后和英雄池的头像一样是竖版图。
		尺寸跟英雄池格子对齐（45×80 那一档），一眼能看出"这是个能放英雄的格子"。
	*/
	.direct-slot {
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 45 / 80;
		overflow: hidden;
		border: 1px dashed var(--color-line);
		border-radius: 0.4rem;
		background: var(--color-surface-2);
		cursor: pointer;
	}
	.direct-slot.is-filled {
		border-style: solid;
		border-color: var(--color-gold-deep);
	}
	.direct-slot img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}
	.direct-slot-number {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 100%;
		font-size: 0.75rem;
		color: var(--color-faint);
	}
	.direct-slot-name {
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		padding: 0.1rem 0.15rem;
		font-size: 0.55rem;
		line-height: 1.2;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		color: var(--color-cream);
		background: linear-gradient(to top, rgb(0 0 0 / 0.72), rgb(0 0 0 / 0));
	}
	.direct-slot:hover {
		border-color: var(--color-gold-deep);
	}

	@media (prefers-reduced-motion: reduce) {
		.draft-slot[data-current='true'] {
			box-shadow: 0 0 0 1px var(--color-gold);
		}
		.hero-tile:hover {
			transform: none;
		}
	}
</style>

<script>
	import '../scripts/draftBoard';
</script>
