---
import Layout from '../layouts/Layout.astro';
import { loadDraftData } from '../lib/draftData';
import { ATTRIBUTE_ICON } from '../lib/heroApi';
import { inlineJson } from '../lib/inlineJson';
import { loadDraftTeams } from '../lib/draftTeams';

/**
 * 阵容分析：三件事放在一页上——**预测**（这两队大概会怎么禁选）、**对抗**（你和 AI 轮流走 BP）、
 * **复盘**（两边阵容都定下来之后比一比）。
 *
 * 页面本身是静态的，英雄数据与号位胜率在构建期写进来（见 `lib/draftData.ts`），
 * 两支队伍来自门户名录（见 `lib/draftTeams.ts`），
 * 唯一的运行时外部依赖是用户自己填的模型 key，直接从浏览器发出去，服务端不经手。
 */

const data = await loadDraftData();
// 走 inlineJson 而不是裸 JSON.stringify：英雄名与队名来自第三方，`</script>` 会提前闭合脚本元素。
const payload = inlineJson(data);

/**
 * 两个选择框的选项，以及队伍卡片要用的那份资料（队标、名单、招牌英雄、OpenDota id）。
 *
 * 两处都用**服务端渲染 + 内联**，而不是让浏览器去 `/draft-teams.json` 取：
 * - 选项写进 HTML，脚本没跑（或还在下载）时两个框照样能选，选了也不会丢；
 * - 这份资料内联在页面里，选中队伍之后立刻就能画出队标、名单与招牌英雄。
 *   早先它是单独取的一份静态文件，取不到时页面只会显示"未指定队伍"——
 *   和"真的没选队"长得一模一样，用户根本看不出是数据没到（实测被这么误解过）。
 *   它 30 KB 上下，而页面本来就内联了 28 KB 的英雄数据，多这一份换掉一整条失败路径是划算的。
 *
 * `/draft-teams.json` 仍然保留，供程序取用（内容与这里的内联那份**完全一致**，同一个
 * `loadDraftTeams()` 单飞）；浏览器这边只把它当作内联缺失时的退路。
 */
const catalog = await loadDraftTeams();
const teamsPayload = inlineJson(catalog);
/** 按门户地区分组；不在门户里的那些（没有地区标签）统一放到最后。 */
const grouped = [...catalog.sections.map((section) => ({ label: section.label, teams: [] as typeof catalog.teams })), { label: '其他', teams: [] as typeof catalog.teams }];
for (const team of catalog.teams) {
	const index = catalog.sections.findIndex((section) => section.key === team.region);
	grouped[index >= 0 ? index : grouped.length - 1]!.teams.push(team);
}
const groups = grouped.filter((group) => group.teams.length > 0);
---

<Layout
	title="阵容分析 · DOTA2 驿站"
	description="队长模式的 BP 陪练台：手动录入双方 ban/pick，按号位胜率给出建议；不配模型也能用，配上自己的 key 可以让模型解释每一手。"
>
	<section class="draft-page mx-auto max-w-[1800px] px-4 py-8 sm:px-6 lg:px-8">
		<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
			<div>
				<p class="text-xs font-semibold uppercase tracking-[0.2em] text-dota-light">阵容分析</p>
				<h1 class="mt-2 font-display text-3xl sm:text-4xl">BP 陪练台</h1>
				<p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">
					选两支队伍，先看这两队的 BP 大概会怎么走；也可以自己坐在一边，和 AI 一手一手对着禁选；
					两边阵容定下来之后还能让数据层把这套对局比一遍。顺序按 7.40 起的队长模式：24 手、每队 7 禁 5 选，
					后选方握着最后一手禁用和最后一手挑选。号位胜率取 {data.bracketLabel}、{data.windowLabel}的统计。
				</p>
			</div>
			<div class="flex flex-wrap items-center gap-2 text-xs">
				<span class:list={['rounded-full border px-3 py-1', data.hasPositionData ? 'border-line text-muted' : 'border-dota/50 text-dota-light']}>
					{data.hasPositionData ? `号位样本覆盖 ${data.heroes.length} 个英雄` : '号位样本缺失，建议只看职业热度'}
				</span>
				<span class="rounded-full border border-line px-3 py-1 text-muted">
					职业样本 {data.proSample.picks} 出场 / {data.proSample.bans} 被禁
				</span>
				{data.matchupPairs > 0 ? (
					<span class="rounded-full border border-line px-3 py-1 text-muted">对位 {data.matchupPairs.toLocaleString('zh-CN')} 对</span>
				) : null}
				{data.patch.version ? (
					<span class:list={['rounded-full border px-3 py-1', data.patch.straddles ? 'border-gold-deep text-gold' : 'border-line text-muted']}>
						版本 {data.patch.version}
						{data.patch.straddles ? ' · 样本跨版本' : ''}
					</span>
				) : null}
			</div>
		</div>

		<!-- 控制条 -->
		<div class="mb-5 flex flex-wrap items-center gap-x-4 gap-y-3 rounded-2xl border border-line bg-surface/60 px-4 py-3">
			<!--
				两个下拉的宽度不能交给 min-width 决定：原生 select 会按最长的 option 撑开，
				在窄屏上直接把整页顶出横向滚动条。这里限定成"窄屏占满、宽屏固定"。
				默认的「未指定」不是空话：没选队伍时页面照样能录 BP，只是没有队标、名单与招牌英雄。
			-->
			<label class="flex w-full min-w-0 items-center gap-2 text-xs text-muted sm:w-auto">
				<span class="shrink-0 text-[#62a86f]">天辉</span>
				<select id="draft-radiant-team" class="w-full min-w-0 flex-1 rounded-lg border border-line bg-surface-2 px-2 py-1.5 text-xs text-cream sm:w-60 sm:flex-none">
					<option value="">未指定</option>
					{groups.map((group) => (
						<optgroup label={group.label}>
							{group.teams.map((team) => (
								<option value={team.id}>{team.name}</option>
							))}
						</optgroup>
					))}
				</select>
			</label>
			<label class="flex w-full min-w-0 items-center gap-2 text-xs text-muted sm:w-auto">
				<span class="shrink-0 text-dota-light">夜魇</span>
				<select id="draft-dire-team" class="w-full min-w-0 flex-1 rounded-lg border border-line bg-surface-2 px-2 py-1.5 text-xs text-cream sm:w-60 sm:flex-none">
					<option value="">未指定</option>
					{groups.map((group) => (
						<optgroup label={group.label}>
							{group.teams.map((team) => (
								<option value={team.id}>{team.name}</option>
							))}
						</optgroup>
					))}
				</select>
			</label>

			<div class="flex items-center gap-2 text-xs text-muted" role="group" aria-label="先选权" data-bp-only>
				<span>先选权</span>
				<button type="button" data-first-pick="radiant" class="filter-chip">天辉</button>
				<button type="button" data-first-pick="dire" class="filter-chip">夜魇</button>
			</div>
		</div>

		<!--
			三个功能是**并列的三块界面**，不是三个独立页面：队伍与先选权在上面共用，
			切来切去不会丢已经录进去的 BP。默认停在「AI 预测」，因为它是这一页最省事的用法。
			页签排在队伍卡片**前面**：手机上两张名单卡就有两三屏高，把切换藏到后面等于让人先滚一遍。
		-->
		<div class="mb-5 flex flex-wrap items-center gap-2" role="tablist" aria-label="功能">
			<button type="button" role="tab" id="draft-tab-predict" data-tab="predict" class="filter-chip" aria-pressed="true">AI 预测</button>
			<button type="button" role="tab" id="draft-tab-versus" data-tab="versus" class="filter-chip" aria-pressed="false">和 AI 的对手 BP</button>
			<button type="button" role="tab" id="draft-tab-lineup" data-tab="lineup" class="filter-chip" aria-pressed="false">阵容分析</button>
		</div>

		<!--
			两队的队标、名单与招牌英雄。构建期只把队名放进 `<option>`（原生下拉画不了图），
			这一块的内容由 `/draft-teams.json` 到位之后由脚本填；没选队伍时是「未指定队伍」的占位。
		-->
		<div id="draft-teams-preview" class="mb-5 grid grid-cols-1 gap-3 lg:grid-cols-2"></div>

		<!-- AI 预测：给这两支队推一份完整的禁选 -->
		<section id="draft-predict-panel" data-panel="predict" class="mb-5 rounded-2xl border border-line bg-surface/60 p-4" aria-label="AI 预测">
			<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
				<button id="draft-predict-run" type="button" class="filter-chip">预测整局 BP</button>
				<span id="draft-predict-status" class="text-xs text-faint" role="status" aria-live="polite"></span>
			</div>
			<div id="draft-predict-box" class="mt-4" style="display: none"></div>
		</section>

		<!--
			对抗模式的控制条与当前手。都是这一块专有：预测那条路不录 BP，复盘那条路自己填阵容。
		-->
		<div data-panel="versus" class="mb-5 flex flex-col gap-3">
			<div class="flex flex-wrap items-center gap-x-4 gap-y-3 rounded-2xl border border-line bg-surface/60 px-4 py-3">
				<div class="flex items-center gap-2 text-xs text-muted" role="group" aria-label="你打哪边">
					<span>你打哪边</span>
					<button type="button" data-my-side="radiant" class="filter-chip">天辉</button>
					<button type="button" data-my-side="dire" class="filter-chip">夜魇</button>
				</div>
				<label class="flex items-center gap-2 text-xs text-muted">
					<input id="draft-ai-side" type="checkbox" class="h-3.5 w-3.5 accent-[#c6522c]" />
					对面交给 AI
				</label>
				<!--
					开关旁边就写清它为什么是灰的。原因只在下面设置区里存一份等于没说——那个距离
					有一百多行，而且用户的第一反应是盯着这个点不动的开关。
				-->
				<span id="draft-ai-hint" class="text-xs text-faint" role="status" aria-live="polite"></span>
				<div class="ml-auto flex items-center gap-2">
					<button id="draft-undo" type="button" class="filter-chip">撤销</button>
					<button id="draft-skip" type="button" class="filter-chip">跳过这手</button>
					<button id="draft-reset" type="button" class="filter-chip">清空</button>
				</div>
			</div>

			<!-- 当前手 -->
			<div id="draft-banner" class="flex flex-wrap items-center gap-x-4 gap-y-2 rounded-2xl border border-line bg-surface-2/70 px-4 py-3 text-sm" role="status" aria-live="polite">
				<span id="draft-banner-step" class="font-display text-lg text-gold">第 1 手</span>
				<span id="draft-banner-turn" class="text-cream">天辉禁用</span>
				<span id="draft-banner-detail" class="text-xs text-faint"></span>
			</div>

			<!--
				「对面擅长什么」那行：只有指定了对方、而且真取到数据时才出现。
				初值用内联 display 而不是留空元素——空段落在版面里照样占一段间距。
			-->
			<p id="draft-foe-status" class="text-xs leading-relaxed text-muted" style="display: none"></p>
		</div>

		<!--
			阵容复盘：双方各五个号位都落人之后才开放（脚本控制 disabled）。
			结果**整幅宽度**给出来：那张对比表列了七八个维度，挤在半栏里读不了。
		-->
		<div data-panel="lineup" class="mb-5">
			<div class="flex flex-wrap items-center gap-3">
				<button id="draft-verdict" type="button" class="filter-chip" disabled>分析双方阵容</button>
				<span id="draft-verdict-status" class="text-xs text-faint" role="status" aria-live="polite"></span>
			</div>
			<div id="draft-verdict-box" class="mt-4" style="display: none"></div>
		</div>

		<div id="draft-grid" data-panel="workspace" class="grid grid-cols-1 items-start gap-5 xl:grid-cols-[minmax(0,1fr)_360px]">
			<!--
				左列：英雄池 + 建议。建议紧挨着池子放，因为候选卡片点一下就是录入这一手，
				眼睛和鼠标都不用跑到另一栏去；顺带把左列的高度撑起来，跟右边的 BP 板差不多齐。
			-->
			<div class="flex min-w-0 flex-col gap-5">
				<!-- 英雄池 -->
				<div id="draft-pool-panel" class="rounded-2xl border border-line bg-surface/60 p-4">
				<div class="mb-3 flex flex-wrap items-center gap-x-6 gap-y-3">
					<label class="flex items-center gap-2 text-xs text-muted">
						搜索
						<input id="draft-search" type="search" placeholder="英雄名或英文名" class="w-40 rounded-lg border border-line bg-surface-2 px-2 py-1.5 text-xs text-cream placeholder:text-faint" />
					</label>
					<div class="flex items-center gap-2 text-xs text-muted" role="group" aria-label="按属性筛选">
						<span>属性</span>
						<button type="button" data-attr="all" class="filter-chip" aria-pressed="true">全部</button>
						<button type="button" data-attr="STR" class="filter-chip" aria-pressed="false" title="力量英雄">
							<img src={ATTRIBUTE_ICON.STR} alt="" loading="lazy" referrerpolicy="no-referrer" />力量
						</button>
						<button type="button" data-attr="AGI" class="filter-chip" aria-pressed="false" title="敏捷英雄">
							<img src={ATTRIBUTE_ICON.AGI} alt="" loading="lazy" referrerpolicy="no-referrer" />敏捷
						</button>
						<button type="button" data-attr="INT" class="filter-chip" aria-pressed="false" title="智力英雄">
							<img src={ATTRIBUTE_ICON.INT} alt="" loading="lazy" referrerpolicy="no-referrer" />智力
						</button>
						<button type="button" data-attr="UNI" class="filter-chip" aria-pressed="false" title="全才英雄">
							<img src={ATTRIBUTE_ICON.UNI} alt="" loading="lazy" referrerpolicy="no-referrer" />全才
						</button>
					</div>
					<div class="flex items-center gap-2 text-xs text-muted" role="group" aria-label="按号位筛选">
						<span>号位</span>
						<button type="button" data-position="all" class="filter-chip" aria-pressed="true">全部</button>
						{[1, 2, 3, 4, 5].map((position) => (
							<button type="button" data-position={position} class="filter-chip" aria-pressed="false" title={`只看有 ${position} 号位样本的英雄`}>{position}</button>
						))}
					</div>
					<span id="draft-pool-count" class="ml-auto text-xs text-faint"></span>
				</div>
					<div id="draft-pool" class="pool-root" aria-label="英雄池"></div>
					<p id="draft-pool-hint" class="mt-3 text-xs text-faint"></p>
				</div>

				<!-- 建议 -->
				<section id="draft-advice-panel" data-panel="versus" class="rounded-2xl border border-line bg-surface/60 p-4" aria-label="建议">
					<!--
						轮到对面时这块是主界面：AI 替对面落子。默认自动出招，想自己代打就取消上面的勾选，
						这时按钮会露出来，由人点一下。
					-->
					<div id="draft-ai-move" class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2 rounded-xl border border-line bg-surface-2/60 px-3 py-2 text-sm" style="display: none">
						<span id="draft-ai-who" class="text-cream"></span>
						<span id="draft-ai-status" class="text-xs text-faint" role="status" aria-live="polite"></span>
						<button id="draft-ai-play" type="button" class="filter-chip" style="display: none">让 AI 走这一手</button>
					</div>
					<div class="flex flex-wrap items-center gap-3">
						<button id="draft-advice-toggle" type="button" class="filter-chip" aria-expanded="false" aria-controls="draft-advice-body">看建议（不剧透）</button>
						<!-- 初值用内联 style：Tailwind 的 `hidden` 类优先级更高，脚本摘不掉，元素会永远是隐藏的。 -->
						<button id="draft-advice-ai" type="button" class="filter-chip" style="display: none">让 AI 解释这几手</button>
						<span id="draft-advice-status" class="text-xs text-faint" role="status" aria-live="polite"></span>
					</div>
					<div id="draft-advice-body" style="display: none">
						<p id="draft-advice-summary" class="mt-4 text-sm text-cream"></p>
						<!-- 没接模型时这段由本地依据拼出来（见 lib/draftNarrative.ts）；有模型结果时让位给模型那段。 -->
						<p id="draft-advice-note" class="mt-2 text-sm leading-relaxed text-muted"></p>
						<p id="draft-composition" class="mt-2 text-xs text-faint"></p>
						<div id="draft-lineup" class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-5"></div>
						<div id="draft-advice-cards" class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-3"></div>
					</div>
				</section>
			</div>

			<!--
				阵容分析：不走 24 手 BP，两边各挑五个英雄再比。
				「填天辉 / 填夜魇」决定下一次点英雄池往哪边放；格子点了就把人移出去。
			-->
			<div id="draft-direct-panel" data-panel="lineup" class="rounded-2xl border border-line bg-surface/60 p-4">
				<div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-muted">
					<span>点英雄池里的英雄，填到</span>
					<button type="button" id="draft-direct-radiant" class="filter-chip" aria-pressed="true">天辉</button>
					<button type="button" id="draft-direct-dire" class="filter-chip" aria-pressed="false">夜魇</button>
					<span id="draft-direct-hint" class="text-faint" role="status" aria-live="polite"></span>
				</div>
				<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
					<div>
						<p id="draft-direct-label-radiant" class="mb-2 text-xs font-semibold text-[#62a86f]">天辉阵容</p>
						<div id="draft-direct-slots-radiant" class="grid grid-cols-5 gap-2"></div>
					</div>
					<div>
						<p id="draft-direct-label-dire" class="mb-2 text-xs font-semibold text-dota-light">夜魇阵容</p>
						<div id="draft-direct-slots-dire" class="grid grid-cols-5 gap-2"></div>
					</div>
				</div>
				<p class="mt-3 text-xs text-faint">点格子可以移除那个英雄；点英雄池里已经选中的英雄也能移除。两边各满五个，上面的「分析双方阵容」就会亮。</p>
			</div>

			<!-- BP 板 -->
			<div id="draft-board-panel" data-panel="versus" class="draft-board rounded-2xl border border-line bg-surface/60 p-4">
				<!--
					照客户端的排法：两侧是阵营列，中间夹一列手号，**一行一手**按顺序往下走。
					禁用和挑选不是两段，而是在同一列里按手号混排：禁用格打叉变灰，挑选格是头像。
				-->
				<div class="draft-board-head">
					<p class="draft-side-label" data-side="radiant">
						<span class="draft-side-name" id="draft-label-radiant">天辉</span>
						<span class="draft-column-badge" id="draft-badge-radiant"></span>
					</p>
					<p class="draft-board-head-mid"></p>
					<p class="draft-side-label" data-side="dire">
						<span class="draft-side-name" id="draft-label-dire">夜魇</span>
						<span class="draft-column-badge" id="draft-badge-dire"></span>
					</p>
				</div>
				<div id="draft-board-grid" class="draft-board-grid"></div>
				<p class="mt-2 text-xs text-faint">一行一手，中间是手号；禁用打叉变灰，挑选是头像，顺序与客户端一致。</p>
			</div>
		</div>

		<!--
			AI 配置：**表单在 `/settings`**，这里只显示状态并给入口。
			搬走是因为配置是低频动作、录 BP 是高频动作；两边的存储也就此分开（`d2s-ai-v1`），
			改配置不会再顺手把 BP 进度整块覆盖掉。
		-->
		<section id="draft-ai-config" class="mt-5 rounded-2xl border border-line bg-surface/60 p-4" aria-label="AI 解释">
			<h2 class="font-display text-lg">AI 解释（可选）</h2>
			<p class="mt-2 text-xs leading-relaxed text-muted">
				填的是自己的 key，请求从这台浏览器直接发出去，本站不经手也不保存；key 存在本机 localStorage 里，公共电脑上别存。
				<strong class="text-cream">不配也能用</strong>：上面的建议、对面的出招与复盘数字全部由本站数据算出，
				配上只是多一段更自然的文字解释。配置入口在
				<a href="/settings" class="text-dota-light transition hover:text-cream">AI 设置</a>。
			</p>
			<div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-muted">
				<span id="draft-ai-state" class="text-faint" role="status" aria-live="polite"></span>
				<a href="/settings" class="text-dota-light transition hover:text-cream">去 AI 设置 →</a>
			</div>
		</section>

		<p class="mt-6 text-xs leading-relaxed text-faint">
			数据口径：号位胜率来自 STRATZ 的 {data.bracketLabel}统计（{data.windowLabel}，单个号位少于 {data.minPositionMatches} 场不计），
			对应版本 {data.patch.version || '未知'}{data.patch.date ? `（${data.patch.date} 发布）` : ''}{data.patch.straddles ? '，这批样本跨了一次版本更新，胜率混着旧版本的场次' : ''}；
			职业出场与被禁来自 OpenDota 的职业样本，总量只有 {data.proSample.picks} 出场 / {data.proSample.bans} 被禁，只能当热度看。
			对位（谁好打谁）来自 STRATZ 的高分局统计，只按场次筛（≥ {data.matchupMinGames} 场，接近五五开的也留着），
			共 {data.matchupPairs.toLocaleString('zh-CN')} 对；它不区分分路，是个粗口径的克制信号。
			分路对位（线上谁打谁、和谁走一路）是另一份数据：同样来自 STRATZ 的高分局统计，按号位记录线上胜负，
			只留记了结果 ≥ {data.laneMinGames} 场的格子，单独加载；它只做横向对比，不进上面的胜率。
			队伍名单来自 Liquipedia，每个人的招牌英雄按版本统计（本版本样本不够时回退到近 90 天，口径会写在卡片上）；
			名单里跨了版本时不写版本号，免得把两套窗口的数字说成同一个版本。
			「AI 预测」交给模型时，英雄与数字也都是上面这几份数据里挑出来的，模型不额外联网。
			建议是按号位胜率做的启发式估计，不是胜率预测，也不代表任何队伍的真实战术。
		</p>

		<noscript>
			<p class="mt-6 rounded-2xl border border-line bg-surface px-5 py-4 text-sm text-muted">
				BP 陪练台要靠 JavaScript 才能录入与计算。页面上方的英雄数据是构建期生成的，脚本被禁用时看不到。
			</p>
		</noscript>
	</section>

	<!-- 构建期数据：英雄、号位胜率、职业样本。用 is:inline 避免被当成模块打包。 -->
	<script type="application/json" id="draft-data" set:html={payload} is:inline />
	<!-- 构建期数据：队伍目录（队标、名单、招牌英雄、OpenDota id）。与 /draft-teams.json 同源。 -->
	<script type="application/json" id="draft-teams" set:html={teamsPayload} is:inline />
</Layout>

<!--
	`is:global` 是必须的，不是图省事：英雄池、BP 格子、候选卡片这些节点都是脚本建出来的，
	而 Astro 默认会把样式编译成 `.hero-tile[data-astro-cid-xxx]` 这种带作用域属性的选择器，
	动态节点上没有这个属性，规则等于全部失效（实测症状：英雄格子退回 256px 的原始图片尺寸，
	BP 格子变成 31px 的小方块，整页被拉成七千多像素高）。

	不用再套一层 `.draft-page` 前缀：这个样式块只属于本页，打包出来只在 /draft 加载，
	`.filter-chip` 虽然在英雄页和装备页也有同名类，但那边各有自己的作用域规则，互不影响。
-->
<style is:global>
	.filter-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		border: 1px solid var(--color-line);
		border-radius: 0.5rem;
		padding: 0.35rem 0.6rem;
		font-size: 0.75rem;
		color: var(--color-muted);
		background: var(--color-surface-2);
		transition: color 0.12s ease-in-out, border-color 0.12s ease-in-out;
	}
	.filter-chip:hover {
		color: var(--color-cream);
		border-color: var(--color-gold-deep);
	}
	.filter-chip[aria-pressed='true'] {
		color: var(--color-cream);
		border-color: var(--color-dota);
		background: color-mix(in srgb, var(--color-dota) 22%, var(--color-surface-2));
	}
	.filter-chip:disabled {
		opacity: 0.4;
	}

	/*
	 * BP 板照客户端的排法：天辉一列、夜魇一列，中间夹一列手号，一行一手。
	 * 禁用与挑选在**同一列里**按手号混排（禁用格打叉变灰、挑选格是头像），
	 * 而不是先排完七个禁用再排五个挑选。
	 */
	.draft-page .draft-board {
		--radiant-color: #62a86f;
		--dire-color: var(--color-dota);
	}
	.draft-page .draft-board-head,
	.draft-page .draft-row {
		display: grid;
		/* 两侧等宽，中间固定给手号：三列对齐，行与行之间才是齐的。 */
		grid-template-columns: minmax(0, 1fr) 2.5rem minmax(0, 1fr);
		gap: 0.25rem;
	}
	.draft-page .draft-board-head {
		align-items: end;
		margin-bottom: 0.375rem;
	}
	.draft-page .draft-side-label {
		display: flex;
		align-items: baseline;
		/* 队名 + 先选标记比阵营名长得多：窄屏上要能折到第二行，不然会把"天辉"挤成一列。 */
		flex-wrap: wrap;
		gap: 0.35rem;
		font-size: 0.8rem;
		color: var(--color-cream);
	}
	.draft-page .draft-side-label[data-side='radiant'] .draft-side-name {
		color: var(--radiant-color);
	}
	.draft-page .draft-side-label[data-side='dire'] {
		grid-column: 3;
		justify-content: flex-end;
	}
	.draft-page .draft-side-label[data-side='dire'] .draft-side-name {
		color: var(--dire-color);
	}
	.draft-page .draft-column-badge {
		font-size: 0.65rem;
		color: var(--color-gold);
	}
	.draft-page .draft-board-grid {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}
	.draft-page .draft-row {
		align-items: stretch;
	}
	/*
	 * 框按客户端的实测尺寸写死：禁用 55×30、挑选 70×40。挑选框是禁用框整只放大一档的
	 * 观感，禁用只是个缩略图加个叉，挑选才是看阵容的地方。
	 * 两边都朝中间的手号列贴齐，尺寸变化只影响外侧那一半，手号列不会跟着晃。
	 */
	.draft-page .draft-row[data-action='ban'] {
		--cell-width: 55px;
		--cell-height: 30px;
	}
	.draft-page .draft-row[data-action='pick'] {
		--cell-width: 70px;
		--cell-height: 40px;
	}
	.draft-page .draft-row {
		/* 尺寸写死之后行不再伸缩，多出来的高度留给面板（左边会把它分到属性组之间）。 */
		flex: 0 0 auto;
	}
	/* 阶段之间留一道缝：禁用段与挑选段交替，看的时候能一眼分段。 */
	.draft-page .draft-row[data-phase-start='true'] {
		margin-top: 0.35rem;
	}
	.draft-page .draft-cell {
		position: relative;
		overflow: hidden;
		width: var(--cell-width, 100%);
		height: var(--cell-height, 30px);
		border-radius: 0.3rem;
		border: 1px solid var(--color-line);
		background: rgb(0 0 0 / 0.35);
	}
	.draft-page .draft-cell[data-side='radiant'] {
		justify-self: end;
	}
	.draft-page .draft-cell[data-side='dire'] {
		justify-self: start;
	}
	.draft-page .draft-cell img {
		/*
		 * 绝对定位：格子的高度由行高（栅格）决定，头像只负责填满它。
		 * 用 `height: 100%` 的话，父元素高度不确定时百分比失效，图片会按自己的比例
		 * 把整行撑开（实测 24 行被撑到 1900px 高）。
		 */
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}
	.draft-page .draft-cell[data-state='filled'] {
		border-color: color-mix(in srgb, var(--cell-color, var(--color-line)) 70%, transparent);
	}
	/* 禁用：变灰再打一个叉，与客户端一致。 */
	.draft-page .draft-cell[data-action='ban'][data-state='filled'] img {
		/* 别压太狠：禁用格本来就矮，再压黑就只剩一团墨，认不出是哪个英雄。 */
		filter: brightness(0.68) saturate(0.8);
	}
	.draft-page .draft-cell[data-action='ban'][data-state='filled']::after {
		content: '✕';
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		font-size: 0.75rem;
		line-height: 1;
		color: #ff6b4a;
		text-shadow: 0 0 2px rgb(0 0 0 / 0.95), 0 0 5px rgb(0 0 0 / 0.9);
	}
	.draft-page .draft-cell[data-side='radiant'] {
		--cell-color: var(--radiant-color);
	}
	.draft-page .draft-cell[data-side='dire'] {
		--cell-color: var(--dire-color);
	}
	.draft-page .draft-step {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.05rem;
		font-size: 0.6rem;
		line-height: 1;
		color: var(--color-faint);
	}
	.draft-page .draft-step-action {
		font-size: 0.55rem;
	}
	.draft-page .draft-row[data-current='true'] .draft-step-action {
		font-size: 0.5rem;
	}
	.draft-page .draft-row[data-current='true'] .draft-step {
		color: var(--color-gold);
	}
	.draft-page .draft-row[data-current='true'] .draft-cell {
		border-color: var(--color-gold);
		box-shadow: 0 0 0 1px var(--color-gold);
	}

	/*
	 * 并排布局（xl 起）里让右边填满整列：面板会被栅格拉到与左边等高，
	 * 多出来的高度平均分给 24 行（有下限，别在小屏笔记本上压没）。
	 */
	@media (min-width: 1280px) {
		.draft-page .draft-board {
			display: flex;
			flex-direction: column;
		}
		.draft-page .draft-board-grid {
			flex: 1 1 auto;
			min-height: 0;
		}
	}

	.hero-tile {
		position: relative;
		overflow: hidden;
		/* 竖版头像：45×80，跟客户端的英雄池一样，脸在格子里认得出来。 */
		width: 45px;
		height: 80px;
		border-radius: 0.25rem;
		border: 1px solid var(--color-line);
		background: var(--color-surface-2);
		transition: border-color 0.12s ease-in-out, transform 0.12s ease-in-out;
	}

	.pool-root {
		/*
		 * 照客户端：四个属性各占一列并排，每列里是竖版头像墙。
		 * 第一版是四组上下堆叠，一屏只看得到半组，挑人要来回滚。
		 */
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		align-items: start;
		gap: 0.75rem;
	}
	.pool-group {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		min-width: 0;
	}
	.pool-group-title {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		color: var(--color-muted);
	}
	.pool-group-icon {
		width: 14px;
		height: 14px;
		flex: 0 0 auto;
	}
	/* 筛选按钮里的属性图标，比分组标题里的小一号。 */
	.filter-chip img {
		width: 12px;
		height: 12px;
		flex: 0 0 auto;
	}
	.pool-grid {
		display: grid;
		/* 定宽排：格子固定 45 宽，一行几个由列宽决定（1600 宽下每列六个）。 */
		grid-template-columns: repeat(auto-fill, 45px);
		justify-content: start;
		gap: 3px;
	}

	.advice-card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		border: 1px solid var(--color-line);
		border-radius: 0.75rem;
		background: var(--color-surface-2);
		padding: 0.75rem;
		text-align: left;
	}
	.advice-card:hover {
		border-color: var(--color-gold-deep);
	}
	.advice-card[disabled] {
		opacity: 0.55;
	}
	.lineup-slot {
		border: 1px solid var(--color-line);
		border-radius: 0.5rem;
		background: var(--color-surface-2);
		padding: 0.4rem 0.5rem;
		font-size: 0.7rem;
		color: var(--color-muted);
	}
	.lineup-slot[data-settled='true'] {
		border-color: var(--color-gold-deep);
		color: var(--color-cream);
	}
	.hero-tile:hover {
		border-color: var(--color-gold-deep);
		transform: translateY(-1px);
	}
	.hero-tile img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}
	.hero-tile-name {
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		padding: 0.1rem 0.15rem;
		font-size: 0.55rem;
		line-height: 1.2;
		/* 45px 宽塞四个字刚好，再长就省略，别把格子撑破。 */
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		color: var(--color-cream);
		background: linear-gradient(to top, rgb(0 0 0 / 0.72), rgb(0 0 0 / 0));
	}
	.hero-tile[data-used='ban'] {
		/* 与 BP 板上的禁用格同一档：再暗就认不出英雄了。 */
		filter: brightness(0.68) saturate(0.8);
	}
	.hero-tile[data-used='pick'] {
		filter: grayscale(0.6) brightness(0.7);
	}
	.hero-tile[data-used] .hero-tile-name::after {
		content: attr(data-used-label);
		display: block;
		font-size: 0.55rem;
		color: var(--color-gold);
	}
	/*
		直接选阵容的格子：空位是虚线框加号位数字，填上之后和英雄池的头像一样是竖版图。
		尺寸跟英雄池格子对齐（45×80 那一档），一眼能看出"这是个能放英雄的格子"。
	*/
	.direct-slot {
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 45 / 80;
		overflow: hidden;
		border: 1px dashed var(--color-line);
		border-radius: 0.4rem;
		background: var(--color-surface-2);
		cursor: pointer;
	}
	.direct-slot.is-filled {
		border-style: solid;
		border-color: var(--color-gold-deep);
	}
	.direct-slot img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}
	.direct-slot-number {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 100%;
		font-size: 0.75rem;
		color: var(--color-faint);
	}
	.direct-slot-name {
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		padding: 0.1rem 0.15rem;
		font-size: 0.55rem;
		line-height: 1.2;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		color: var(--color-cream);
		background: linear-gradient(to top, rgb(0 0 0 / 0.72), rgb(0 0 0 / 0));
	}
	.direct-slot:hover {
		border-color: var(--color-gold-deep);
	}

	/*
	 * 三个功能面板的显隐。
	 *
	 * **不用 `hidden` 类也不用内联 display**：这几块里有 flex 容器与 grid 容器，写死一种 display
	 * 会把它们压平（对战控制条是 flex，栅格是 grid）。所以判据挂在属性上，脚本只切
	 * `data-active`，未点亮的那块整块收起来。
	 * 默认（脚本还没跑）全部收着，点亮由脚本负责——首屏不会闪一下用不上的那一块。
	 */
	.draft-page [data-panel]:not([data-active='true']) {
		display: none !important;
	}

	/* 队伍卡片：队标在浅色底板上（黑队徽的可见性见 MatchRow 的注释），右边是名单与招牌。 */
	.team-brief {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		border: 1px solid var(--color-line);
		border-radius: 1rem;
		background: var(--color-surface);
		padding: 0.75rem 1rem;
	}
	.team-brief-logo {
		display: flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 auto;
		width: 2.75rem;
		height: 2.75rem;
		overflow: hidden;
		border: 1px solid var(--color-line);
		border-radius: 0.5rem;
		background: var(--color-plate);
		color: var(--color-plate-ink);
		font-size: 0.7rem;
		font-weight: 600;
	}
	.team-brief-logo img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		padding: 2px;
	}
	.team-brief-member {
		display: flex;
		/* 一位选手一整块：名字一行、招牌一行，窄屏上不会把第二个英雄挤到没有名字的那一行。 */
		flex-direction: column;
		align-items: flex-start;
		gap: 0.25rem;
		min-width: 0;
	}
	.team-brief-hero {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		border: 1px solid var(--color-line);
		border-radius: 0.375rem;
		background: var(--color-surface-2);
		padding: 0.1rem 0.35rem;
		font-size: 0.65rem;
		color: var(--color-muted);
	}
	.team-brief-hero img {
		width: 1.1rem;
		height: 1.4rem;
		border-radius: 2px;
		object-fit: cover;
		object-position: top;
	}

	/* AI 预测：两张队卡并排，每边分「禁用 / 挑选」两段。 */
	.predict-side {
		border: 1px solid var(--color-line);
		border-radius: 0.75rem;
		background: var(--color-surface-2);
		padding: 0.75rem;
	}
	.predict-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.375rem;
	}
	.predict-hero {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		border: 1px solid var(--color-line);
		border-radius: 0.5rem;
		background: var(--color-surface);
		padding: 0.15rem 0.4rem 0.15rem 0.15rem;
		font-size: 0.7rem;
		color: var(--color-cream);
	}
	.predict-hero img {
		width: 1.5rem;
		height: 1.7rem;
		border-radius: 3px;
		object-fit: cover;
		object-position: top;
	}
	.predict-hero[data-kind='ban'] {
		color: var(--color-muted);
	}
	.predict-hero[data-kind='ban'] img {
		filter: brightness(0.68) saturate(0.8);
	}
	/* 禁用格右下角那个小数字：对面会拿它打几号位。 */
	.predict-pos {
		margin-left: 0.15rem;
		border-radius: 0.25rem;
		background: var(--color-surface-2);
		padding: 0 0.25rem;
		font-size: 0.6rem;
		color: var(--color-faint);
	}

	/*
	 * 挑选卡：头像 + 名字 + `几号位 · 谁` + 熟手与否 + 一句理由。
	 * 不在该号位选手池子里的用**虚线框**标出来——这一版的重点就是让读者一眼看出
	 * "这一手像不像他们"，所以不能用颜色单独承担（色觉差异下也要分得出）。
	 */
	.predict-grid {
		display: grid;
		gap: 0.375rem;
		grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
	}
	.predict-pick {
		display: flex;
		align-items: flex-start;
