---
import Layout from '../layouts/Layout.astro';
import HeroCard from '../components/HeroCard.astro';
import { HEROES, ATTRIBUTES } from '../data/heroes';
---

<Layout title="英雄资料 · DOTA2 驿站" description="DOTA2 英雄属性、定位与复杂度一览。">
	<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
		<div class="mb-8">
			<p class="text-xs font-semibold uppercase tracking-[0.2em] text-dota-light">英雄图鉴</p>
			<h1 class="mt-2 font-display text-3xl sm:text-4xl">英雄资料库</h1>
			<p class="mt-3 max-w-2xl text-muted">按属性与定位筛选英雄，快速了解他们的强度定位。数据为示例，可通过官方 datafeed 接入完整英雄列表。</p>
		</div>

		<div id="hero-filters" class="mb-6 flex flex-wrap items-center gap-2">
			<button type="button" data-attr="all" class="rounded-lg border border-line px-4 py-2 text-sm font-medium transition" aria-pressed="true">全部</button>
			{ATTRIBUTES.map((a) => (
				<button type="button" data-attr={a.id} class="rounded-lg border border-line px-4 py-2 text-sm font-medium transition" aria-pressed="false">
					<span style={`color:${a.color}`}>●</span> {a.label}
				</button>
			))}
			<span id="hero-count" class="ml-auto text-sm text-muted">{HEROES.length} 位英雄</span>
		</div>

		<div id="hero-grid" class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
			{HEROES.map((h) => (
				<div data-attribute={h.attribute}>
					<HeroCard hero={h} />
				</div>
			))}
		</div>

		<div class="mt-10 rounded-2xl border border-line bg-surface p-6 text-sm text-muted">
			下方数据为演示用途的精选英雄。要获得全部 120+ 英雄与详细技能，可使用官方数据接口：
			<code class="mt-2 block whitespace-pre-wrap rounded bg-surface-3 p-3 text-gold">
				https://www.dota2.com/datafeed/herodata?language=schinese
			</code>
		</div>
	</section>
</Layout>

<script>
	(() => {
		const filters = document.getElementById('hero-filters');
		const grid = document.getElementById('hero-grid');
		const count = document.getElementById('hero-count');
		if (!filters || !grid || !count) return;
		const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-attribute]'));
		filters.querySelectorAll<HTMLButtonElement>('button[data-attr]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const attr = btn.dataset.attr!;
				filters.querySelectorAll('button[data-attr]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
				btn.setAttribute('aria-pressed', 'true');
				let shown = 0;
				cards.forEach((c) => {
					const show = attr === 'all' || c.dataset.attribute === attr;
					c.hidden = !show;
					if (show) shown++;
				});
				count.textContent = `${shown} 位英雄`;
			});
		});
	})();
</script>
