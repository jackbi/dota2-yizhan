---
import Layout from '../layouts/Layout.astro';
import { ATTRIBUTES } from '../lib/heroApi';
---

<Layout
	title="英雄资料 · DOTA2 驿站"
	description="DOTA2 英雄资料库，实时从官方 datafeed 获取，支持按属性与关键词筛选。"
>
	<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
		<div class="mb-8">
			<p class="text-xs font-semibold uppercase tracking-[0.2em] text-dota-light">英雄图鉴</p>
			<h1 class="mt-2 font-display text-3xl sm:text-4xl">英雄资料库</h1>
			<p class="mt-3 max-w-2xl text-muted">
				数据实时来自 DOTA2 官方 datafeed。点击英雄卡片可进入详情页查看数值与技能。
			</p>
		</div>

		<div class="mb-6 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
			<div id="hero-filters" class="flex flex-wrap items-center gap-2" role="group" aria-label="按属性筛选">
				<button type="button" data-attr="all" class="rounded-lg border border-line px-4 py-2 text-sm font-medium transition" aria-pressed="true">全部</button>
				{ATTRIBUTES.map((a) => (
					<button type="button" data-attr={a.id} class="rounded-lg border border-line px-4 py-2 text-sm font-medium transition" aria-pressed="false">
						<span style={`color:${a.color}`}>●</span> {a.label}
					</button>
				))}
			</div>

			<label class="relative block md:w-72">
				<span class="sr-only">搜索英雄</span>
				<svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-faint" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8" />
					<path d="M21 21l-4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
				</svg>
				<input
					id="hero-search"
					type="search"
					placeholder="搜索英雄名（中文 / 英文）"
					class="w-full rounded-lg border border-line bg-surface py-2 pl-10 pr-3 text-sm text-cream placeholder:text-faint focus:border-dota focus:outline-none"
				/>
			</label>
		</div>

		<div class="mb-4 flex items-center justify-between">
			<h2 id="hero-count" class="text-sm text-muted">正在加载英雄数据…</h2>
			<a href="https://www.dota2.com.cn/datafeed/heroList?task=herolist" target="_blank" rel="noopener noreferrer" class="text-xs text-faint underline-offset-2 transition hover:text-gold hover:underline">
				官方数据源
			</a>
		</div>

		<div id="hero-status" class="hidden rounded-2xl border border-line bg-surface p-8 text-center">
			<p class="text-muted">英雄数据加载失败，请检查网络后重试。</p>
			<button id="hero-retry" type="button" class="mt-4 rounded-lg bg-dota px-5 py-2.5 text-sm font-medium text-white transition hover:bg-dota-light">
				重新加载
			</button>
		</div>

		<div id="hero-grid" class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
			{Array.from({ length: 10 }).map(() => (
				<div class="flex animate-pulse flex-col overflow-hidden rounded-2xl border border-line bg-surface">
					<div class="aspect-[4/3] bg-surface-2"></div>
					<div class="space-y-2 p-3.5">
						<div class="h-4 rounded bg-surface-3"></div>
						<div class="h-3 rounded bg-surface-3"></div>
						<div class="h-3 w-1/2 rounded bg-surface-3"></div>
					</div>
				</div>
			))}
		</div>
	</section>
</Layout>

<script>
	import { fetchHeroList, ATTRIBUTE_META } from '../lib/heroApi';

	(() => {
		const grid = document.getElementById('hero-grid');
		const count = document.getElementById('hero-count');
		const filters = document.getElementById('hero-filters');
		const search = document.getElementById('hero-search') as HTMLInputElement | null;
		const status = document.getElementById('hero-status');
		const retry = document.getElementById('hero-retry') as HTMLButtonElement | null;
		if (!grid || !count) return;

		let heroes: { id: number; name: string; nameEn: string; attr: string; complexity: number; img: string }[] = [];
		let attr = 'all';
		let q = '';

		const esc = (s: string) =>
			s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

		const renderCard = (h: (typeof heroes)[number]) => {
			const color = ATTRIBUTE_META[h.attr as keyof typeof ATTRIBUTE_META]?.color ?? '#999';
			return `
				<a href="/heroes/${h.id}" class="group relative flex flex-col overflow-hidden rounded-2xl border border-line bg-surface transition hover:border-dota/60 hover:shadow-lg hover:shadow-dota/10" data-attribute="${h.attr}" data-name="${esc((h.name + ' ' + h.nameEn).toLowerCase())}">
					<div class="relative aspect-[4/3] w-full overflow-hidden bg-gradient-to-br from-surface-2 to-surface-3">
					<img src="${esc(h.img)}" alt="${esc(h.name)}" loading="lazy" referrerpolicy="no-referrer" class="h-full w-full object-cover object-top transition duration-300 group-hover:scale-105">
						<div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-surface via-surface/40 to-transparent"></div>
						<span class="absolute right-2 top-2 flex h-7 w-7 items-center justify-center rounded-full border border-line bg-ink/70 text-[11px] font-bold backdrop-blur" style="color:${color}">${h.attr}</span>
					</div>
					<div class="flex flex-1 flex-col p-3.5">
						<h3 class="font-display text-base leading-tight">${esc(h.name)}</h3>
						<p class="mt-0.5 truncate text-xs text-muted">${esc(h.nameEn)}</p>
						<div class="mt-3 flex items-center justify-between border-t border-line pt-3 text-xs">
							<span class="flex items-center gap-1 text-faint"><span class="text-dota-light">${'●'.repeat(h.complexity)}</span><span class="text-surface-3">${'●'.repeat(3 - h.complexity)}</span></span>
							<span class="text-faint">复杂度</span>
						</div>
					</div>
				</a>`;
		};

		const apply = () => {
			const visible = heroes.filter((h) => {
				const mAttr = attr === 'all' || h.attr === attr;
				const mQ = !q || (h.name + ' ' + h.nameEn).toLowerCase().includes(q);
				return mAttr && mQ;
			});
			grid.innerHTML = visible.map(renderCard).join('');
			count.textContent = `共 ${visible.length} 位英雄`;
		};

		const load = async () => {
			grid.classList.remove('hidden');
			if (status) status.classList.add('hidden');
			count.textContent = '正在加载英雄数据…';
			try {
				const list = await fetchHeroList();
				heroes = list.map((h) => ({
					id: h.id,
					name: h.name,
					nameEn: h.nameEn,
					attr: h.attr,
					complexity: h.complexity,
					img: h.img,
				}));
				apply();
			} catch (e) {
				console.error(e);
				grid.classList.add('hidden');
				if (status) status.classList.remove('hidden');
				count.textContent = '加载失败';
			}
		};

		filters?.querySelectorAll<HTMLButtonElement>('button[data-attr]').forEach((btn) => {
			btn.addEventListener('click', () => {
				attr = btn.dataset.attr!;
				filters.querySelectorAll('button[data-attr]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
				btn.setAttribute('aria-pressed', 'true');
				apply();
			});
		});

		search?.addEventListener('input', () => {
			q = (search.value ?? '').trim().toLowerCase();
			apply();
		});

		retry?.addEventListener('click', load);
		load();
	})();
</script>
