---
import Layout from '../layouts/Layout.astro';
import { ATTRIBUTES, fetchHeroList } from '../lib/heroApi';
import { formatIso } from '../lib/format';
import { HERO_META_WINDOW_DAYS, fetchHeroMeta, stratzConfigured } from '../lib/stratzApi';

const ATTR_ICON: Record<string, string> = {
	STR: 'https://www.dota2.com.cn/herostatic/icons/hero_strength.png',
	AGI: 'https://www.dota2.com.cn/herostatic/icons/hero_agility.png',
	INT: 'https://www.dota2.com.cn/herostatic/icons/hero_intelligence.png',
	UNI: '/hero-filters/universal.png',
};

/** 近一周英雄数据：没有 STRATZ_TOKEN、离线且无缓存时整块不展示。 */
const meta = await fetchHeroMeta();
/** 配了 token 却拿不到数据 = 抓取故障，要说出来，别让"源挂了"看起来像"没这功能"。 */
const metaUnavailable = meta === null && stratzConfigured();
/** 榜单要显示英雄名与头像；官方 datafeed 不通时这些榜单仍然显示数字。 */
const heroNames = new Map<number, { name: string; img: string }>();
try {
	for (const hero of await fetchHeroList()) heroNames.set(hero.id, { name: hero.name, img: hero.img });
} catch {
	// 英雄网格本身走客户端渲染，这里失败只影响榜单的名字与头像。
}

/** 场次太少的英雄胜率波动大，不进榜单。 */
const MIN_RANK_MATCHES = 2000;
const winRate = (entry: { matches: number; wins: number }): number => (entry.matches > 0 ? (entry.wins / entry.matches) * 100 : 0);
const ranked = meta ? [...meta.heroes.entries()].filter(([, entry]) => entry.matches >= MIN_RANK_MATCHES) : [];
const BOARDS = [
	{
		title: '胜率榜',
		hint: '谁在赢',
		rows: [...ranked].sort((a, b) => winRate(b[1]) - winRate(a[1])).slice(0, 8),
		value: (entry: { matches: number; wins: number }) => `${winRate(entry).toFixed(1)}%`,
	},
	{
		title: '出场榜',
		hint: '谁最热',
		rows: [...ranked].sort((a, b) => b[1].matches - a[1].matches).slice(0, 8),
		value: (entry: { matches: number; wins: number }) => `${entry.matches.toLocaleString('zh-CN')} 场`,
	},
];
const heroOf = (id: number) => heroNames.get(id) ?? { name: `英雄 #${id}`, img: '' };

/** 传给客户端脚本，让每张卡片带上近一周胜率徽章。 */
const metaPayload = JSON.stringify({
	windowDays: meta?.windowDays ?? HERO_META_WINDOW_DAYS,
	heroes: meta ? Object.fromEntries([...meta.heroes].map(([id, entry]) => [id, [entry.matches, entry.wins]])) : {},
});
---

<Layout
	title="英雄资料 · DOTA2 驿站"
	description="DOTA2 英雄资料库，实时从官方 datafeed 获取，支持按属性与关键词筛选。"
>
	<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
		<div class="mb-8">
			<p class="text-xs font-semibold uppercase tracking-[0.2em] text-dota-light">英雄图鉴</p>
			<h1 class="mt-2 font-display text-3xl sm:text-4xl">英雄资料库</h1>
			<p class="mt-3 max-w-2xl text-muted">
				数据实时来自 DOTA2 官方 datafeed。点击英雄卡片可进入详情页查看数值与技能。
			</p>
		</div>

		{
			metaUnavailable ? (
				<p class="mb-6 rounded-2xl border border-line bg-surface/60 px-5 py-4 text-sm text-muted">
					本次构建没有取到近一周英雄数据，当前版本强度榜单暂缺，下一轮构建会重试。
				</p>
			) : null
		}

		{
			meta && BOARDS[0].rows.length > 0 ? (
				<section class="mb-8 rounded-2xl border border-line bg-surface/60 p-5" aria-label="近一周英雄强度">
					<div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
						<h2 class="font-display text-lg">
							近 {meta.windowDays} 天强势英雄
						</h2>
						<p class="text-xs text-faint">
							{meta.bracketLabel} · {MIN_RANK_MATCHES.toLocaleString('zh-CN')} 场以上 · 更新于 {formatIso(meta.updatedAt)} · 数据来自 STRATZ
						</p>
					</div>
					<div class="grid grid-cols-1 gap-x-8 gap-y-5 md:grid-cols-2">
						{BOARDS.map((board) => (
							<div>
								<div class="mb-1 flex items-baseline gap-2">
									<h3 class="text-sm font-semibold text-cream">{board.title}</h3>
									<span class="text-xs text-faint">{board.hint}</span>
								</div>
								<ol class="divide-y divide-line">
									{board.rows.map(([id, entry], index) => (
										<li>
											<a href={`/heroes/${id}`} class="flex items-center gap-3 py-2 transition hover:text-dota-light">
												<span class="w-4 shrink-0 text-center font-display text-xs text-faint">{index + 1}</span>
												{heroOf(id).img ? (
													<img
														src={heroOf(id).img}
														alt=""
														loading="lazy"
														referrerpolicy="no-referrer"
														class="h-8 w-14 shrink-0 rounded object-cover object-top"
													/>
												) : (
													<span class="h-8 w-14 shrink-0 rounded bg-surface-2" />
												)}
												<span class="min-w-0 flex-1 truncate text-sm text-cream">{heroOf(id).name}</span>
												<span class="shrink-0 text-xs tabular-nums text-gold">{board.value(entry)}</span>
											</a>
										</li>
									))}
								</ol>
							</div>
						))}
					</div>
				</section>
			) : null
		}

		<div id="hero-filters" class="mb-6 flex flex-wrap items-center gap-x-8 gap-y-4">
			<!-- 属性筛选 -->
			<div class="flex items-center gap-3">
				<span class="shrink-0 text-xs font-medium tracking-wider text-muted">属性</span>
				<div class="flex items-center gap-2" role="group" aria-label="按属性筛选">
					<button type="button" data-attr="all" class="filter-chip" aria-pressed="true">全部</button>
					{ATTRIBUTES.map((a) => (
						<button type="button" data-attr={a.id} class="filter-icon-btn" aria-pressed="false" aria-label={a.label} title={a.label}>
							<img src={ATTR_ICON[a.id]} alt={a.label} referrerpolicy="no-referrer" loading="lazy" class="filter-icon" />
						</button>
					))}
				</div>
			</div>

			<!-- 复杂程度筛选 -->
			<div class="flex items-center gap-3">
				<span class="shrink-0 text-xs font-medium tracking-wider text-muted">复杂程度</span>
				<div class="flex items-center gap-2" role="group" aria-label="按复杂程度筛选">
					<button type="button" data-complexity="all" class="filter-chip" aria-pressed="true">全部</button>
					{[1, 2, 3].map((l) => (
						<button type="button" data-complexity={l} class="filter-chip" aria-pressed="false" title={`复杂度 ${l}`}>
							<span class="flex items-center gap-0.5" aria-hidden="true">
								{[1, 2, 3].map((i) => (
									<span class={`h-1.5 w-1.5 rounded-full ${i <= l ? 'bg-current' : 'bg-surface-3'}`}></span>
								))}
							</span>
						</button>
					))}
				</div>
			</div>

			<!-- 搜索 -->
			<label class="relative block w-full md:ml-auto md:w-80">
				<span class="sr-only">搜索英雄</span>
				<svg class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-faint" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8" />
					<path d="M21 21l-4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
				</svg>
				<input
					id="hero-search"
					type="search"
					placeholder="搜索英雄名（中文 / 英文）"
					class="w-full rounded-full border border-line bg-surface py-2.5 pl-11 pr-4 text-sm text-cream placeholder:text-faint focus:border-dota focus:outline-none"
				/>
			</label>
		</div>

		<div class="mb-4 flex items-center justify-between">
			<h2 id="hero-count" class="text-sm text-muted">正在加载英雄数据…</h2>
			<a href="https://www.dota2.com.cn/datafeed/heroList?task=herolist" target="_blank" rel="noopener noreferrer" class="text-xs text-faint underline-offset-2 transition hover:text-gold hover:underline">
				官方数据源
			</a>
		</div>

		<div id="hero-status" class="hidden rounded-2xl border border-line bg-surface p-8 text-center">
			<p class="text-muted">英雄数据加载失败，请检查网络后重试。</p>
			<button id="hero-retry" type="button" class="mt-4 rounded-lg bg-dota px-5 py-2.5 text-sm font-medium text-white transition hover:bg-dota-dark">
				重新加载
			</button>
		</div>

		<div id="hero-grid" class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
			{Array.from({ length: 10 }).map(() => (
				<div class="flex animate-pulse flex-col overflow-hidden rounded-2xl border border-line bg-surface">
					<div class="aspect-[4/3] bg-surface-2"></div>
					<div class="space-y-2 p-3.5">
						<div class="h-4 rounded bg-surface-3"></div>
						<div class="h-3 rounded bg-surface-3"></div>
						<div class="h-3 w-1/2 rounded bg-surface-3"></div>
					</div>
				</div>
			))}
		</div>
	</section>
</Layout>

<style>
	.filter-chip {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding: 5px 12px;
		border-radius: 999px;
		border: 1px solid var(--color-line);
		background: transparent;
		color: var(--color-muted);
		font-size: 12px;
		cursor: pointer;
		transition: border-color 0.15s, color 0.15s, background 0.15s;
	}
	.filter-chip:hover {
		color: var(--color-cream);
		border-color: var(--color-dota-light);
	}
	.filter-chip[aria-pressed='true'] {
		background: rgb(198 82 44 / 0.14);
		border-color: var(--color-dota);
		color: var(--color-gold);
	}

	.filter-icon-btn {
		background: transparent;
		border: 1px solid transparent;
		padding: 2px;
		border-radius: 12px;
		cursor: pointer;
		transition: border-color 0.15s;
	}
	.filter-icon {
		display: block;
		height: 34px;
		width: 42px;
		object-fit: contain;
		filter: brightness(0.5) saturate(0);
		opacity: 0.5;
		transition: filter 0.12s ease-in-out, opacity 0.12s ease-in-out;
	}
	.filter-icon-btn:hover .filter-icon {
		filter: brightness(0.9) saturate(0.7);
		opacity: 0.9;
	}
	.filter-icon-btn[aria-pressed='true'] {
		border-color: var(--color-dota);
		background: rgb(198 82 44 / 0.08);
	}
	.filter-icon-btn[aria-pressed='true'] .filter-icon {
		filter: brightness(1) saturate(1);
		opacity: 1;
	}
</style>

<!-- 近一周数据随构建写死在这里，客户端渲染卡片时读它加胜率徽章。用 is:inline 避免被当成模块打包。 -->
<script type="application/json" id="hero-meta" set:html={metaPayload} is:inline />

<script>
	import { fetchHeroList } from '../lib/heroApi';

	(() => {
		const grid = document.getElementById('hero-grid');
		const count = document.getElementById('hero-count');
		const filters = document.getElementById('hero-filters');
		const search = document.getElementById('hero-search') as HTMLInputElement | null;
		const status = document.getElementById('hero-status');
		const retry = document.getElementById('hero-retry') as HTMLButtonElement | null;
		if (!grid || !count) return;

		let heroes: { id: number; name: string; nameEn: string; attr: string; complexity: number; img: string }[] = [];
		let attr = 'all';
		let level = 0;
		let q = '';

		/** 构建期写进页面的近一周数据：[出场, 胜场]；拿不到就是空对象，卡片照常渲染。 */
		const readMeta = (): { windowDays: number; heroes: Record<string, [number, number]> } => {
			try {
				const raw = document.getElementById('hero-meta')?.textContent ?? '';
				const parsed = JSON.parse(raw);
				return { windowDays: parsed.windowDays ?? 0, heroes: parsed.heroes ?? {} };
			} catch {
				return { windowDays: 0, heroes: {} };
			}
		};
		const meta = readMeta();

		const ATTR_ICON: Record<string, string> = {
			STR: 'https://www.dota2.com.cn/herostatic/icons/hero_strength.png',
			AGI: 'https://www.dota2.com.cn/herostatic/icons/hero_agility.png',
			INT: 'https://www.dota2.com.cn/herostatic/icons/hero_intelligence.png',
			UNI: '/hero-filters/universal.png',
		};

		const esc = (s: string) =>
			s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

		const renderCard = (h: (typeof heroes)[number]) => {
			const stat = meta.heroes[String(h.id)];
			const badge =
				stat && stat[0] > 0
					? `<span class="shrink-0 tabular-nums ${stat[1] / stat[0] >= 0.5 ? 'text-gold' : 'text-muted'}" title="近 ${meta.windowDays} 天胜率（${stat[1]}/${stat[0]} 场）">${((stat[1] / stat[0]) * 100).toFixed(1)}%</span>`
					: '<span class="text-faint">—</span>';
			return `
				<a href="/heroes/${h.id}" class="group relative flex flex-col overflow-hidden rounded-2xl border border-line bg-surface transition hover:border-dota/60 hover:shadow-lg hover:shadow-dota/10" data-attribute="${h.attr}" data-name="${esc((h.name + ' ' + h.nameEn).toLowerCase())}">
					<div class="relative aspect-[4/3] w-full overflow-hidden bg-gradient-to-br from-surface-2 to-surface-3">
					<img src="${esc(h.img)}" alt="${esc(h.name)}" loading="lazy" referrerpolicy="no-referrer" class="h-full w-full object-cover object-top transition duration-300 group-hover:scale-105">
						<div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-surface via-surface/40 to-transparent"></div>
						<span class="absolute right-2 top-2 flex h-8 w-8 items-center justify-center rounded-full border border-line bg-ink/80 backdrop-blur" title="${h.attr}">
							<img src="${ATTR_ICON[h.attr]}" alt="${h.attr}" referrerpolicy="no-referrer" loading="lazy" class="h-6 w-6 object-contain">
						</span>
					</div>
					<div class="flex flex-1 flex-col p-3.5">
						<h3 class="font-display text-base leading-tight">${esc(h.name)}</h3>
						<p class="mt-0.5 truncate text-xs text-muted">${esc(h.nameEn)}</p>
						<div class="mt-3 flex items-center justify-between border-t border-line pt-3 text-xs">
							<span class="flex items-center gap-1 text-faint"><span class="text-dota-light">${'●'.repeat(h.complexity)}</span><span class="text-surface-3">${'●'.repeat(3 - h.complexity)}</span></span>
							<span class="flex items-center gap-1.5 text-faint">${badge}<span>胜率</span></span>
						</div>
					</div>
				</a>`;
		};

		const apply = () => {
			const visible = heroes.filter((h) => {
				const mAttr = attr === 'all' || h.attr === attr;
				const mLevel = level === 0 || h.complexity === level;
				const mQ = !q || (h.name + ' ' + h.nameEn).toLowerCase().includes(q);
				return mAttr && mLevel && mQ;
			});
			grid.innerHTML = visible.map(renderCard).join('');
			count.textContent = `共 ${visible.length} 位英雄`;
		};

		const load = async () => {
			grid.classList.remove('hidden');
			if (status) status.classList.add('hidden');
			count.textContent = '正在加载英雄数据…';
			try {
				const list = await fetchHeroList();
				heroes = list.map((h) => ({
					id: h.id,
					name: h.name,
					nameEn: h.nameEn,
					attr: h.attr,
					complexity: h.complexity,
					img: h.img,
				}));
				apply();
			} catch (e) {
				console.error(e);
				grid.classList.add('hidden');
				if (status) status.classList.remove('hidden');
				count.textContent = '加载失败';
			}
		};

		filters?.querySelectorAll<HTMLButtonElement>('button[data-attr]').forEach((btn) => {
			btn.addEventListener('click', () => {
				attr = btn.dataset.attr!;
				filters.querySelectorAll('button[data-attr]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
				btn.setAttribute('aria-pressed', 'true');
				apply();
			});
		});

		filters?.querySelectorAll<HTMLButtonElement>('button[data-complexity]').forEach((btn) => {
			btn.addEventListener('click', () => {
				level = Number(btn.dataset.complexity) || 0;
				filters.querySelectorAll('button[data-complexity]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
				btn.setAttribute('aria-pressed', 'true');
				apply();
			});
		});

		search?.addEventListener('input', () => {
			q = (search.value ?? '').trim().toLowerCase();
			apply();
		});

		retry?.addEventListener('click', load);
		load();
	})();
</script>
