{
  // Worker 名。适配器默认取 package.json 的 name，这里显式写一份，改包名时别忘了一起改。
  "name": "dota2-yizhan",
  "compatibility_date": "2026-09-16",
  /*
   * 跑分屏页那条 `/api/live/stream-url` 时会向斗鱼发请求，这个 flag 保证全局 fetch 只打公网
   * （挡掉指向内网/本机的地址）。SSR 侧只用 Web 标准 API，不需要 nodejs_compat。
   */
  "compatibility_flags": ["global_fetch_strictly_public"],
	/*
	 * Worker 入口是**我们自己的** `src/worker/index.ts`，它在 Astro 的 server handler 外面包了一层，
	 * 用来把 `/api/party/*` 接到开黑房间的 Durable Object 上（其余请求原样交给 Astro）。
	 *
	 * 不能写 `dist/server/entry.mjs`：Cloudflare 的 Vite 插件在配置阶段要求 `main` 指向一个存在
	 * 的源码文件，写产物路径会以 "doesn't point to an existing file" 中止构建。
	 */
	"main": "src/worker/index.ts",
	/*
	 * 开黑房间的两个 Durable Object（见 src/worker/partyRoom.ts）：
	 * 一个房间一个实例，另有一个全局大厅。
	 */
	"durable_objects": {
		"bindings": [
			{ "name": "PARTY_ROOMS", "class_name": "PartyRoom" },
			{ "name": "PARTY_LOBBY", "class_name": "PartyLobby" },
		],
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["PartyRoom", "PartyLobby"] }],
	/*
	 * 重建的触发者。**这是主力，不是备胎。**
	 *
	 * GitHub Actions 的 `on.schedule` 是尽力而为的，官方文档写着高负载时会丢任务；实测
	 * 66.8 小时里本该跑 134 次只跑了 18 次（13%），中位间隔三个多小时。内容页都是构建期
	 * 预渲染的，新鲜度直接等于重建频率，靠它撑不住——于是改由这里的 Cron 准点调
	 * GitHub 的 workflow_dispatch（见 src/worker/index.ts）。
	 *
	 * 分钟数与 `.github/workflows/rebuild.yml` 里那条兜底的 schedule 错开，避免同一分钟
	 * 触发两次、白烧一轮上游额度。
	 */
	"triggers": { "crons": ["17,47 * * * *"] },
  /*
   * 静态资源就是构建产物。构建结束时适配器会把这里改写成 `../client`（相对 `dist/server/`），
   * 所以这里写的是 Astro 的 outDir，不是它最终读的那个目录。
   */
  "assets": { "binding": "ASSETS", "directory": "./dist" },
	"vars": {
		// 换成真实域名。Steam 登录的 realm / return_to 由它拼出来，配错会在回调那一步失败。
		"SITE_URL": "https://dota2.hiwenbin.com",
		// STRATZ 固定出口中转（新加坡那台机器上的 nginx）。口令走 `wrangler secret put STRATZ_RELAY_TOKEN`。
		"STRATZ_RELAY_URL": "https://proxy3000.hiwenbin.com/stratz/graphql",
		// Cron 触发哪个仓库的重建。fork 之后改成自己的 `owner/repo`。
		"GITHUB_REPO": "jackbi/dota2-yizhan",
	},
  "observability": { "enabled": true },
}
